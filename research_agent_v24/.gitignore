.DS_Store
.env
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Runtime state: source datasets and validation reports remain versioned.
data/*.db
data/*.db-*
data/cache/*
data/raw/*
data/exports/*
data/backups/*
!data/cache/.gitkeep
!data/raw/.gitkeep
!data/exports/.gitkeep
!data/backups/.gitkeep
data/canary/*
!data/canary/.gitkeep
data/pilot/*.db
data/pilot/*.db-*

# Local test-run reports
output/test_runs/

# Ephemeral per-wave ATS-validation evidence (disposable DBs incl. WAL/SHM,
# saved HTTP bodies, validation caches, scratch drivers/manifests).
# Canonical wave evidence lives in docs/reports/ats_validation_*.md.
# output/mapping/ stays versioned (regenerated Tier-S reports, referenced by scripts).
output/*_wave_*/
output/eightfold_*_20??????/
output/workday_registry_check.py
