# Research Agent PIER — local credentials/settings
# Copy this file to .env and fill only the values you need.
# .env is ignored by Git. You do NOT need shell `export` commands for normal use.

RESEARCH_AGENT_DATABASE_URL=sqlite:///data/research_agent.db
RESEARCH_AGENT_LOG_LEVEL=INFO

# Optional. Leave blank unless you explicitly want contact metadata appended to the
# stable scanner User-Agent. It is never required for dry-runs or canary tests.
RESEARCH_AGENT_SCANNER__OPERATOR_CONTACT=

# LLM routing: Google is primary, OpenRouter/MiniMax-M3:free is the final fallback.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenRouter attribution headers.
# RESEARCH_AGENT_LLM__HTTP_REFERER=
# RESEARCH_AGENT_LLM__APP_TITLE=Research Agent PIER

# Optional bounded-run overrides.
# RESEARCH_AGENT_LLM__BATCH_SIZE=10
# RESEARCH_AGENT_LLM__MAX_JOBS_PER_RUN=50
# RESEARCH_AGENT_SCANNER__MAX_REQUESTS_PER_HOST_PER_RUN=30
# RESEARCH_AGENT_SCANNER__MAX_REQUESTS_PER_RUN=500
