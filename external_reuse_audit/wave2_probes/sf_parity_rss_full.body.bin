&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Hai conoscenza di sistemi operativi Windows e delle principali applicazioni software;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Hai capacità di diagnosi e risoluzione di problemi su dispositivi iPhone;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Hai capacità di problem solving e di gestione delle priorità;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Hai ottime capacità comunicative e orientamento al cliente;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Hai capacità di lavorare in team;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Saranno considerati requisiti preferenziali la conoscenza di sistemi di ticketing (es. Jira, ServiceNow) e l’avere certificazioni IT.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Your Future With Us - Cosa troverai in KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività &lt;/strong&gt;e il &lt;strong&gt;lavoro di squadra;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;modalità di lavoro &lt;strong&gt;ibrida, &lt;/strong&gt;per promuovere un sano equilibrio tra vita lavorativa e personale;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;programmi di &lt;strong&gt;formazione &lt;/strong&gt;e sviluppo avanzati per rimanere sempre aggiornati;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;mindset internazionale &lt;/strong&gt;e &lt;strong&gt;progettualità innovative;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;iniziative incentrate sul &lt;strong&gt;benessere psicofisico.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Inquadramento ai sensi del CCNL Commercio al III° livello; la retribuzione sarà definita e commisurata in relazione a criteri oggettivi quali competenze, esperienza effettiva maturata e aderenza ai requisiti richiesti per la posizione.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Together for Better – I nostri valori e il nostro impegno&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network ha ottenuto le &lt;strong&gt;certificazioni ISO 30415&lt;/strong&gt;, che attesta la conformità del Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, che certifica la parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;a style=&quot;background-color:white&quot; href=&quot;https://performancemanager5.successfactors.eu/bit.ly/OurImpactPlanKPMG&quot;&gt;bit.ly/OurImpactPlanKPMG&lt;/a&gt;.&lt;/span&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;KPMG Business services S.r.l. garantisce le pari opportunità.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;We don’t imagine a better future. We’re building it.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Do Work That Matters - Your Role and Responsibilities&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and your colleagues tackle and solve the most current and complex challenges.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;KPMG Business Services provides internal services to the organization, supporting all service lines and assisting professionals in managing daily activities. In particular, by joining the &lt;strong&gt;Service Desk Team&lt;/strong&gt;, you will be responsible for delivering the highest standards of direct assistance and support to the Leadership and Management Group members.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Specifically, you will be responsible for:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Providing &lt;strong&gt;technical support&lt;/strong&gt; to users via phone or chat.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Managing and resolving &lt;strong&gt;support requests&lt;/strong&gt; according to defined priorities.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Diagnosing and resolving &lt;strong&gt;hardware and software issues&lt;/strong&gt;.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Handling &lt;strong&gt;security and compliance incidents&lt;/strong&gt;.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Managing requests through the &lt;strong&gt;ticketing system&lt;/strong&gt;.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Collaborating with the &lt;strong&gt;IT team&lt;/strong&gt; to improve processes and solve more complex issues.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Come As You Are - Your Skills and Characteristics&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;You have &lt;strong&gt;previous experience&lt;/strong&gt; in a &lt;strong&gt;Service Desk role&lt;/strong&gt; or an IT technical field.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;You have knowledge of &lt;strong&gt;Windows operating systems&lt;/strong&gt; and major software applications.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;You have &lt;strong&gt;diagnostic and troubleshooting skills&lt;/strong&gt; for &lt;strong&gt;iPhone devices&lt;/strong&gt;.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;You have strong &lt;strong&gt;problem-solving skills&lt;/strong&gt; and the ability to manage priorities.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;You have excellent &lt;strong&gt;communication skills&lt;/strong&gt; and a customer-oriented mindset.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;You are able to work &lt;strong&gt;effectively in a team&lt;/strong&gt;.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Preferred qualifications&lt;/strong&gt; include knowledge of &lt;strong&gt;ticketing systems&lt;/strong&gt; (e.g., Jira, ServiceNow) and &lt;strong&gt;IT certifications&lt;/strong&gt;.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Your Future With Us - What You Will Find at KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;An &lt;strong&gt;inclusive and fair&lt;/strong&gt; work environment that respects, encourages, and values diversity.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;A &lt;strong&gt;stimulating and dynamic&lt;/strong&gt; workplace that fosters creativity and teamwork.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;A &lt;strong&gt;hybrid work model&lt;/strong&gt; to promote a healthy work-life balance.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Advanced training and development programs&lt;/strong&gt; to keep you constantly up to date.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;An international mindset&lt;/strong&gt; and innovative projects.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Well-being initiatives&lt;/strong&gt; focused on mental and physical health.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Standard employment contract under the collective labour agreement for the commerce sector, level III°. The salary is determined on the basis of objective criteria, including the candidate’s skills, relevant experience and fulfilment of the requirements of the position.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Together for Better – Our Values and Commitment&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Leadership, teamwork, respect for individuality, continuous learning, transparency, community engagement, and integrity—these are KPMG’s &lt;strong&gt;core values&lt;/strong&gt; that create an environment open to the exchange of ideas and knowledge, allowing our professionals to reach their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Thanks to our commitment to fostering an inclusive work environment, our Network has obtained &lt;strong&gt;ISO 30415 certification&lt;/strong&gt;, which confirms compliance with the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125 certification&lt;/strong&gt;, which certifies gender equality.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;You can find a summary of all the concrete actions we are taking on &lt;strong&gt;environmental, social, and governance (ESG) issues&lt;/strong&gt; in our &lt;strong&gt;Impact Plan&lt;/strong&gt; – &lt;a style=&quot;background-color:white&quot; href=&quot;https://performancemanager5.successfactors.eu/bit.ly/OurImpactPlanKPMG&quot;&gt;bit.ly/OurImpactPlanKPMG&lt;/a&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;Join Us!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;Your data will be processed in full compliance with the provisions of &lt;strong&gt;Regulation (EU) No. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;)&lt;/strong&gt; and subsequent amendments. For more information, please refer to KPMG&apos;s &lt;strong&gt;privacy policy&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;KPMG Business Services S.r.l. is an equal opportunity employer.&lt;/strong&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;background-color:white&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%;font-weight:normal;background-color:white&quot;&gt;#LI-RR1&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-IT-Service-Desk-Specialist-Milano/1365993457/</link><guid isPermaLink="false">1365993457</guid><g:id>1365993457</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Information Technology Services</g:job_function><g:location>Milano, IT</g:location></item><item><title>Junior Consultant  IT Strategy | CIO Advisory 1 (Verona, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;The chance to build a better future is right in front of you&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters &lt;/em&gt;- Il tuo ruolo e le tue responsabilità &lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. Gli esperti di &lt;strong&gt;Nolan Norton&lt;/strong&gt;, società di IT Strategy del Network KPMG, aiutano le organizzazioni ad affrontare le sfide di trasformazione digitale e ad implementare architetture IT. In particolare, entrerai a far parte del Team CIO Advisory di Bologna, esperto di architetture e soluzioni di data management che supporta i CIO nell&apos;evoluzione digitale del loro percorso, nel loro journey verso il cloud, dalla strategia all&apos;esecuzione e dalla visione al valore reale. Entrerai a far parte di un ambiente dinamico e stimolante, per clienti di alto livello altamente visibili nei mercati dei servizi finanziari, dell&apos;energia, del settore pubblico e dei consumatori e industriali.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Nello specifico, ti occuperai di su tecnologie innovative su progetti sfidanti ed entusiasmanti, supportando i nostri clienti principalmente sulle seguenti tematiche:&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Strategy&lt;/strong&gt;: aiutiamo i nostri clienti a sviluppare strategie tecnologiche e modelli operativi tecnologici innovativi;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Architecture&lt;/strong&gt;: consentiamo ai clienti di utilizzare soluzioni all&apos;avanguardia per applicazioni, infrastrutture e TLC;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Data Management&lt;/strong&gt;: aiutiamo i nostri clienti nell’identificazione delle migliori soluzioni di gestione del dato e progettazione di architetture di Data Management;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Planning &amp;amp; Budgeting&lt;/strong&gt;: assistiamo i nostri clienti a identificare, definire le priorità, progettare e indirizzare meglio gli investimenti tecnologici;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Strategic Sourcing&lt;/strong&gt;: gestiamo la governance e svolgiamo attività di supporto tecnico durante la selezione delle varie opzioni e dei fornitori nell&apos;intero ciclo dei servizi ICT;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Governance and Organization&lt;/strong&gt;: ci occupiamo della corretta struttura e dimensionamento delle risorse ICT;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Cost right-sizing&lt;/strong&gt;: valutiamo e suggeriamo opzioni per indirizzare meglio la spesa e le risorse ICT.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Laurea Magistrale in Ingegneria Gestionale,Informatica, Elettronica, delle Telecomunicazioni, Fisica, Matematica;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Conoscenza della lingua inglese, idealmente approfondita attraverso un&apos;esperienza formativa/lavorativa all&apos;estero.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Opportunità di stage con indennità mensile di 800€ per stage curriculare o 1000€ per stage extracurriculare &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;br&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;Nolan Norton Spa garantisce le pari opportunità&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;The chance to build a better future is right in front of you&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Do Work That Matters - Your Role and Responsibilities&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and colleagues tackle and solve the most current and complex challenges. Experts from Nolan Norton, an IT Strategy company within the KPMG Network, help organizations face digital transformation challenges and implement IT architectures. Specifically, you will join the CIO Advisory Team, experts in data management architectures and solutions that support CIOs in their digital evolution journey, from strategy to execution and from vision to real value. You will be part of a dynamic and stimulating environment, working with high-level clients highly visible in the financial services, energy, public sector, and consumer and industrial markets.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Specifically, you will work on innovative technologies on challenging and exciting projects, supporting our clients mainly on the following topics:&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Strategy&lt;/strong&gt;: We help our clients develop innovative technology strategies and operating models;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Architecture&lt;/strong&gt;: We enable clients to use cutting-edge solutions for applications, infrastructure, and TLC;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Data Management&lt;/strong&gt;: We help our clients identify the best data management solutions and design data management architectures;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Planning &amp;amp; Budgeting&lt;/strong&gt;: We assist our clients in identifying, prioritizing, designing, and better directing technology investments;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Strategic Sourcing&lt;/strong&gt;: We manage governance and provide technical support during the selection of various options and suppliers throughout the ICT services cycle;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Governance and Organization&lt;/strong&gt;: We take care of the proper structure and sizing of ICT resources;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Cost Right-Sizing&lt;/strong&gt;: We evaluate and suggest options to better direct ICT spending and resources.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Come As You Are - Your Skills and Characteristics&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Master&apos;s degree in Management Engineering, Computer Engineering, Electronic Engineering, Telecommunications Engineering, Physics, Mathematics;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Knowledge of the English language, ideally deepened through educational/work experience abroad.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Your Future With Us - What You Will Find at KPMG&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;An inclusive, fair work environment that respects, encourages, and values diversity;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;A stimulating and dynamic context that encourages creativity and teamwork;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Hybrid work mode to promote a healthy work-life balance;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Advanced training and development programs to stay always updated;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;International mindset and innovative projects;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Initiatives focused on physical and mental well-being.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Paid internship opportunity offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Together for Better – Our Values and Commitment&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, commitment to the community, integrity: these are the Values of KPMG that create an environment open to the exchange of ideas and knowledge, allowing our professionals to express their full potential.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Within our Impact Plan - Our Impact Plan - you will find a summary of all the concrete actions we are carrying out on environmental, social, and governance (ESG) issues. Join us! Your data will be processed in full compliance with the provisions of Regulation (EU) No. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) and subsequent amendments. For more information, please refer to the KPMG privacy policy. Nolan Norton Spa guarantees equal opportunities.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;#LI-SD1&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Verona-Junior-Consultant-IT-Strategy-CIO-Advisory-1/1366111457/</link><guid isPermaLink="false">1366111457</guid><g:id>1366111457</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Verona, IT</g:location></item><item><title>Senior Consultant/Assistant Manager Governance, Risk &amp; Compliance - Financial Services (Milano, IT)</title><description><![CDATA[&lt;div id=&quot;tor__flistingLayout_readOnlyDiv&quot;&gt;
&lt;div id=&quot;tor__flistingLayout_content&quot;&gt;
&lt;p&gt;&lt;strong&gt;Senior Consultant/Assistant Manager - Governance, Risk &amp;amp; Compliance - Financial Services &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;em&gt;The chance to build a better future is right in front of you.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters &lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;- Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;strong&gt;KPMG Advisory &lt;/strong&gt;offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;In particolare, entrando a far parte del Team di &lt;strong&gt;Governance, Risk &amp;amp; Compliance&lt;/strong&gt; di &lt;strong&gt;Milano&lt;/strong&gt; potrai aiutare le aziende a trasformare i &lt;strong&gt;rischi in opportunità&lt;/strong&gt; per migliorare la loro organizzazione e l’evoluzione dei loro sistemi di governance, ottenendo un vantaggio competitivo e offrendo soluzioni integrate e approcci innovativi per la gestione strategica del rischio.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Nello specifico, ti occuperai di:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;&lt;strong&gt;Internal governance&lt;/strong&gt; e sistema dei &lt;strong&gt;controlli interni&lt;/strong&gt; (es. &lt;strong&gt;Solvency 2&lt;/strong&gt;/ &lt;strong&gt;CRD IV&lt;/strong&gt;);&lt;/li&gt;
&lt;li&gt;Customer protection (es. &lt;strong&gt;IDD/&lt;/strong&gt; &lt;strong&gt;Mifid 2&lt;/strong&gt;);&lt;/li&gt;
&lt;li&gt;Sostenibilità (es. Reg UE 2019/2088 e 2020/852);&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Responsabilità amministrativa degli enti ex D. Lgs 231/01;&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Sistema dei &lt;strong&gt;controlli interni degli intermediari bancari, finanziari ed assicurativi.&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Sarai coinvolta/o su &lt;strong&gt;progetti internazionali&lt;/strong&gt; &lt;strong&gt;e nazionali &lt;/strong&gt;al fianco di professioniste/i che ti aiuteranno ad aumentare le tue conoscenze professionali e relazionali.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Questa opportunità è perfetta per te se hai:&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Esperienza di &lt;strong&gt;almeno 2 anni &lt;/strong&gt;presso aziende (compagnie assicurative o banche) o presso società di consulenza nell’area Risk &amp;amp; Compliance;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Laurea magistrale o Master in Economia&lt;/strong&gt; o &lt;strong&gt;Giurisprudenza &lt;/strong&gt;con ottima votazione;&lt;/li&gt;
&lt;li&gt;Interesse per i &lt;strong&gt;Financial Services&lt;/strong&gt; (settore bancario e/o assicurativo, asset &amp;amp; wealth management) e buona conoscenza del framework normativo del settore finanziario;&lt;/li&gt;
&lt;li&gt;Ottima conoscenza della&lt;strong&gt; lingua inglese&lt;/strong&gt;, meglio se avvalorata da un’esperienza di studio e/o lavoro all’estero;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità;&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra;&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale;&lt;/li&gt;
&lt;li&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative;&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico.&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 31.000 e € 41.000 per la qualifica di Senior Consultant e tra € 38.000 e € 51.000 per la qualifica di Assistant Manager, determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione. &lt;/p&gt;
&lt;p&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a title=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot; href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Senior Consultant/Assistant Manager - Governance, Risk &amp;amp; Compliance - Financial Services &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Do Work That Matters - Your role and responsibilities&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the company, and colleagues address and solve the most current and complex challenges. KPMG Advisory offers consulting services to companies to assist them in business model transformation, process improvement and digitisation, risk analysis and management, and support in extraordinary finance transactions.&lt;/p&gt;
&lt;p&gt;When you join the &lt;strong&gt;Governance, Risk and Compliance&lt;/strong&gt; team, you will help companies transform risks into opportunities for the improvement of their organisation and evolution of their governance systems to gain a competitive edge and offer integrated solutions and innovative approaches for strategic risk management.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;KPMG Advisory’s &lt;strong&gt;Governance, Risk &amp;amp; Compliance &lt;/strong&gt;team supports companies in the definition of governance and organisational structures to face the challenges of digital transformation through processes for the management of risks and opportunities. If you are passionate about governance and internal control and risk management systems applied to the financial reporting sector, with an interest in consulting, join our &lt;strong&gt;Milan &lt;/strong&gt;team serving clients in the&lt;strong&gt; Financial sector.&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;div&gt;
&lt;p&gt;&lt;strong&gt;Specifically, you will be tasked with:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Managing the &lt;strong&gt;administrative liability of entities&lt;/strong&gt; in accordance with &lt;strong&gt;Legislative Decree 231/2001&lt;/strong&gt;, supporting the implementation, monitoring, and update of organizational and control models;&lt;/li&gt;
&lt;li&gt;Overseeing and assessing the &lt;strong&gt;internal control systems&lt;/strong&gt; of &lt;strong&gt;banking, financial, and insurance intermediaries;&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Supporting activities related to &lt;strong&gt;internal governance&lt;/strong&gt; and &lt;strong&gt;internal control frameworks&lt;/strong&gt;, including compliance with &lt;strong&gt;Solvency II&lt;/strong&gt; and &lt;strong&gt;CRD IV&lt;/strong&gt; requirements;&lt;/li&gt;
&lt;li&gt;Contributing to the implementation and monitoring of &lt;strong&gt;customer protection regulations&lt;/strong&gt;, including &lt;strong&gt;IDD&lt;/strong&gt; and &lt;strong&gt;MiFID II;&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Assisting in projects concerning &lt;strong&gt;sustainability and ESG regulatory frameworks&lt;/strong&gt;, including &lt;strong&gt;EU Regulations 2019/2088 (SFDR)&lt;/strong&gt; and &lt;strong&gt;2020/852 (EU Taxonomy)&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Your skills and characteristics&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;This is the perfect opportunity for you if:&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul style=&quot;list-style-type:disc&quot;&gt;
&lt;li&gt;at least &lt;strong&gt;two years&lt;/strong&gt; of &lt;strong&gt;risk &amp;amp; compliance experience&lt;/strong&gt; with companies (insurance companies or banks) or consulting companies;&lt;/li&gt;
&lt;li&gt;Master’s degree or equivalent qualification in &lt;strong&gt;Economics or Law&lt;/strong&gt;, with excellent academic results;&lt;/li&gt;
&lt;li&gt;an interest in &lt;strong&gt;financial services&lt;/strong&gt; (banking and/or insurance) and a good knowledge of the finance sector&apos;s regulatory framework;&lt;/li&gt;
&lt;li&gt;excellent knowledge of &lt;strong&gt;English&lt;/strong&gt;, preferably with study and/or work experience abroad.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - What you’ll find at KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul style=&quot;list-style-type:disc&quot;&gt;
&lt;li&gt;An &lt;strong&gt;inclusive&lt;/strong&gt; and equitable&lt;strong&gt; work environment&lt;/strong&gt; that respects, encourages and values &lt;strong&gt;diversity.&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;A challenging and dynamic environment that encourages&lt;strong&gt; creativity&lt;/strong&gt; and &lt;strong&gt;teamwork.&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Hybrid&lt;/strong&gt; work arrangements to promote a healthy work-life balance.&lt;/li&gt;
&lt;li&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programmes to stay current.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;International &lt;/strong&gt;&lt;strong&gt;mindset&lt;/strong&gt; and &lt;strong&gt;innovative projects.&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being.&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €31,000 to €41,000 for the Senior Consultant position and from €38,000 to €51,000 for the Assistant Manager position. The salary is determined on the basis of objective criteria, including the candidate’s skills and experience assessed against the requirements of the role. &lt;/p&gt;
&lt;p&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;strong&gt;&lt;em&gt;Together for Better – Our values and commitment&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality. Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarised all the concrete actions we are taking on environmental, social and governance (ESG) issues. &lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG’s privacy policy.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;#LI-AV1&lt;/p&gt;
&lt;p&gt;#LI-HYBRID&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Senior-ConsultantAssistant-Manager-Governance%2C-Risk-&amp;-Compliance-Financial-Services/1365706857/</link><guid isPermaLink="false">1365706857</guid><g:id>1365706857</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>Cloud Architect - Milano (Milano, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif;text-align:center&quot;&gt;&lt;strong&gt;Cloud Architect &lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;We let the future guide us. Join our next generation.&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters - Il tuo ruolo e le tue responsabilità&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di affrontare e risolvere le sfide più attuali e complesse. &lt;strong&gt;KPMG Business Services&lt;/strong&gt; offre servizi interni all’organizzazione, supportando tutte le linee di servizio e coadiuvando i professionisti nella gestione delle attività quotidiane. In particolare, entrando a far parte del Team di&lt;strong&gt; Information Technology Services &lt;/strong&gt;del nostro dipartimento di IT interno di Milano sarai responsabile di fornire i più alti standard di assistenza diretta e di supporto alla Leadership e ai componenti del Management Group.  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Progettare architetture cloud‑native su Azure scalabili, sicure e sostenibili, allineate alle best practice aziendali e ai requisiti dei clienti interni/esterni.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Disegnare architetture end‑to‑end (HLD/LLD), definire specifiche tecniche/funzionali, NFR (scalabilità, sicurezza, disponibilità, performance, costo).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Guidare la definizione di landing zone Azure, networking sicuro (hub/spoke, Private Link), identity e access management, integrazione on‑prem/hybrid.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Valutare e introdurre tecnologie Cloud con analisi di trade‑off, costi e rischi.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Impostare DevOps: IaC (Terraform/Bicep), CI/CD, policy as code, logging e observability (Azure Monitor, App Insights).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Eseguire PoC e assessment architetturali, guidare decisioni (ADR), definire roadmap e piani di migrazione/modernizzazione.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Collaborare con team cross‑funzionali (security, data, sviluppo, operations) e comunicare chiaramente a stakeholder tecnici e Business.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Documentare e presentare soluzioni (diagrammi C4, runbook, guide operative); trasferimento a operation e supporto post‑go‑live.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Adottare Well‑Architected/CAF, FinOps, standardizzazione blueprint e reference architecture.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Hai una laurea in Informatica/Ingegneria o equivalente.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Hai esperienza complessiva 5+ anni in ambito IT, di cui 2–3 anni in architettura di soluzioni su Azure .&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Hai un&apos;ottima conoscenza della lingua inglese&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Certificazioni gradite: Azure: AZ‑305 (Architect), AZ‑104, AZ‑400 (DevOps), FinOps Certified Practitioner. &lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Hard Skills (Must have)&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Architetture su Azure: compute (AKS, Container Apps, App Service, Logic Apps, Functions), storage, database (Azure SQL, Cosmos DB), networking (VNet, Private Endpoints, ExpressRoute/VPN), sicurezza (Key Vault, Defender, WAF).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;DevOps: Git, CI/CD (Bitbucket Pipelines/GitHub Actions), IaC (Terraform o Bicep), container (Docker), Kubernetes (AKS), policy as code, gestione secrets.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Observability e affidabilità: Azure Monitor, Log Analytics, Application Insights, OpenTelemetry; progettazione per resilienza, backup/DR, RTO/RPO.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Linguaggi: competente almeno in un linguaggio di programmazione, preferiti C#, Java, Javascript, Python e SQL.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Hard skills (nice to have)&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Data &amp;amp; Analytics: Databricks, Synapse, Microsoft Fabric, Delta Lake; data governance con Purview.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Vector DB e RAG: Azure AI Search, pgvector, Cosmos DB con indexing vettoriale, Redis.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Framework architetturali: TOGAF, C4, ADR.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Cost management: stime e ottimizzazione costi (FinOps), capacity planning.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Inquadramento ai sensi del CCNL Commercio al I° livello; la retribuzione sarà definita e commisurata in relazione a criteri oggettivi quali competenze, esperienza effettiva maturata e aderenza ai requisiti richiesti per la posizione.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;em&gt;bit.ly/OurImpactPlanKPMG&lt;/em&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;em&gt;KPMG Business Services S.r.l. garantisce le pari opportunità&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters – Your Role and Responsibilities&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Are you looking for a meaningful role where you can make a real impact? At KPMG, you will have the opportunity to tackle and solve some of today’s most complex and relevant challenges.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;KPMG Business Services provides internal services across the organization, supporting all service lines and enabling professionals to effectively manage their day-to-day activities. By joining the &lt;strong&gt;Information Technology Services Team&lt;/strong&gt; within our internal IT department in Milan, you will be responsible for delivering the highest standards of direct support and assistance to Leadership and members of the Management Group.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Specifically, you will:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Design scalable, secure, and sustainable &lt;strong&gt;cloud-native architectures on Microsoft Azure&lt;/strong&gt;, aligned with company best practices and internal/external client requirements;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Define and design end-to-end architectures (HLD/LLD), technical and functional specifications, and non-functional requirements (NFRs) such as scalability, security, availability, performance, and cost optimization;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Lead the definition of Azure landing zones, secure networking architectures (hub-and-spoke, Private Link), identity and access management, and hybrid/on-premises integrations;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Evaluate and introduce cloud technologies through trade-off analyses, cost assessments, and risk evaluations;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Establish and promote DevOps practices, including Infrastructure as Code (Terraform/Bicep), CI/CD pipelines, policy-as-code approaches, logging, and observability solutions (Azure Monitor, Application Insights);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Perform Proofs of Concept (PoCs) and architecture assessments, drive architectural decisions (ADRs), and define migration and modernization roadmaps;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Collaborate with cross-functional teams (Security, Data, Development, and Operations) and effectively communicate with both technical and business stakeholders;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Document and present solutions through architecture diagrams (C4), runbooks, and operational guides, while supporting operational handover and post-go-live activities;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Apply Azure Well-Architected Framework and Cloud Adoption Framework (CAF) principles, FinOps methodologies, and standardized blueprints and reference architectures.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Come As You Are – Your Skills and Characteristics&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;This opportunity is perfect for you if you:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Hold a degree in Computer Science, Engineering, or an equivalent field;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Have more than 5 years of overall IT experience, including at least 2–3 years designing and implementing Azure-based solution architectures;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Have an excellent command of the English language;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Hold certifications such as &lt;strong&gt;AZ-305 (Azure Solutions Architect Expert)&lt;/strong&gt;, &lt;strong&gt;AZ-104 (Azure Administrator Associate)&lt;/strong&gt;, &lt;strong&gt;AZ-400 (DevOps Engineer Expert)&lt;/strong&gt;, or &lt;strong&gt;FinOps Certified Practitioner&lt;/strong&gt; (preferred).&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Technical Skills (Must Have)&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Strong expertise in Azure architectures, including: Compute services (AKS, Container Apps, App Service, Logic Apps, Azure Functions); Storage solutions; Databases (Azure SQL, Cosmos DB); Networking (Virtual Networks, Private Endpoints, ExpressRoute, VPN); Security services (Key Vault, Defender for Cloud, Web Application Firewall);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;DevOps expertise, including: Git; CI/CD platforms (Bitbucket Pipelines, GitHub Actions); Infrastructure as Code (Terraform or Bicep); Docker; Kubernetes (AKS); Policy as Code; Secrets management;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Observability and reliability engineering: Azure Monitor; Log Analytics; Application Insights; OpenTelemetry; Designing for resilience, backup and disaster recovery, RTO and RPO targets;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Proficiency in at least one programming language, preferably &lt;strong&gt;C#, Java, JavaScript, Python&lt;/strong&gt;, and strong SQL skills.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Technical Skills (Nice to Have)&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Data &amp;amp; Analytics technologies: Databricks; Azure Synapse Analytics; Microsoft Fabric; Delta Lake; Data governance with Microsoft Purview;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Vector databases and Retrieval-Augmented Generation (RAG):  Azure AI Search; pgvector; Cosmos DB with vector indexing; Redis;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Architecture frameworks and methodologies:  TOGAF; C4 Model; Architecture Decision Records (ADR);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Cost management expertise:  Cost estimation and optimization (FinOps); Capacity planning.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Your Future With Us – What You Will Find at KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;An inclusive and equitable workplace that respects, encourages, and values diversity;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;A dynamic and stimulating environment that fosters creativity and teamwork;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;A hybrid working model that supports a healthy work-life balance;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Advanced learning and development programs to help you continuously grow and stay up to date;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;An international mindset and the opportunity to work on innovative projects;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Well-being initiatives focused on both physical and mental health.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Standard employment contract under the collective labour agreement for the commerce sector, level I°. The salary is determined on the basis of objective criteria, including the candidate’s skills, relevant experience and fulfilment of the requirements of the position.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Together for Better – Our Values and Commitment&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, commitment to the community, and integrity: these are the values that shape KPMG’s culture and create an environment where ideas and knowledge are openly shared, enabling our people to achieve their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Through our commitment to fostering an inclusive workplace, our Network complies with &lt;strong&gt;ISO 30415&lt;/strong&gt; standards for Diversity and Inclusion Management Systems and &lt;strong&gt;UNI/PdR 125&lt;/strong&gt; standards relating to gender equality.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Learn more about the concrete actions we are taking across Environmental, Social, and Governance (ESG) topics through our &lt;strong&gt;Impact Plan&lt;/strong&gt;: &lt;strong&gt;bit.ly/OurImpactPlanKPMG&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Your personal data will be processed in full compliance with Regulation (EU) 2016/679 (General Data Protection Regulation – GDPR), as subsequently amended. For further information, please refer to KPMG’s Privacy Notice.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Business Services S.r.l. is an Equal Opportunity Employer.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height:107%;font-family:Calibri, sans-serif&quot;&gt;#LI-RR1&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Cloud-Architect-Milano/1365888357/</link><guid isPermaLink="false">1365888357</guid><g:id>1365888357</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Information Technology Services</g:job_function><g:location>Milano, IT</g:location></item><item><title>Manager Cyber Security - Roma 1 (Roma, IT)</title><description><![CDATA[&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;Manager Cyber Security - Roma &lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;The chance to build a better future is right in front of you&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;Do Work That Matters - Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. KPMG Advisory offre servizi di consulenza alle imprese per supportarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché nelle operazioni di finanza straordinaria.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;In particolare, entrando a far parte del Team di Cyber &amp;amp; Tech Risk a Roma, lavorerai con i nostri esperti di ICT security per aiutare i clienti ad affrontare i rischi informatici che minacciano il loro business. Collaborerai su progetti rilevanti per le aziende leader di mercato.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;Nello specifico, ti occuperai di:&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;list-style-type:square;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;IT Risk Assessment &amp;amp; Information Risk Management&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Information Security governance (policy, organisational models…)&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Business Continuity management &amp;amp; Disaster Recovery management&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Identity Access Management (IAM) and Identity Access Governance (IAG)  &lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Security data Analytics&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;IT assurance&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Business Process reengineering&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Conoscenza dei principali standard di riferimento (ISO27001, COBIT, ITIL, etc.)&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Security Strategy &amp;amp; Policy Security Risk Assessment&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Governo dei sistemi informativi&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Gestione e controllo dei rischi in ambito IT&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Business Continuity&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Operational technology – reti e sistemi di governo in ambito industriale&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Potresti essere coinvolto nel team NIS e perimetro nazionale sicurezza cibernetica&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; Sarai coinvolto in progetti sia nazionali che internazionali, collaborando con professionisti altamente qualificati, e lavorerai a stretto contatto con i nostri clienti del settore Financial Services, tra cui banche, assicurazioni e società di investimento, contribuendo alla gestione di rischi IT, governance, audit, privacy e sicurezza informatica.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Per essere il candidato ideale non ti possono mancare:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;list-style-type:square;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;5+ anni di esperienza in società di consulenza in ambito Cyber security&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Laurea in Ingegneria Informatica, delle Telecomunicazioni o in Scienze Informatiche e dell’Informazione;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Buona conoscenza dei principali ambiti tecnologiche e/o di specifiche soluzioni correlate agli ambiti evidenziati in precedenza;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Ottima conoscenza della lingua inglese, meglio se avvalorata da un’esperienza di studio e/o lavoro all’estero;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Forte attitudine verso tematiche tecnologiche innovative.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;Mindset&lt;/strong&gt;&lt;strong&gt; internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 50.000 e € 59.000 determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione. &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;Together for Better – I nostri valori e il nostro impegno&lt;/strong&gt;&lt;br&gt;Leadership, lavoro in team, rispetto delle individualità, apprendimento continuo, trasparenza, impegno verso la comunità e integrità: questi sono i valori di KPMG che danno vita a un ambiente aperto allo scambio di idee e alla crescita personale e professionale.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Grazie al nostro impegno per un ambiente di lavoro inclusivo, abbiamo ottenuto le certificazioni ISO 30415 (Gestione della Diversità e Inclusione) e &lt;strong&gt;UNI PdR 125&lt;/strong&gt; (Parità di genere). Scopri tutte le nostre azioni concrete nel nostro Impact Plan - Our Impact Plan (kpmg.com), che descrive le nostre iniziative su temi ambientali, sociali e di governance (ESG).&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;br&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&lt;b&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/b&gt;&lt;/p&gt;

&lt;p&gt;Visit www.kpmg.it to learn more&lt;/p&gt;

&lt;p&gt; 
&lt;p&gt;&lt;span style=&quot;font-size:8.0px&quot;&gt;#LI-AA1&lt;/span&gt;&lt;/p&gt;
&lt;/p&gt;
]]></description><link>https://careers.kpmg.it/job/Roma-Manager-Cyber-Security-Roma-1/806779802/</link><guid isPermaLink="false">806779802</guid><g:id>806779802</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Roma, IT</g:location></item><item><title>Internship Financial Risk | Milan 1 (Milano, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm;text-align:center;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:20.0pt;line-height:115%&quot;&gt;Internship Financial Risk | Milan&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:center;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Do Work That Matters &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;- Your role and responsibilities &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the company and colleagues address and solve the most current and complex challenges. &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;KPMG Advisory &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:9.0pt;line-height:107%;font-family:&amp;#39;Segoe UI&amp;#39;, sans-serif&quot;&gt;offers consulting services to companies to assist them in business model transformation, process improvement and digitisation, risk analysis and management, and support in extraordinary finance transactions. &lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;When you join &lt;span style=&quot;color:black;background-color:white&quot;&gt;the Financial Risk team in Milan&lt;/span&gt;&lt;em&gt;, &lt;/em&gt;you are going to &lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;work on projects in the field of Risk Management, with a focus both on regulatory and organizational aspects of competence and on the development and validation of modeling for top-tier clients in the Financial Services sector. &lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;Specifically, you will be tasked with:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:#3c3c3c&quot;&gt;Credit and Market Risk;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:#3c3c3c&quot;&gt;Operational Risk;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:#3c3c3c&quot;&gt;Liquidity and Interest Rate Risk;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:#3c3c3c&quot;&gt;Insurance Risk;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:#3c3c3c&quot;&gt;Regulatory and ESG Risk&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 0.0cm 17.0pt;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Your skills and characteristics &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;This is the perfect opportunity for you if:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-bottom:0.0cm;margin-top:0.0px&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;line-height:107%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;have a specialist degree (graduate or nearing completion) in finance or quantitative field (statistics, mathematics);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 0.0cm 0.0px;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;have excellent knowledge of English, preferably with study and/or work experience abroad;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 0.0cm 0.0px;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;have an excellent knowledge of Microsoft Office;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt 0.0px;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;knowledge of programming software and languages (Python, SAS, R, Matlab and Stata).&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm;line-height:normal;background-color:white;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Your Future With Us - What you’ll find at KPMG&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;An &lt;strong&gt;inclusive&lt;/strong&gt; and equitable&lt;strong&gt; work environment&lt;/strong&gt; that respects, encourages and values &lt;strong&gt;diversity.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;A challenging and dynamic environment that encourages&lt;strong&gt; creativity&lt;/strong&gt; and &lt;strong&gt;teamwork.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Hybrid&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; work arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programmes to stay current.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;International&lt;/span&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; mindset&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; and &lt;strong&gt;innovative projects.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;&lt;span&gt;Paid internship opportunity offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Together for Better – Our values and commitment&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality”&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;. Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;/span&gt;&lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Our Impact Plan (kpmg.com)&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; - you will find summarised all the concrete actions we are taking on environmental, social and governance (ESG) issues. &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt;Join us!&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG’s privacy policy&lt;/span&gt;&lt;/em&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;#LI-FN1&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;#LI-HYBRID&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Internship-Financial-Risk-Milan-1/1366577057/</link><guid isPermaLink="false">1366577057</guid><g:id>1366577057</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>IT Strategy Senior Consultant | Public Sector | CIO Advisory (Roma, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;The chance to build a better future is right in front of you&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters &lt;/em&gt;- Il tuo ruolo e le tue responsabilità &lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. Gli esperti di &lt;strong&gt;Nolan Norton&lt;/strong&gt;, società di IT Strategy del Network KPMG, aiutano le organizzazioni ad affrontare le sfide di trasformazione digitale e ad implementare architetture IT. In particolare, entrerai a far parte del Team CIO Advisory di Roma, esperto di architetture e soluzioni di data management che supporta i CIO nell&apos;evoluzione digitale del loro percorso, nel loro journey verso il cloud, dalla strategia all&apos;esecuzione e dalla visione al valore reale. Entrerai a far parte di un ambiente dinamico e stimolante, per clienti di alto livello altamente visibili nei mercati dei servizi finanziari, dell&apos;energia, del settore pubblico e dei consumatori e industriali.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Nello specifico, lavorerai su tecnologie innovative su progetti sfidanti ed entusiasmanti, supportando i nostri clienti principalmente sulle seguenti tematiche:&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Strategy&lt;/strong&gt;: aiutiamo i nostri clienti a sviluppare strategie tecnologiche e modelli operativi tecnologici innovativi;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Architecture&lt;/strong&gt;: consentiamo ai clienti di utilizzare soluzioni all&apos;avanguardia per applicazioni, infrastrutture e TLC;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Data Management&lt;/strong&gt;: aiutiamo i nostri clienti nell’identificazione delle migliori soluzioni di gestione del dato e progettazione di architetture di Data Management;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Planning &amp;amp; Budgeting&lt;/strong&gt;: assistiamo i nostri clienti a identificare, definire le priorità, progettare e indirizzare meglio gli investimenti tecnologici;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Strategic Sourcing&lt;/strong&gt;: gestiamo la governance e svolgiamo attività di supporto tecnico durante la selezione delle varie opzioni e dei fornitori nell&apos;intero ciclo dei servizi ICT;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Governance and Organization&lt;/strong&gt;: ci occupiamo della corretta struttura e dimensionamento delle risorse ICT;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Cost right-sizing&lt;/strong&gt;: valutiamo e suggeriamo opzioni per indirizzare meglio la spesa e le risorse ICT.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Laurea in discipline tecnico-scientifiche;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;almeno 3/4 anni di esperienza in società di consulenza o grandi aziende internazionali del settore ICT&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Buona padronanza della lingua inglese, scritta e parlata (Livello minimo B2);&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Ottime capacità comunicative (scritte e orali)&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;Rappresentano un plus:&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Esperienza nel disegno dei processi IT sulla base delle best practice di mercato&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Conoscenza dei principali tool utilizzati in ambito IT Governance&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Eventuali certificazioni (Prince, ITIL v4, Togaf v9, Scrum o certificazioni AWS/Ms Azure/Google/Professional Cloud Service Manager) &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;br&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Grazie all’impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network risulta conforme agli standard dei requisiti ISO 30415, sul Sistema di Gestione per la Diversità e l’Inclusione, e UNI PdR 125, relativa alla parità di genere.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;All’interno del nostro Impact Plan - Our Impact Plan (kpmg.com) - trovi riassunte tutte le azioni concrete che stiamo portando avanti su tematiche ambientali, sociali e di governance (ESG).  &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;Nolan Norton Spa garantisce le pari opportunità&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;The chance to build a better future is right in front of you&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters &lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;- Your Role and Responsibilities&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG you will have the opportunity to help clients, society, and colleagues address and solve the most current and complex challenges. The experts at &lt;strong&gt;Nolan Norton&lt;/strong&gt;, an IT Strategy firm in the KPMG Network, help organizations address digital transformation challenges and implement IT architectures. Specifically, you will join the Rome-based CIO Advisory Team, experts in data management architectures and solutions who support CIOs in their digital evolution on their journey to the cloud, from strategy to execution and from vision to real value. You will join a dynamic and challenging environment for highly visible high-level clients in the financial services, energy, public sector, and consumer and industrial markets.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Specifically, you will work on innovative technologies on challenging and exciting projects, supporting our clients primarily on the following topics:&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Strategy&lt;/strong&gt;: we help our clients develop innovative technology strategies and technology operating models;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Architecture&lt;/strong&gt;: we enable clients to use state-of-the-art solutions for applications, infrastructure and TLC;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Data Management&lt;/strong&gt;: we assist our clients in identifying the best data management solutions and designing Data Management architectures;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Planning &amp;amp; Budgeting&lt;/strong&gt;: we assist our clients in identifying, prioritizing, planning and better targeting technology investments;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Strategic Sourcing&lt;/strong&gt;: we manage governance and perform technical support activities during the selection of various options and suppliers throughout the ICT services cycle;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Governance and Organization&lt;/strong&gt;: we address the proper structure and sizing of ICT resources;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;ICT Cost right-sizing&lt;/strong&gt;: we evaluate and suggest options to better target ICT spending and resources.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Your Skills and Characteristics.&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Bachelor&apos;s degree in technical/scientific disciplines;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;At least 1/2 years of experience in consulting firms or large international ICT companies.&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Good command of the English language, written and spoken (Minimum level B2);&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Excellent communication skills (written and oral).&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;Represent a plus:&lt;/em&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Experience in IT process design based on market best practices&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Knowledge of the main tools used in IT Governance.&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Any certifications (Prince, ITIL v4, Togaf v9, Scrum or AWS/Ms Azure/Google/Professional Cloud Service Manager certifications)&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;Represent a plus:&lt;/em&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Experience in IT process design based on market best practices&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Knowledge of the main tools used in IT Governance.&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Any certifications (Prince, ITIL v4, Togaf v9, Scrum or AWS/Ms Azure/Google/Professional Cloud Service Manager certifications)&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - What you&apos;ll find at KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;An &lt;strong&gt;inclusive&lt;/strong&gt;, equitable &lt;strong&gt;work&lt;/strong&gt; environment that respects, encourages and values &lt;strong&gt;diversity&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;A challenging and dynamic environment that encourages &lt;strong&gt;creativity&lt;/strong&gt; and &lt;strong&gt;teamwork&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Hybrid&lt;/strong&gt; work arrangements to promote a healthy work-life balance&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programs to stay current&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;International mindset&lt;/strong&gt; and &lt;strong&gt;innovative projects&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €31,000 to €41,000. The salary is determined on the basis of objective criteria, including the candidate’s skills and experience assessed against the requirements of the role. &lt;/p&gt;
&lt;p&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better - Our Values and Commitment&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Leadership, teamwork, respect for each individuality, continuous deepening, transparency, commitment to the community, integrity: these are the &lt;strong&gt;Values of KPMG&lt;/strong&gt; that give rise to an environment open to the exchange of ideas and knowledge, which allows our professionals to &lt;strong&gt;express their full potential&lt;/strong&gt;.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality.” &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;Within our &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Impact&lt;/a&gt; &lt;strong&gt;Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarized all the &lt;strong&gt;concrete actions&lt;/strong&gt; we are taking on environmental, social and governance (&lt;strong&gt;ESG&lt;/strong&gt;) issues.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) No. 679/2016 (General Data Protection Regulation - “GDPR”) as amended.&lt;/em&gt; &lt;em&gt;For more information, please see KPMG&apos;s privacy policy.&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;Nolan Norton Spa guarantees equal opportunities&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;#LI-DM1&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Roma-IT-Strategy-Senior-Consultant-Public-Sector-CIO-Advisory/1332242157/</link><guid isPermaLink="false">1332242157</guid><g:id>1332242157</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Roma, IT</g:location></item><item><title>Junior Microsoft Developer (Milano, IT)</title><description><![CDATA[&lt;div id=&quot;tor__flistingLayout_readOnlyDiv&quot;&gt;
&lt;div id=&quot;tor__flistingLayout_content&quot;&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Do Work That Matters – Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l&apos;opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;KPMG Advisory offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Entrando a far parte del &lt;strong&gt;Team Enterprise Platform&lt;/strong&gt;, all&apos;interno della practice Microsoft sarai coinvolta/o in progetti di Digital Transformation, occupandoti dello sviluppo e dell&apos;implementazione della piattaforma &lt;strong&gt;Microsoft Dynamics 365 Business Central&lt;/strong&gt;, la soluzione ERP pensata per aziende di piccole e medie dimensioni.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Nello specifico ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Supportare lo sviluppo di &lt;strong&gt;estensioni&lt;/strong&gt; (extensions) su Business Central tramite il linguaggio &lt;strong&gt;AL&lt;/strong&gt; (il linguaggio di programmazione proprietario della piattaforma) e Visual Studio Code, apprendendo le logiche degli &lt;strong&gt;eventi&lt;/strong&gt;, il meccanismo con cui si aggiungono funzionalità senza modificare il codice base standard&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Contribuire alla realizzazione di &lt;strong&gt;integrazioni con sistemi esterni&lt;/strong&gt; attraverso API REST e OData, i meccanismi con cui Business Central scambia dati con altri applicativi aziendali&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Partecipare allo sviluppo di componenti applicativi come &lt;strong&gt;report&lt;/strong&gt; e &lt;strong&gt;pagine personalizzate&lt;/strong&gt;, oltre a semplici automazioni con &lt;strong&gt;Power Automate&lt;/strong&gt;, imparando a tradurre requisiti funzionali in soluzioni tecniche&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Affiancare il team nelle attività di &lt;strong&gt;debugging, testing e code review&lt;/strong&gt;, contribuendo a individuare e risolvere anomalie nel codice&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Acquisire familiarità con gli &lt;strong&gt;strumenti di pubblicazione e distribuzione&lt;/strong&gt; delle estensioni, incluso il processo di pubblicazione su &lt;strong&gt;AppSource&lt;/strong&gt;, il marketplace ufficiale Microsoft per le soluzioni certificate&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Collaborare con consulenti funzionali e stakeholder di business nelle fasi progettuali, incluse le fasi di &lt;strong&gt;go-live&lt;/strong&gt; (attivazione della soluzione) e &lt;strong&gt;hypercare&lt;/strong&gt; (supporto intensivo nel periodo immediatamente successivo)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Come As You Are – Le tue competenze e caratteristiche&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Sei un/a neolaureato/a o laureando/a in Informatica, Ingegneria Informatica, Ingegneria del Software o discipline affini&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai una &lt;strong&gt;buona conoscenza di linguaggi orientati agli oggetti&lt;/strong&gt; (come C#, Java o simili) e ti senti a tuo agio con la logica di sviluppo enterprise&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai &lt;strong&gt;curiosità per i sistemi ERP&lt;/strong&gt; e per la digitalizzazione dei processi aziendali: non è richiesta esperienza pregressa su Business Central, che potrai apprendere on the job con il supporto del team&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai buone capacità comunicative e una conoscenza dell&apos;inglese adeguata a lavorare in contesti internazionali&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Possiedi una buona padronanza della lingua inglese e attitudine al lavoro in team&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Sei disponibile a trasferte in Italia e all&apos;estero in base alle esigenze progettuali&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Your Future With Us – Cosa troverai in KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Un ambiente di lavoro inclusivo, equo e che rispetta, incoraggia e valorizza le diversità&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Un contesto stimolante e dinamico che incentiva la creatività e il lavoro di squadra&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Modalità di lavoro ibrida, per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Programmi di formazione e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Mindset internazionale e progettualità innovative&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Iniziative incentrate sul benessere psicofisico&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;L&apos;opportunità prevede un inserimento in stage con indennità mensile di 800€ per stage curriculare o 1.000€ per stage extracurriculare o in assunzione con inquadramento ai sensi del CCNL Commercio e RAL di ingresso: € 29.000, determinata sulla base di criteri oggettivi quali il titolo di studio e la valutazione del profilo rispetto ai requisiti della posizione.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Together for Better – I nostri valori e il nostro impegno&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i Valori di KPMG che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di esprimere tutto il loro potenziale.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Grazie all&apos;impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network risulta conforme agli standard dei requisiti ISO 30415, sul Sistema di Gestione per la Diversità e l&apos;Inclusione, e UNI PdR 125, relativa alla parità di genere. All&apos;interno del nostro Impact Plan trovi riassunte tutte le azioni concrete che stiamo portando avanti su tematiche ambientali, sociali e di governance (ESG).&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Unisciti a noi!&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (GDPR) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;We let the future guide us. Join our next generation&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Do Work That Matters – Your Role and Responsibilities&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG you will have the opportunity to help clients, society, and colleagues face and solve some of the most current and complex challenges.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;KPMG Advisory offers consulting services to businesses, supporting them in business model transformation, process improvement and digitalisation, risk analysis and management, as well as extraordinary finance operations.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;By joining the &lt;strong&gt;Enterprise Platform Team&lt;/strong&gt;, within the Microsoft practice you will be involved in Digital Transformation projects, working on the development and implementation of the &lt;strong&gt;Microsoft Dynamics 365 Business Central&lt;/strong&gt; platform, the ERP solution designed for small and medium-sized businesses.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Specifically, you will:&lt;/span&gt;&lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Support the development of &lt;strong&gt;extensions&lt;/strong&gt; on Business Central using the &lt;strong&gt;AL&lt;/strong&gt; language (the platform&apos;s proprietary programming language) and Visual Studio Code, learning the logic of &lt;strong&gt;events&lt;/strong&gt;, the mechanism used to add functionality without modifying the standard base code&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Contribute to the implementation of &lt;strong&gt;integrations with external systems&lt;/strong&gt; via REST APIs and OData, the mechanisms through which Business Central exchanges data with other business applications&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Take part in the development of application components such as &lt;strong&gt;reports&lt;/strong&gt; and &lt;strong&gt;custom pages&lt;/strong&gt;, as well as simple automations with &lt;strong&gt;Power Automate&lt;/strong&gt;, learning to translate functional requirements into technical solutions&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Support the team in &lt;strong&gt;debugging, testing and code review&lt;/strong&gt; activities, helping to identify and resolve anomalies in the code&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Gain familiarity with the &lt;strong&gt;publishing and distribution tools&lt;/strong&gt; for extensions, including the process of publishing to &lt;strong&gt;AppSource&lt;/strong&gt;, Microsoft&apos;s official marketplace for certified solutions&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Collaborate with functional consultants and business stakeholders during project phases, including &lt;strong&gt;go-live&lt;/strong&gt; (activation of the solution) and &lt;strong&gt;hypercare&lt;/strong&gt; (intensive support in the period immediately following go-live)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Come As You Are – Your Skills and Characteristics&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You hold or are completing a degree in Computer Science, Computer Engineering, Software Engineering or related disciplines&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have a &lt;strong&gt;good knowledge of object-oriented programming languages&lt;/strong&gt; (such as C#, Java or similar) and feel comfortable with enterprise development logic&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You are &lt;strong&gt;curious about ERP systems&lt;/strong&gt; and the digitalisation of business processes: no prior experience with Business Central is required, as you will learn on the job with the support of the team&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have strong communication skills and a working knowledge of English suitable for international work environments&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have a good command of English and a team-oriented attitude&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You are available for business travel in Italy and abroad based on project needs&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Your Future With Us – What You Will Find at KPMG&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;An inclusive, fair working environment that respects, encourages and values diversity&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;A stimulating and dynamic context that fosters creativity and teamwork&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hybrid working arrangements to promote a healthy work-life balance&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Advanced training and development programmes to keep your skills up to date&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;An international mindset and innovative projects&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Initiatives focused on physical and mental wellbeing&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;This opportunity is offered as either a paid internship offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships or a standard employment contract under the collective labour agreement for the commerce sector, with a starting gross annual salary of €29,000. The salary is determined on the basis of objective criteria, including educational qualifications and an assessment of the candidate&apos;s profile against the requirements of the role.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;In compliance with applicable law, we do not collect or use information about salaries received in current or previous employment relationships. Our selection procedures are based on objective and gender-neutral criteria.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Together for Better – Our Values and Our Commitment&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, community commitment, integrity: these are KPMG&apos;s Values, which create an environment open to the exchange of ideas and knowledge, enabling our professionals to express their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Through our commitment to fostering an inclusive workplace, our Network is compliant with the ISO 30415 standard on Diversity and Inclusion Management Systems, and UNI PdR 125 on gender equality. Within our Impact Plan you will find a summary of all the concrete actions we are taking on environmental, social and governance (ESG) topics.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Join us!&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of EU Regulation No. 679/2016 (GDPR) and subsequent amendments. For further information, please refer to KPMG&apos;s privacy policy.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;#LI-MM2&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Junior-Microsoft-Developer/1365971257/</link><guid isPermaLink="false">1365971257</guid><g:id>1365971257</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>IT Business Analyst SAP - Consumer and Industrial Market (Intern) (Milano, IT)</title><description><![CDATA[&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Do Work That Matters – Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l&apos;opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;KPMG Advisory offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Entrando a far parte del &lt;strong&gt;Team Enterprise Platform&lt;/strong&gt; di Milano, sarai coinvolta/o nell&apos;implementazione della piattaforma &lt;strong&gt;SAP&lt;/strong&gt; presso i nostri clienti: imparerai ad analizzare come funzionano i processi aziendali e a tradurli in soluzioni digitali, affiancando colleghe e colleghi più esperti in ogni fase del progetto.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Nello specifico ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Partecipare a incontri e interviste con le diverse aree aziendali del cliente per capire come lavorano e cosa serve loro (&lt;strong&gt;analisi dei requisiti&lt;/strong&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Contribuire a disegnare la soluzione più adatta per il cliente, utilizzando le &lt;strong&gt;funzionalità standard di SAP&lt;/strong&gt; o configurazioni su misura&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Aiutare a redigere la &lt;strong&gt;documentazione&lt;/strong&gt; che descrive come funzionerà la soluzione, sia dal punto di vista tecnico che di processo&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Supportare i &lt;strong&gt;test&lt;/strong&gt; della soluzione, sia internamente sia insieme agli utenti che la useranno&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Contribuire alla &lt;strong&gt;formazione degli utenti finali&lt;/strong&gt;, spiegando loro come utilizzare la nuova soluzione&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Affiancare il team di progetto nella fase finale, quando la soluzione viene attivata (&lt;strong&gt;rilascio&lt;/strong&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Sarai coinvolta/o su progetti sia nazionali che internazionali, collaborando con professionisti altamente qualificati e lavorando a stretto contatto con i nostri clienti del Consumer and Industrial Market, inclusi i settori Retail, Food &amp;amp; Drink, Consumer Products, Industrial and Manufacturing e Automotive.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Come As You Are – Le tue competenze e caratteristiche&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai un &lt;strong&gt;percorso accademico&lt;/strong&gt; in Economia, Management, Ingegneria Gestionale o Informatica&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai &lt;strong&gt;motivazione&lt;/strong&gt; a intraprendere un percorso di consulenza sui processi aziendali e sui sistemi informativi, anche senza esperienza pregressa in ambito SAP&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai un&apos;&lt;strong&gt;ottima conoscenza della lingua inglese&lt;/strong&gt;, meglio se avvalorata da un&apos;esperienza di studio e/o lavoro all&apos;estero&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai un&apos;&lt;strong&gt;ottima conoscenza del pacchetto Office&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Possiedi una buona padronanza della lingua inglese e attitudine al lavoro in team&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Sei disponibile a trasferte in Italia e all&apos;estero in base alle esigenze progettuali&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Your Future With Us – Cosa troverai in KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un ambiente di lavoro inclusivo, equo e che rispetta, incoraggia e valorizza le diversità&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un contesto stimolante e dinamico che incentiva la creatività e il lavoro di squadra&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Modalità di lavoro ibrida, per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Programmi di formazione e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Mindset internazionale e progettualità innovative&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Iniziative incentrate sul benessere psicofisico&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;L&apos;opportunità prevede un inserimento in stage con indennità mensile di 800€ per stage curriculare o 1.000€ per stage extracurriculare o in assunzione con inquadramento ai sensi del CCNL Commercio e RAL di ingresso: € 29.000, determinata sulla base di criteri oggettivi quali il titolo di studio e la valutazione del profilo rispetto ai requisiti della posizione.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Together for Better – I nostri valori e il nostro impegno&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i Valori di KPMG che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di esprimere tutto il loro potenziale.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Grazie all&apos;impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network risulta conforme agli standard dei requisiti ISO 30415, sul Sistema di Gestione per la Diversità e l&apos;Inclusione, e UNI PdR 125, relativa alla parità di genere. All&apos;interno del nostro Impact Plan - Our Impact Plan (kpmg.com) - trovi riassunte tutte le azioni concrete che stiamo portando avanti su tematiche ambientali, sociali e di governance (ESG).&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Unisciti a noi!&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;We let the future guide us. Join our next generation&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Do Work That Matters – Your Role and Responsibilities&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and your colleagues tackle and solve the most current and complex challenges.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;KPMG Advisory offers consulting services to businesses to support them in transforming their business models, improving and digitizing processes, analyzing and managing risks, and providing assistance in extraordinary financial operations.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;By joining the &lt;strong&gt;Enterprise Platform Team&lt;/strong&gt; in Milan, you will be involved in the implementation of the &lt;strong&gt;SAP&lt;/strong&gt; platform at our clients: you will learn how to analyze the way business processes work and translate them into digital solutions, working alongside more experienced colleagues at every stage of the project.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Specifically, you will:&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Take part in meetings and interviews with the client&apos;s different business areas to understand how they work and what they need (&lt;strong&gt;requirements analysis&lt;/strong&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Contribute to designing the most suitable solution for the client, using &lt;strong&gt;SAP&apos;s standard functionalities&lt;/strong&gt; or tailored configurations&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Help draft the &lt;strong&gt;documentation&lt;/strong&gt; describing how the solution will work, both from a technical and a process perspective&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Support &lt;strong&gt;testing&lt;/strong&gt; of the solution, both internally and together with the users who will use it&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Contribute to &lt;strong&gt;training end users&lt;/strong&gt;, explaining how to use the new solution&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Work alongside the project team in the final phase, when the solution goes live (&lt;strong&gt;release&lt;/strong&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You will be involved in both national and international projects, working alongside highly qualified professionals and collaborating closely with our clients in the Consumer and Industrial Market, including sectors such as Retail, Food &amp;amp; Drink, Consumer Products, Industrial and Manufacturing, and Automotive.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Come As You Are – Your Skills and Attributes&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;This opportunity is right for you if:&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have an &lt;strong&gt;academic background&lt;/strong&gt; in Business, Management, Management Engineering or Computer Science&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have the &lt;strong&gt;motivation&lt;/strong&gt; to build a consulting career on business processes and information systems, even without prior experience in SAP&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have an &lt;strong&gt;excellent command of English&lt;/strong&gt;, ideally supported by study and/or work experience abroad&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have &lt;strong&gt;excellent knowledge of the Office suite&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have a good command of English and a team-oriented attitude&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You are available for business travel in Italy and abroad based on project needs&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Your Future With Us – What You Will Find at KPMG&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;ul dir=&quot;ltr&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;An inclusive and equitable work environment that respects, encourages, and values diversity&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;A stimulating and dynamic context that fosters creativity and teamwork&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;A hybrid work model to promote a healthy work-life balance&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Advanced training and development programs to stay up-to-date&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;An international mindset and innovative projects&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Initiatives focused on physical and mental well-being&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;This opportunity is offered as either a paid internship offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships or a standard employment contract under the collective labour agreement for the commerce sector, with a starting gross annual salary of €29,000. The salary is determined on the basis of objective criteria, including educational qualifications and an assessment of the candidate&apos;s profile against the requirements of the role.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;In compliance with applicable law, we do not collect or use information about salaries received in current or previous employment relationships. Our selection processes are also based on objective and gender neutral criteria.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Together for Better – Our Values and Commitment&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, community engagement, and integrity: these are KPMG&apos;s Values, which create an open environment for the exchange of ideas and knowledge, allowing our professionals to reach their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;As a result of our commitment to fostering an inclusive work environment, our Network complies with the standards of the ISO 30415 requirements, on the Diversity and Inclusion Management System, and UNI PdR 125, relating to gender equality. Our Impact Plan - Our Impact Plan (kpmg.com) – summarizes all the concrete actions we are undertaking on environmental, social, and governance (ESG) issues.&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Join us!&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;The requested data will be processed in full compliance with the provisions of European Regulation 679/2016 (General Data Protection Regulation - &quot;GDPR&quot; or &quot;Privacy Regulation&quot;) and its subsequent amendments and integrations.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt; &lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. guarantees equal opportunities.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p dir=&quot;ltr&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;#LI-MM2&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-IT-Business-Analyst-SAP-Consumer-and-Industrial-Market-%28Intern%29/1366391357/</link><guid isPermaLink="false">1366391357</guid><g:id>1366391357</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>Senior Consultant - SAP CO (Padova, IT)</title><description><![CDATA[&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;The chance to build a better future is right in front of you&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Do Work That Matters - Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l&apos;opportunità di aiutare clienti, società, colleghe e colleghi ad affrontare e risolvere le sfide più attuali e complesse.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;KPMG Advisory affianca le imprese nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, supportando i clienti anche nell&apos;analisi e gestione dei rischi e nelle operazioni di finanza straordinaria. &lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Entrando a far parte del Team Enterprise Platforms, lavorerai su progetti di implementazione ed evoluzione SAP con focus su &lt;strong&gt;SAP CO&lt;/strong&gt;, contribuendo ai processi di controllo di gestione end-to-end su &lt;strong&gt;SAP ECC&lt;/strong&gt; e &lt;strong&gt;SAP S/4HANA&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Fit-to-Standard&lt;/strong&gt;/&lt;strong&gt;Blueprint&lt;/strong&gt; e disegno dei processi &lt;strong&gt;to-be&lt;/strong&gt; con stakeholder di Finance, Controlling e CFO office&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Configurazione &lt;strong&gt;SAP CO&lt;/strong&gt; e modellazione della struttura di controllo di gestione (centri di costo, ordini interni, analisi della redditività)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Gestione dell&apos;&lt;strong&gt;Universal Journal&lt;/strong&gt; (&lt;strong&gt;ACDOCA&lt;/strong&gt;) e implicazioni del modello dati &lt;strong&gt;S/4HANA&lt;/strong&gt; per il Controlling&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Integrazioni con &lt;strong&gt;FI&lt;/strong&gt;, &lt;strong&gt;SD&lt;/strong&gt;, &lt;strong&gt;MM&lt;/strong&gt; e &lt;strong&gt;PP&lt;/strong&gt; (flussi ricavi, costi di produzione e scostamenti)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Documentazione funzionale (&lt;strong&gt;Blueprint&lt;/strong&gt;, &lt;strong&gt;Functional Design&lt;/strong&gt;, specifiche sviluppi, manuali utente)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Sarai coinvolta/o su progetti nazionali e internazionali, lavorando a stretto contatto con clienti e team multidisciplinari, in particolare su contesti&lt;strong&gt; Industrial &amp;amp; Manufacturing &lt;/strong&gt;(es. Automotive, Industrial Manufacturing, Food &amp;amp; Drink, Consumer Products, Pharmaceutical &amp;amp; Life Sciences).&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;&lt;strong&gt;Come As You Are – Le tue competenze e caratteristiche&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai &lt;strong&gt;3–5 anni di esperienza&lt;/strong&gt; su progetti &lt;strong&gt;SAP CO&lt;/strong&gt;, maturata su almeno un progetto di implementazione o migrazione &lt;strong&gt;S/4HANA&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai competenze solide di configurazione &lt;strong&gt;SAP CO&lt;/strong&gt; e padronanza dei processi di controllo di gestione in contesti industriali&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Conosci il modello dati &lt;strong&gt;S/4HANA&lt;/strong&gt; (&lt;strong&gt;ACDOCA&lt;/strong&gt;, &lt;strong&gt;Universal Journal&lt;/strong&gt;) e le sue implicazioni per il Controlling&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai esperienza su documentazione funzionale, &lt;strong&gt;SIT&lt;/strong&gt;/&lt;strong&gt;UAT&lt;/strong&gt; e gestione requisiti in autonomia&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai familiarità con le integrazioni &lt;strong&gt;CO–FI&lt;/strong&gt;, &lt;strong&gt;CO–SD&lt;/strong&gt; e &lt;strong&gt;CO–PP&lt;/strong&gt;/&lt;strong&gt;MM&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Costituisce un plus la conoscenza di &lt;strong&gt;CO-PC&lt;/strong&gt; (Product Costing) in contesti manifatturieri&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Buona conoscenza dell&apos;&lt;strong&gt;inglese&lt;/strong&gt;, attitudine al lavoro in team e disponibilità a &lt;strong&gt;trasferte&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;&lt;strong&gt;Your Future With Us - Cosa troverai in KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul style=&quot;list-style-type:disc&quot;&gt;
&lt;li style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;color:black&quot;&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 31.000 e € 41.000 , determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione. &lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;color:black&quot;&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;&lt;strong&gt;Together for Better – I nostri valori e il nostro impegno&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a style=&quot;color:black&quot; href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Do Work That Matters - Your role and responsibilities&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG you will have the opportunity to help clients, society, colleagues and peers tackle and solve the most current and complex challenges.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;KPMG Advisory supports companies in transforming their business model, improving and digitalising their processes, while also helping clients analyse and manage risks and navigate extraordinary finance transactions. &lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;By joining the Enterprise Platforms Team, you will work on SAP implementation and evolution projects with a focus on &lt;strong&gt;SAP CO&lt;/strong&gt;, contributing to end-to-end management accounting processes on &lt;strong&gt;SAP ECC&lt;/strong&gt; and &lt;strong&gt;SAP S/4HANA&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Specifically, you will be responsible for:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Fit-to-Standard&lt;/strong&gt;/&lt;strong&gt;Blueprint&lt;/strong&gt; and &lt;strong&gt;to-be&lt;/strong&gt; process design with Finance, Controlling and CFO office stakeholders&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;SAP CO&lt;/strong&gt; configuration and modelling of the management accounting structure (cost centres, internal orders, profitability analysis)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Universal Journal&lt;/strong&gt; (&lt;strong&gt;ACDOCA&lt;/strong&gt;) management and understanding of &lt;strong&gt;S/4HANA&lt;/strong&gt; data model implications for Controlling&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Integrations with &lt;strong&gt;FI&lt;/strong&gt;, &lt;strong&gt;SD&lt;/strong&gt;, &lt;strong&gt;MM&lt;/strong&gt; and &lt;strong&gt;PP&lt;/strong&gt; (revenue flows, production costs and variances)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Functional documentation (&lt;strong&gt;Blueprint&lt;/strong&gt;, &lt;strong&gt;Functional Design&lt;/strong&gt;, development specifications, user manuals)&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You will be involved in national and international projects, working closely with clients and multidisciplinary teams, particularly in Industrial &amp;amp; Manufacturing contexts (e.g. Automotive, Industrial Manufacturing, Food &amp;amp; Drink, Consumer Products, Pharmaceutical &amp;amp; Life Sciences).&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Come As You Are – Your skills and background&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;This opportunity is the right fit for you if:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have &lt;strong&gt;3–5 years of experience&lt;/strong&gt; on &lt;strong&gt;SAP CO&lt;/strong&gt; projects, gained on at least one &lt;strong&gt;S/4HANA&lt;/strong&gt; implementation or migration project&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have solid &lt;strong&gt;SAP CO&lt;/strong&gt; configuration skills and a strong command of management accounting processes in industrial environments&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You are familiar with the &lt;strong&gt;S/4HANA&lt;/strong&gt; data model (&lt;strong&gt;ACDOCA&lt;/strong&gt;, &lt;strong&gt;Universal Journal&lt;/strong&gt;) and its implications for Controlling&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have experience in functional documentation, &lt;strong&gt;SIT&lt;/strong&gt;/&lt;strong&gt;UAT&lt;/strong&gt; and requirements management, working independently&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You are familiar with &lt;strong&gt;CO–FI&lt;/strong&gt;, &lt;strong&gt;CO–SD&lt;/strong&gt; and &lt;strong&gt;CO–PP&lt;/strong&gt;/&lt;strong&gt;MM&lt;/strong&gt; integrations&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Knowledge of &lt;strong&gt;CO-PC&lt;/strong&gt; (Product Costing) in manufacturing environments is a plus&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Good command of &lt;strong&gt;English&lt;/strong&gt;, team-oriented mindset and willingness to &lt;strong&gt;travel&lt;/strong&gt; as required by project needs&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Your Future With Us - What you will find at KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;An inclusive and equitable work environment that respects, encourages and values diversity&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;A stimulating and dynamic context that fosters creativity and teamwork&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hybrid working model to promote a healthy work-life balance&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Advanced training and development programmes to keep you always up to date&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;International mindset and innovative projects&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Initiatives focused on physical and mental wellbeing&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €31,000 to €41,000. The salary is determined on the basis of objective criteria, including the candidate’s skills and experience assessed against the requirements of the role. &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Together for Better – Our values and commitment&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, commitment to the community, integrity: these are KPMG&apos;s Values, which create an environment open to the exchange of ideas and knowledge, allowing our professionals to express their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Through our commitment to fostering an inclusive work environment, our Network complies with the requirements of ISO 30415 (Diversity and Inclusion Management System) and UNI PdR 125 (gender equality). Within our Impact Plan — Our Impact Plan (kpmg.com) — you will find a summary of all the concrete actions we are taking on environmental, social and governance (ESG) topics.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Join us!&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Personal data will be processed in full compliance with the provisions of EU Regulation No. 679/2016 (General Data Protection Regulation — &quot;GDPR&quot;) and subsequent amendments. For further information, please refer to KPMG&apos;s privacy policy.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;#LI-EB1 &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:left&quot;&gt; &lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Padova-Senior-Consultant-SAP-CO/1358880457/</link><guid isPermaLink="false">1358880457</guid><g:id>1358880457</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Padova, IT</g:location></item><item><title>Senior Data Science Consultant (Roma, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;We don’t imagine a better future. We’re building it!&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;strong&gt;KPMG Advisory &lt;/strong&gt;offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Nel particolare, entrerai a far parte del &lt;strong&gt;Team di Lighthouse&lt;/strong&gt; di &lt;strong&gt;Roma&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;La &lt;strong&gt;Lighthouse&lt;/strong&gt; è il centro di eccellenza di &lt;strong&gt;KPMG Advisory&lt;/strong&gt; che offre soluzioni di &lt;strong&gt;Data &amp;amp; Analytics&lt;/strong&gt; sul mercato.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Opererai in un ambiente orientato all&apos;innovazione tecnologica, occupandoti dello sviluppo di soluzioni &lt;em&gt;End to End&lt;/em&gt; di Intelligenza Artificiale con particolare focus sull’applicazione di Large Language Models e Agenti AI.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Analizzare casi di business e tradurli in &lt;strong&gt;soluzioni di Intelligenza Artificiale&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Disegnare la soluzione secondo gli aspetti tecnici e &lt;strong&gt;tecnologici&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Identificare, elaborare ed &lt;strong&gt;integrare&lt;/strong&gt; fonti di dati per supportare strumenti e metodologie Data-Driven;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Costruire &lt;strong&gt;AI pipeline&lt;/strong&gt; complete, dall&apos;ingestione dei dati alle applicazioni frontend nel Cloud;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Comunicare e condividere&lt;/strong&gt; i dettagli del progetto con gli utenti aziendali per creare fiducia e spiegare le metodologie;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Sviluppo del team&lt;/strong&gt;: Fare da mentore ai nuovi membri del team sia nell’ambito del progetto che per migliorare le loro competenze e la loro crescita come Data Scientist e AI Engineer.&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Supportare il lancio e gestire la &lt;strong&gt;manutenzione&lt;/strong&gt; delle applicazioni.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai maturato 3/4 anni di esperienza di lavoro su progetti di &lt;strong&gt;Advanced Analytics&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Possiedi una buona conoscenza di &lt;strong&gt;Python&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Possiedi una buona conoscenza di come progettare e organizzare un &lt;strong&gt;Modello di Dati&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Possiede delle competenze solide in ambito &lt;strong&gt;statistico&lt;/strong&gt; e modelli di &lt;strong&gt;machine learning&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Possiedi una buona conoscenza di come rappresentare i risultati graficamente;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Possiedi una buona conoscenza degli ambienti &lt;strong&gt;Cloud&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Esperienza nell&apos;elaborazione di tecniche di &lt;strong&gt;Natural Language Processing&lt;/strong&gt; (&lt;strong&gt;NLP&lt;/strong&gt;) e &lt;strong&gt;AI&lt;/strong&gt; &lt;strong&gt;generativa&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai una buona padronanza della &lt;strong&gt;lingua inglese&lt;/strong&gt;, preferibilmente con esperienze di studio e/o lavoro all&apos;estero.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un ambiente di lavoro &lt;strong&gt;inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida&lt;/strong&gt;, per promuovere un sano equilibrio tra vita lavorativa e personale;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 31.000 e € 41.000, determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.  &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Grazie all’impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network risulta conforme agli standard dei requisiti ISO 30415, sul Sistema di Gestione per la Diversità e l’Inclusione, e UNI PdR 125, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le azioni concrete che stiamo portando avanti su tematiche ambientali, sociali e di governance (ESG). &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;We don’t imagine a better future. We’re building it&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the company and colleagues address and solve the most current and complex challenges. &lt;strong&gt;KPMG Advisory &lt;/strong&gt;offers consulting services to companies to assist them in business model transformation, process improvement and digitisation, risk analysis and management, and support in extraordinary finance transactions.  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Specifically, you will join our &lt;strong&gt;Lighthouse team&lt;/strong&gt; in &lt;strong&gt;Rome&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Lighthouse&lt;/strong&gt; is the &lt;strong&gt;KPMG Advisory&lt;/strong&gt; centre of excellence delivering an array of &lt;strong&gt;data &amp;amp; analytics&lt;/strong&gt; solutions.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You will work in a technology-driven environment, focusing on the &lt;a name=&quot;_Hlk203554848&quot;&gt;&lt;/a&gt;development of end-to-end Artificial Intelligence solutions, with particular emphasis on the application of Large Language Models and AI Agents.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:6.0pt 0.0cm 3.0pt;line-height:normal;background-color:#fafafa;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;color:black;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Specifically, you will be responsible for:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-bottom:0.0cm;margin-top:0.0px&quot;&gt;
&lt;li style=&quot;background-color:#fafafa;margin:0.0cm 0.0cm 8.0pt 0.2px;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif;text-indent:0.2px&quot;&gt;&lt;span style=&quot;color:black;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Analyzing business cases and translating them into &lt;strong&gt;Artificial Intelligence solutions&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;background-color:#fafafa;margin:0.0cm 0.0cm 8.0pt 0.2px;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif;text-indent:0.2px&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;color:black&quot;&gt;Designing&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color:black&quot;&gt; the solution from both technical and technological perspectives;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;background-color:#fafafa;margin:0.0cm 0.0cm 8.0pt 0.2px;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif;text-indent:0.2px&quot;&gt;&lt;span style=&quot;color:black;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Identifying, processing, and &lt;strong&gt;integrating&lt;/strong&gt; data sources to support data-driven tools and methodologies;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;background-color:#fafafa;margin:0.0cm 0.0cm 8.0pt 0.2px;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif;text-indent:0.2px&quot;&gt;&lt;span style=&quot;color:black;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Building complete &lt;strong&gt;AI pipelines&lt;/strong&gt;, from data ingestion to frontend applications in the Cloud;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;background-color:#fafafa;margin:0.0cm 0.0cm 8.0pt 0.2px;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif;text-indent:0.2px&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;color:black&quot;&gt;Communicating&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color:black&quot;&gt; and sharing project details with business users to build trust and explain the methodologies;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;background-color:#fafafa;margin:0.0cm 0.0cm 8.0pt 0.2px;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif;text-indent:0.2px&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;color:black&quot;&gt;Team development&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color:black&quot;&gt;: Mentoring new team members both within the project and to enhance their skills and growth as Data Scientists and AI Engineers;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;background-color:#fafafa;margin:0.0cm 0.0cm 8.0pt 0.2px;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif;text-indent:0.2px&quot;&gt;&lt;span style=&quot;color:black;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Supporting the launch and managing the &lt;strong&gt;maintenance&lt;/strong&gt; of applications.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt 35.7pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Your skills and characteristics&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have at least &lt;strong&gt;3 years&lt;/strong&gt; of experience working on &lt;strong&gt;Advanced Analytics projects&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have a good knowledge of &lt;strong&gt;Python&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have a solid understanding of how to design and organize a &lt;strong&gt;Data Model&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You possess strong skills in statistics and &lt;strong&gt;machine learning&lt;/strong&gt; models;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You are proficient in visually representing results;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have a good knowledge of &lt;strong&gt;Cloud environments&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have experience with &lt;strong&gt;Natural Language Processing&lt;/strong&gt; (NLP) techniques and &lt;strong&gt;Generative AI&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have a good command of the &lt;strong&gt;English language&lt;/strong&gt;, preferably with study and/or work experience abroad.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - What you’ll find at KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;An &lt;strong&gt;inclusive&lt;/strong&gt; and equitable &lt;strong&gt;work environment&lt;/strong&gt; that respects, encourages and values &lt;strong&gt;diversity.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;A challenging and dynamic environment that encourages&lt;strong&gt; creativity&lt;/strong&gt; and &lt;strong&gt;teamwork.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Hybrid&lt;/strong&gt; work arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programmes to stay current.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;International mindset&lt;/strong&gt; and &lt;strong&gt;innovative projects.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being. &lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €31,000 to €41,000. The salary is determined on the basis of objective criteria, including the candidate’s skills and experience assessed against the requirements of the role. &lt;/p&gt;
&lt;p&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better – Our values and commitment&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;As a result of our commitment to fostering an inclusive work environment, our Network complies with the standards of the ISO 30415 requirements, on the Diversity and Inclusion Management System, and UNI PdR 125, relating to gender equality.  Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarised all the &lt;strong&gt;concrete actions&lt;/strong&gt; we are taking on environmental, social and governance (ESG) issues.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG’s privacy policy.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;#LI-DM1 &lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Roma-Senior-Data-Science-Consultant/1362959657/</link><guid isPermaLink="false">1362959657</guid><g:id>1362959657</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Roma, IT</g:location></item><item><title>Consultant - Tech Risk | Firenze/Bologna/Parma (Bologna, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Do Work That Matters &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;- Il tuo ruolo e le tue responsabilità &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. Nel rispetto dei valori di integrità e qualità,&lt;strong&gt; KPMG Audit &amp;amp; Assurance &lt;/strong&gt;offre un portafoglio di servizi integrato in costante evoluzione, con insight che consentono alle aziende di rispondere ai fabbisogni informativi del mercato e degli investitori. In particolare, entrerai a far parte del &lt;span style=&quot;color:black;background-color:white&quot;&gt;Team&lt;/span&gt;&lt;strong&gt; Cyber&amp;amp;Tech Risk&lt;/strong&gt;, linea di servizi di KPMG che ha anticipato e seguito nel tempo le richieste del mercato relative alle tematiche di Information Risk Management e Sicurezza Informatica, sviluppando costantemente le competenze e capacità di analisi a protezione del patrimonio informativo aziendale.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black;background-color:white&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-bottom:0.0cm;margin-top:0.0px&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.4px;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:0.4px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;Comprendere il contesto tecnologico e di business dei clienti&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.4px;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:0.4px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;Mappare i processi business ed IT, identificandone i rischi e definendo il giusto approccio per mitigarli &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.4px;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:0.4px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;Analizzare le nuove tecnologie e capirne i rischi specifici&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 8.0pt 0.4px;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:0.4px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;Identificare i dati chiave e definire i controlli per renderli affidabili e sicuri&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;I professionisti appartenenti al team CTR di KPMG supportano le organizzazioni in tutte le fasi necessarie a garantire la sicurezza delle loro informazioni e delle loro strategie di business. Possiamo affiancare i nostri clienti per migliorare la crescita e creare valore. Possiamo aiutarli a fare i giusti investimenti nel momento giusto, a considerare le implicazioni più ampie della digital disruption, ad integrare tecnologie innovative nelle infrastrutture esistenti.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Le tue competenze e caratteristiche &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Sei un laureando/neolaureato magistrale in Ingegneria Gestionale, Management dell’innovazione, Management ecc.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Passione per le nuove tecnologie e la loro declinazione nei contesti aziendali&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Competenze nella comprensione e analisi dei processi aziendali&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Capacità di analisi dei dati e di sintesi nella presentazione dei risultati&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Interesse per l&apos;ambito dei Sistemi Informativi aziendali, intesi quale strumento abilitante per l&apos;efficace erogazione dei processi&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Predisposizione per la risoluzione di problemi complessi&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Proattività, flessibilità e capacità di adattamento a contesti eterogenei e sfidanti&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Hai una buona padronanza della lingua inglese, preferibilmente con esperienze di studio e/o lavoro all&apos;estero&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;background-color:white;margin:0.0cm 0.0cm 8.0pt 0.0px;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;Sei disponibile a viaggiare sul territorio nazionale&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Your Future With Us - Cosa troverai in KPMG&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Mindset&lt;/span&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; internazionale&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;L’opportunità prevede un inserimento in stage con indennità mensile di 800€ / L’opportunità prevede un inserimento in stage con indennità mensile di 800€ per stage curriculare o 1.000€ per stage extracurriculare o in assunzione con inquadramento ai sensi del CCNL Commercio e RAL di ingresso compresa tra € 28.000 e € 31.500, determinata sulla base di criteri oggettivi quali il titolo di studio e la valutazione del profilo rispetto ai requisiti della posizione.&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;&lt;br&gt;Together for Better – I nostri valori e il nostro impegno&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere. &lt;/span&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;/span&gt;&lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:windowtext&quot;&gt;Our Impact Plan (kpmg.com)&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Unisciti a noi!&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;KPMG S.p.A. garantisce le pari opportunità&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Do Work That Matters - Your role and responsibilities &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the company and colleagues address and solve the most current and complex challenges. In keeping with the values of integrity and quality&lt;strong&gt;, KPMG Audit &amp;amp; Assurance&lt;/strong&gt; offers an integrated and constantly evolving portfolio of services, with insights that allow companies to respond to the informational/reporting needs of the market and investors. The &lt;strong&gt;Cyber&amp;amp;Tech Risk&lt;/strong&gt; team handles the KPMG line of services that pre-empted and continues to meet market demand for information risk management and cybersecurity services, continually developing the analytical skills and expertise to protect company information.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Specifically, you will be tasked with:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-bottom:0.0cm;margin-top:0.0px&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.4px;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:0.4px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;understanding clients’ technological and business context;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.4px;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:0.4px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;mapping business and IT processes, identifying their risks and developing the right approach to mitigate them; &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.4px;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:0.4px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;analysing new technologies and understanding their specific risks;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 8.0pt 0.4px;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:0.4px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;identifying key data and defining controls to guarantee they are reliable and secure.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:107%&quot;&gt;The members of KPMG’s CTR team support organisations across all phases of the process to ensure the security of their information and business strategies. We help our clients drive growth and generate value.  We can help them make the right investments at the right time, consider the broader implications of the digital disruption and build breakthrough innovations into their legacy infrastructure.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Come As You Are - Your skills and characteristics &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;This is the perfect opportunity for you if you have:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;or will soon have a master’s degree in management engineering, innovation management, management, etc.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;a passion for new technologies and their application in corporate settings;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;expertise in understanding and analysing company processes;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;an ability to analyse and summarise data when reporting findings;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;an interest in corporate IT systems as enablers for the effective performance of processes; &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;an aptitude for complex problem solving;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;proactiveness, flexibility and an ability to adapt to different challenging situations;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;background-color:white;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;a good knowledge of English, preferably with study/work experience abroad;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;background-color:white;margin:0.0cm 0.0cm 8.0pt 0.0px;font-size:11.0pt;font-family:Aptos, sans-serif;text-indent:4.7333px&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:black&quot;&gt;availability to travel within Italy.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Your Future With Us - What you’ll find at KPMG&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;An &lt;strong&gt;inclusive&lt;/strong&gt; and equitable work environment that respects, encourages and values diversity.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;A challenging and &lt;strong&gt;dynamic environment&lt;/strong&gt; that encourages creativity and teamwork.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Hybrid work arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programmes to stay up-to-date.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;International mindset&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; and innovative projects.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Initiatives focused on mental and physical well-being.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;line-height:150%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:11.0pt;text-align:justify&quot;&gt;This opportunity is offered as either a paid internship with a monthly allowance of €800 / This opportunity is offered as either a paid internship offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships or a standard employment contract under the collective labour agreement for the commerce sector, with a starting gross annual salary  ranging from €28,000 to €31,500. The salary is determined on the basis of objective criteria, including educational qualifications and an assessment of the candidate’s profile against the requirements of the role.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria.&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;&lt;br&gt;&lt;strong&gt;&lt;em&gt;Together for Better – Our values and commitment&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the KPMG values that create an environment that encourages the sharing of ideas and knowledge, so our professionals can achieve their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality Within our Impact Plan - &lt;/span&gt;&lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;color:windowtext&quot;&gt;Our Impact Plan (kpmg.com)&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; - you will find summarised all the concrete actions we are taking on environmental, social and governance (ESG) issues.  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Join us!&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG&apos;s privacy policy.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;KPMG S.p.A. is an equal opportunity employer&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Bologna-Consultant-Tech-Risk-FirenzeBolognaParma/1358807557/</link><guid isPermaLink="false">1358807557</guid><g:id>1358807557</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Bologna, IT</g:location></item><item><title>Assistant Manager / Manager - Monitoring Public, Fondi Strutturali Napoli (Napoli, IT)</title><description><![CDATA[&lt;p&gt;&lt;strong&gt;Assistant Manager/Manager – Monitoring Public Fondi Strutturali &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;In KPMG, you’ll feel closer to your full potential&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters&lt;/em&gt;&lt;/strong&gt;&lt;em&gt; &lt;strong&gt;- Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;strong&gt;KPMG Advisory &lt;/strong&gt;offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;In particolare, entrando a far parte del Team &lt;strong&gt;Monitoring Public&lt;/strong&gt; di &lt;strong&gt;Napoli&lt;/strong&gt; avrai l’opportunità di supportare i nostri clienti nel miglioramento dell’efficacia e dell’efficienza di processi ed organizzazioni, indirizzando l’incremento delle performance economico-finanziarie.&lt;/p&gt;
&lt;p&gt;Ricerchiamo professionisti che abbiano una conoscenza approfondita dei temi di politica e normativa comunitaria e abbiano maturato&lt;u&gt; 7-10 anni di esperienza &lt;/u&gt;nel settore pubblico ed in particolare come assistenza tecnica per la programmazione, gestione, monitoraggio e controllo dei Programmi cofinanziati con fondi Strutturali FEAMP/FSE/FESR e/o FSC e del PNRR.   &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Nello specifico, ti occuperai di:&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;organizzazione contabile e sistemi di controllo interno;&lt;/li&gt;
&lt;li&gt;attività di assistenza tecnica ai Programmi cofinanziati FEAMP/FESR/FSE+/FSC per le amministrazioni centrali e/o regionali;&lt;/li&gt;
&lt;li&gt;definizione di modelli e sistemi per supportare il governo e la programmazione delle risorse delle pubbliche amministrazioni anche in ottica di PNRR;&lt;/li&gt;
&lt;li&gt;progetti e studi internazionali per la Commissione Europea. &lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Questa opportunità è perfetta per te se:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;hai una laurea magistrale di indirizzo economico;&lt;/li&gt;
&lt;li&gt;hai maturato &lt;strong&gt;almeno 7 anni di esperienza&lt;/strong&gt; su tematiche pubbliche o fondi nazionali e strutturali;&lt;/li&gt;
&lt;li&gt;possiedi una buona conoscenza del funzionamento della PA e dei modelli di sistemi di gestione e controllo dei programmi UE (AdG,AdC e AdA);&lt;/li&gt;
&lt;li&gt;hai un’ottima conoscenza della lingua inglese;&lt;/li&gt;
&lt;li&gt;hai un’ottima conoscenza del pacchetto Office e, quale titolo preferenziale, di strumenti e tool di data visualization.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;br&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/li&gt;
&lt;li&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 38.000 e € 51.000 per la qualifica di Assistant Manager e tra € 52.000 e € 65.000 per la qualifica di Manager, determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione. &lt;/p&gt;
&lt;p&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt; &lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt; &lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Assistant Manager/Manager – Monitoring Public Structural Funds &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;At KPMG, you’ll feel closer to reaching your full potential.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Do Work That Matters – Your Role and Responsibilities&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and colleagues address and solve today’s most relevant and complex challenges.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;KPMG Advisory&lt;/strong&gt; provides consulting services to organizations, supporting them in transforming their business models, improving and digitalizing processes, analyzing and managing risks, and assisting with extraordinary finance transactions.&lt;/p&gt;
&lt;p&gt;By joining the &lt;strong&gt;Monitoring Public Team&lt;/strong&gt; in &lt;strong&gt;Naples&lt;/strong&gt;, you will have the opportunity to support our clients in improving the effectiveness and efficiency of processes and organizations, while driving enhanced financial and economic performance.&lt;/p&gt;
&lt;p&gt;We are looking for professionals with an in-depth knowledge of EU policies and regulations and &lt;strong&gt;7–10 years of experience&lt;/strong&gt; in the public sector, particularly in technical assistance activities related to the programming, management, monitoring, and control of programs co-financed by &lt;strong&gt;FEAMP, ESF, ERDF, FSC&lt;/strong&gt;, and/or the &lt;strong&gt;National Recovery and Resilience Plan (PNRR)&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Specifically, you will be responsible for:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Accounting organization and internal control systems;&lt;/li&gt;
&lt;li&gt;Technical assistance activities for programs co-financed by &lt;strong&gt;FEAMP, ERDF, ESF+, and FSC&lt;/strong&gt; for central and/or regional public administrations;&lt;/li&gt;
&lt;li&gt;Designing models and systems to support the governance and planning of public administration resources, including within the framework of the &lt;strong&gt;PNRR&lt;/strong&gt;;&lt;/li&gt;
&lt;li&gt;International projects and studies for the &lt;strong&gt;European Commission&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Come As You Are – Your Skills and Qualifications&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;This opportunity is perfect for you if you:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Hold a &lt;strong&gt;Master’s degree in Economics, Finance, Business Administration&lt;/strong&gt;, or a related field;&lt;/li&gt;
&lt;li&gt;Have at least &lt;strong&gt;7 years of experience&lt;/strong&gt; in public-sector matters or national and structural funds;&lt;/li&gt;
&lt;li&gt;Possess a solid understanding of the functioning of Public Administration and of EU program management and control systems (&lt;strong&gt;Managing Authority – AdG, Certifying Authority – AdC, and Audit Authority – AdA&lt;/strong&gt;);&lt;/li&gt;
&lt;li&gt;Have an &lt;strong&gt;excellent command of English&lt;/strong&gt;;&lt;/li&gt;
&lt;li&gt;Have an &lt;strong&gt;excellent knowledge of Microsoft Office&lt;/strong&gt; and, preferably, experience with &lt;strong&gt;data visualization tools and platforms&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Your Future With Us – What You Will Find at KPMG&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;An &lt;strong&gt;inclusive and equitable workplace&lt;/strong&gt; that respects, encourages, and values diversity;&lt;/li&gt;
&lt;li&gt;A stimulating and dynamic environment that promotes &lt;strong&gt;creativity&lt;/strong&gt; and &lt;strong&gt;teamwork&lt;/strong&gt;;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Hybrid working arrangements&lt;/strong&gt; to support a healthy work-life balance;&lt;/li&gt;
&lt;li&gt;Advanced &lt;strong&gt;training and professional development programs&lt;/strong&gt; to help you stay up to date;&lt;/li&gt;
&lt;li&gt;An &lt;strong&gt;international mindset&lt;/strong&gt; and exposure to &lt;strong&gt;innovative projects&lt;/strong&gt;;&lt;/li&gt;
&lt;li&gt;Initiatives focused on &lt;strong&gt;physical and mental well-being&lt;/strong&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €50,000 to €59,000. The salary is determined on the basis of objective criteria, including the candidate’s skills and experience assessed against the requirements of the role. &lt;/p&gt;
&lt;p&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Together for Better – Our Values and Commitment&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Leadership, teamwork, respect for individuality, continuous learning, transparency, community commitment, and integrity: these are the &lt;strong&gt;KPMG Values&lt;/strong&gt; that foster an environment open to the exchange of ideas and knowledge, enabling our professionals to &lt;strong&gt;fully express their potential&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Thanks to our commitment to creating an &lt;strong&gt;inclusive workplace&lt;/strong&gt;, our Network complies with the requirements of &lt;strong&gt;ISO 30415&lt;/strong&gt; for Diversity and Inclusion Management Systems and &lt;strong&gt;UNI/PdR 125&lt;/strong&gt; relating to gender equality.&lt;/p&gt;
&lt;p&gt;Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; (&lt;em&gt;Our Impact Plan – kpmg.com&lt;/em&gt;), you can find a summary of all the &lt;strong&gt;concrete actions&lt;/strong&gt; we are undertaking in the areas of &lt;strong&gt;Environmental, Social, and Governance (ESG)&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Join Us!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;Your personal data will be processed in full compliance with Regulation (EU) No. 679/2016 (General Data Protection Regulation – “GDPR”) and subsequent amendments. For further information, please refer to KPMG’s Privacy Notice.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;KPMG Advisory S.p.A. is an Equal Opportunity Employer.&lt;/em&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Napoli-Assistant-Manager-Manager-Monitoring-Public%2C-Fondi-Strutturali-Napoli/1366388257/</link><guid isPermaLink="false">1366388257</guid><g:id>1366388257</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Napoli, IT</g:location></item><item><title>Impiegato amministrativo contabile - Company Members Administration (Milano, IT)</title><description><![CDATA[&lt;h1 style=&quot;text-align:center&quot;&gt; &lt;/h1&gt;
&lt;h1 style=&quot;text-align:center&quot;&gt; &lt;/h1&gt;
&lt;h1 style=&quot;text-align:center&quot;&gt; &lt;/h1&gt;
&lt;h1 id=&quot;globalPageTitle&quot; style=&quot;text-align:center&quot;&gt;&lt;span id=&quot;fbJobReqTitle&quot; style=&quot;font-size:12.0pt&quot;&gt;Impiegato amministrativo contabile - Company Members Administration&lt;/span&gt;&lt;/h1&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;em&gt;&lt;strong&gt;&lt;span style=&quot;line-height:115%;font-family:Arial, sans-serif&quot;&gt;We don’t imagine a better future. We’re building it&lt;/span&gt;&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;em&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Arial, sans-serif&quot;&gt;Do Work That Matters - Il tuo ruolo e le tue responsabilità&lt;/span&gt;&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height:115%;font-family:Arial, sans-serif&quot;&gt;KPMG Business Services &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;line-height:115%;font-family:Arial, sans-serif&quot;&gt;offre servizi interni all’organizzazione, supportando tutte le linee di servizio e coadiuvando i professionisti nella gestione delle attività quotidiane.&lt;strong&gt; &lt;/strong&gt;In particolare, entrando a far parte del Team &lt;strong&gt;Finance Administration &lt;/strong&gt;come &lt;strong&gt;impiegato Amministrativo contabile (Company Members Administration) &lt;/strong&gt;di Milano, sarai responsabile di fornire i più alti standard di assistenza diretta e di supporto alla Leadership e ai componenti del Management Group. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Assistenza nella dichiarazione dei redditi (Mod. Unico Persone Fisiche);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Tenuta della regolare contabilità; &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Liquidazioni IVA;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Gestione adempimenti infra-annuali. &lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Arial, sans-serif&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Arial, sans-serif&quot;&gt;Come As you Are - Le tue competenze e caratteristiche&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:Arial, sans-serif&quot;&gt;Hai una laurea triennale o magistrale in ambito economico; &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:Arial, sans-serif&quot;&gt;Hai buona conoscenza della fiscalità delle Persone Fisiche titolari di Partita IVA;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:Arial, sans-serif&quot;&gt;Hai ottima capacità di utilizzo dei principali applicativi di Microsoft Office (in particolare funzioni avanzate di Excel);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:Arial, sans-serif&quot;&gt;Hai ottime capacità relazionali e comunicative;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:Arial, sans-serif&quot;&gt;Sei predisposto al teamwork e al problem solving;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:Arial, sans-serif&quot;&gt;Hai capacità analitiche e attenzione ai dettagli. &lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Arial, sans-serif&quot;&gt;Your Future With Us - Cosa troverai in KPMG&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività &lt;/strong&gt;e il &lt;strong&gt;lavoro di squadra;&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt;per promuovere un sano equilibrio tra vita lavorativa e personale;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt;e sviluppo avanzati per rimanere sempre aggiornati;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Mindset internazionale &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;line-height:115%;font-family:Arial, sans-serif&quot;&gt;e &lt;strong&gt;progettualità innovative;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height:115%;font-family:Arial, sans-serif&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Inquadramento ai sensi del CCNL Commercio al IV° livello; la retribuzione sarà definita e commisurata in relazione a criteri oggettivi quali competenze, esperienza effettiva maturata e aderenza ai requisiti richiesti per la posizione.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Arial, sans-serif&quot;&gt;Together for Better – I nostri valori e il nostro impegno&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network ha ottenuto le &lt;strong&gt;certificazioni ISO 30415&lt;/strong&gt;, che attesta la conformità del Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, che certifica la parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - bit.ly/OurImpactPlanKPMG - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;KPMG Business services S.r.l. garantisce le pari opportunità.&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif;text-align:center&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif;text-align:center&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;Accounting and Administrative Specialist - &lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Company Members Administration&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;We don’t imagine a better future. We’re building it.&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters – Your Role and Responsibilities&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and your colleagues address and solve today’s most important and complex challenges.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;KPMG Business Services provides internal services to the organization, supporting all service lines and assisting professionals in managing their day-to-day activities. As part of the &lt;strong&gt;Finance Administration Team&lt;/strong&gt; as an &lt;strong&gt;Accounting and Administrative Specialist (&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;line-height:115%;font-family:Arial, sans-serif&quot;&gt;Company Members Administration)&lt;/span&gt;&lt;/strong&gt; based in &lt;strong&gt;Milan&lt;/strong&gt;, you will be responsible for providing the highest standards of direct assistance and support to the Leadership team and members of the Management Group.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Specifically, you will be responsible for:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot;&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Assisting with personal income tax returns (Italian Tax Return Form – &lt;em&gt;Modello Unico Persone Fisiche&lt;/em&gt;);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Maintaining accurate accounting records and bookkeeping activities;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Managing VAT returns and settlements;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin:0.0cm 0.0cm 0.0cm 0.0px;text-align:justify;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Handling ongoing tax and administrative compliance requirements throughout the year.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;Come As You Are – Your Skills and Qualifications&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;This opportunity is ideal for you if you:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Hold a Bachelor&apos;s or Master&apos;s degree in Economics, Finance, Accounting, or a related field;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Have a good knowledge of tax regulations applicable to self-employed individuals (VAT-registered professionals);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Are highly proficient in Microsoft Office applications, particularly advanced Excel functions;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Possess excellent interpersonal and communication skills;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Enjoy working in a team and have strong problem-solving abilities;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Demonstrate strong analytical skills and attention to detail.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;Your Future With Us – What You’ll Find at KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;An inclusive and fair workplace that respects, encourages, and values diversity;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;A stimulating and dynamic environment that fosters creativity and teamwork;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;A hybrid working model designed to support a healthy work-life balance;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Advanced training and development programs to help you stay up to date and continue growing;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;An international mindset and exposure to innovative projects;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Initiatives focused on physical and mental well-being.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Standard employment contract under the collective labour agreement for the commerce sector, level IV°. The salary is determined on the basis of objective criteria, including the candidate’s skills, relevant experience and fulfilment of the requirements of the position.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;Together for Better – Our Values and Commitment&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, commitment to the community, and integrity: these are KPMG’s Values. They create an environment that encourages the exchange of ideas and knowledge, enabling our professionals to fully express their potential.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Through our commitment to fostering an inclusive workplace, our Network has achieved &lt;strong&gt;ISO 30415 certification&lt;/strong&gt;, recognizing compliance with Diversity and Inclusion Management Systems, and &lt;strong&gt;UNI/PdR 125 certification&lt;/strong&gt;, which acknowledges our commitment to gender equality.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; – bit.ly/OurImpactPlanKPMG – you can find a summary of the concrete actions we are taking across environmental, social, and governance (ESG) initiatives.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Your data will be processed in full compliance with Regulation (EU) No. 679/2016 (General Data Protection Regulation – &quot;GDPR&quot;) and its amendments. For more information, please consult KPMG’s privacy policy.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;KPMG Business Services S.r.l. is an equal opportunity employer.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height:115%;font-family:Aptos, sans-serif;font-weight:normal&quot;&gt;#LI-RR1&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Impiegato-amministrativo-contabile-Company-Members-Administration/1366270357/</link><guid isPermaLink="false">1366270357</guid><g:id>1366270357</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Finance</g:job_function><g:location>Milano, IT</g:location></item><item><title>Legal Compliance Consultant | Firenze (Firenze, IT)</title><description><![CDATA[&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters - Il tuo ruolo e le tue responsabilità&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. I professionisti dello &lt;strong&gt;Studio Associato &lt;/strong&gt;di KPMG intervengono in tutte le principali aree della fiscalità e del diritto societario offrendo servizi integrati e innovativi.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;In particolare, entrando a far parte del Team&lt;strong&gt; Legal &amp;amp; Compliance &lt;/strong&gt;di &lt;strong&gt;Firenze&lt;/strong&gt;, contribuirai a supportare i clienti nell&apos;affrontare le sfide legate alle principali aree del diritto societario. Opererai in uno scenario in continua evoluzione, dove normative nazionali e internazionali si intrecciano con le aspettative del mercato e dell’opinione pubblica su temi cruciali come l’etica, la trasparenza e la corporate governance.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul style=&quot;list-style-type:disc&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Assistenza in materia di compliance normativa per la redazione ed implementazione di Modelli di compliance normativa Antiriciclaggio, Diritto delle Società Quotate, Antitrust, Anticorruzione, D.lgs. n. 231/2001, Sicurezza sul lavoro, Ambientale, Rating di legalità e ESG.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Assistenza nel monitoraggio degli aggiornamenti normativi con particolare riferimento alle normative: Antiriciclaggio; Diritto delle Società Quotate, Responsabilità amministrativa degli enti ex d.lgs. n. 231/2001, Anticorruzione e Trasparenza; Antitrust, ed ESG.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Assistenza nella redazione di Regolamenti e Policy di Governance e di Global Policy nell’ambito di Gruppi Internazionali.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Conduzione di Audit e Verifiche su processi, procedure e protocolli di controllo in ambito D.lgs. n. 231/2001.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Assistenza nello svolgimento di compliance audit e verifiche su compliance programs (Privacy, Anticorruzione, Antiriciclaggio, Antitrust, Whistleblowing e Data Governance).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Assistenza nella definizione dei contenuti del sistema di controllo aziendale nell’ambito dei modelli di compliance normativa, quali: risk assessment; gap analisi; protocolli di controllo; procedure operative e policy aziendali; sistema disciplinare; sistema di flussi informativi.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Assistenza nello svolgimento di attività formative in ambito di compliance normativa.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Sarai coinvolta/o su &lt;strong&gt;progetti nazionali &lt;/strong&gt;e&lt;strong&gt; internazionali, &lt;/strong&gt;lavorando al fianco di professioniste e professionisti altamente qualificati e acquisendo competenze di primo livello attraverso il confronto con le menti più brillanti del settore.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Questa opportunità è perfetta per te se hai:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;list-style-type:disc&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Esperienza professionale di almeno 2 anni  presso primari studi nazionali o internazionali e/o società di consulenza; &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Laurea magistrale a ciclo unico in Giurisprudenza, preferibilmente con laurea su tematica attinente al diritto civile, societario ovvero alla compliance normativa, con votazione di laurea pari o superiore a 100/110;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Abilitazione all&apos;esercizio della professione forense;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Conoscenza del pacchetto Office (in particolare, degli applicativi Word, Excel e Powerpoint);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Conoscenza della lingua inglese, scritta e parlata. Un’esperienza di studio o lavoro all’estero sarà titolo di preferenza nella valutazione del CV;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Ottime capacità relazionali e di team working;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Flessibilità e dinamicità.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;list-style-type:disc&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;em&gt;bit.ly/OurImpactPlanKPMG&lt;/em&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;color:black&quot;&gt;&lt;strong&gt;&lt;em&gt;KPMG Studio Associato garantisce le pari opportunità.&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif;color:black&quot;&gt;#LI-CN1&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Firenze-Legal-Compliance-Consultant-Firenze/1365969557/</link><guid isPermaLink="false">1365969557</guid><g:id>1365969557</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Legal</g:job_function><g:location>Firenze, IT</g:location></item><item><title>Senior Consultant | Public Procurement Roma (Roma, IT)</title><description><![CDATA[&lt;p&gt;&lt;strong&gt;The chance to build a better future is right in front of you&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters – Il tuo ruolo e responsabilità&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. KPMG Advisory offre servizi di consulenza alle imprese per supportarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché nelle operazioni di finanza straordinaria&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Contribuisci alla digitalizzazione della Pubblica Amministrazione (PA)&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;KPMG collabora da sempre con le istituzioni pubbliche centrali e locali per supportarle nei processi di cambiamento e innovazione, generando un impatto concreto sulla vita di milioni di persone.&lt;/p&gt;
&lt;p&gt;Entrando a far parte del &lt;strong&gt;Team Government di KPMG Advisory&lt;/strong&gt;, avrai l&apos;opportunità di fare la differenza contribuendo in prima persona alla riprogettazione dei modelli di erogazione dei servizi pubblici del tuo Paese, sviluppando al contempo le tue competenze in un ambiente dinamico e altamente professionale.&lt;/p&gt;
&lt;p&gt;Farai parte di un team giovane e dinamico, supportando i clienti nelle seguenti attività:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Analisi e ottimizzazione dei &lt;strong&gt;processi di approvvigionamento&lt;/strong&gt; (procurement)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Progettazione e gestione delle procedure di gara&lt;/strong&gt; (definizione della strategia di acquisto, analisi dei fabbisogni, predisposizione della documentazione di gara)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Disegno organizzativo e reingegnerizzazione&lt;/strong&gt; dei processi di procurement&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Analisi funzionale e definizione dei requisiti&lt;/strong&gt; per i sistemi di gestione degli acquisti (procurement)&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Sei pronto/a ad aiutare a cambiare e migliorare il nostro Paese?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;In KPMG sarai coinvolto/a direttamente nei contesti in cui il cambiamento deve avvenire, lavorando a stretto contatto con funzionari e dirigenti della Pubblica Amministrazione italiana per rendere i servizi pubblici sempre più accessibili, efficienti e orientati ai cittadini.&lt;/p&gt;
&lt;p&gt;Entrerai a far parte di un gruppo di giovani colleghi e professionisti impegnati ogni giorno a promuovere e realizzare il cambiamento. Queste persone ti accompagneranno nel tuo percorso di crescita professionale, fungendo da punto di riferimento e mettendo a tua disposizione programmi di formazione continua.&lt;/p&gt;
&lt;p&gt;Per le nostre sedi di &lt;strong&gt;Roma&lt;/strong&gt;, siamo alla ricerca di professionisti determinati e responsabili, desiderosi di contribuire al cambiamento del sistema. Cerchiamo persone orientate al raggiungimento degli obiettivi, entusiaste, fortemente motivate e capaci di lavorare efficacemente in squadra.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - &lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;Le tue competenze e caratteristiche&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Sei la persona giusta per noi se hai:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Almeno &lt;strong&gt;2-3 anni di esperienza&lt;/strong&gt; in una società di consulenza e/o a supporto della Pubblica Amministrazione;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Una &lt;strong&gt;solida conoscenza del Codice dei Contratti Pubblici italiano&lt;/strong&gt;;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Comprovata capacità di &lt;strong&gt;analizzare, progettare e mappare i processi di procurement&lt;/strong&gt;;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Esperienza nella &lt;strong&gt;definizione di strategie di approvvigionamento&lt;/strong&gt; e nella predisposizione della documentazione di gara, inclusi analisi di mercato, strutturazione dei lotti, definizione dei requisiti di partecipazione e dei criteri di aggiudicazione;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Familiarità con le principali &lt;strong&gt;piattaforme di e-procurement&lt;/strong&gt; (ad esempio, AcquistinretePA di Consip);&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Spiccate capacità relazionali e comunicative, con attitudine a interagire efficacemente con clienti e team interni;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Approccio proattivo e solide capacità di problem solving.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Un ambiente di lavoro &lt;strong&gt;inclusivo ed equo&lt;/strong&gt;, che rispetta, promuove e valorizza la diversità;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Un contesto &lt;strong&gt;stimolante e dinamico&lt;/strong&gt;, che incoraggia la creatività e il lavoro di squadra;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Modalità di lavoro &lt;strong&gt;ibrida&lt;/strong&gt;, per favorire un sano equilibrio tra vita professionale e personale;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Programmi avanzati di &lt;strong&gt;formazione e sviluppo professionale&lt;/strong&gt;, per mantenere sempre aggiornate le proprie competenze;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Un contesto internazionale e la possibilità di partecipare a &lt;strong&gt;progetti innovativi&lt;/strong&gt;;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Iniziative dedicate al &lt;strong&gt;benessere mentale e fisico&lt;/strong&gt; delle persone.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 31.000 e € 41.000, determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione.&lt;/p&gt;
&lt;p&gt;In ottemperanza alla normativa vigente, &lt;strong&gt;non raccogliamo né utilizziamo informazioni sulle retribuzioni &lt;/strong&gt;percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Leadership, lavoro in team, rispetto delle individualità, apprendimento continuo, trasparenza, impegno verso la comunità e integrità: questi sono i valori di KPMG che danno vita a un ambiente aperto allo scambio di idee e alla crescita personale e professionale.&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere.”&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;The chance to build a better future is right in front of you&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters - Your Role and Responsibilities.&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Do you want to do work that is truly meaningful and impactful? At KPMG you will have the opportunity to help clients, the company, and colleagues address and solve the most current and complex challenges.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Help digitalize the public administration (PA)&lt;/strong&gt; &lt;/p&gt;
&lt;p&gt;KPMG has always collaborated with central and local public institutions to support them in &lt;strong&gt;driving change and innovation processes&lt;/strong&gt;, creating a tangible impact on the lives of millions of people.&lt;/p&gt;
&lt;p&gt;As a member of KPMG’s Government team, you will have the opportunity to &lt;strong&gt;make a difference&lt;/strong&gt; by personally contributing to the redesign of your country’s public service delivery models, while rapidly developing your skills in a dynamic and highly professional environment.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;You will be part of a young and dynamic team, supporting clients in the following activities:&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Analysis and optimization of procurement processes&lt;/li&gt;
&lt;li&gt;Design and management of tender procedures (definition of procurement strategy, needs analysis, preparation of tender documentation)&lt;/li&gt;
&lt;li&gt;Organizational design and re-engineering of procurement processes&lt;/li&gt;
&lt;li&gt;Functional analysis and definition of requirements for procurement management systems&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Are you ready to help change and improve our country?&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;At KPMG you will be directly involved where change must happen, working closely with the officials and managers of the Italian PA to make public services increasingly user friendly.&lt;/p&gt;
&lt;p&gt;You will join a group of young colleagues and professionals dedicated to creating and generating the change every day. These colleagues will guide you as you grow and act as a touchstone, in addition to sharing ongoing training programs.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;For our offices in Rome, we are seeking driven and accountable professionals who are eager to change the system. They must be goal-oriented, enthusiastic and highly motivated team players.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Your Skills and Characteristics&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;This successful candidate has:&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;At least 2-3 years of experience in a consulting firm and/or supporting the PA;&lt;/li&gt;
&lt;li&gt;Strong knowledge of the Italian Public Contracts Code&lt;/li&gt;
&lt;li&gt;Proven ability to analyze, design, and map procurement processes&lt;/li&gt;
&lt;li&gt;Experience in defining procurement strategies and preparing tender documentation, including market analysis, lot structuring, participation requirements, and award criteria&lt;/li&gt;
&lt;li&gt;Familiarity with major e-procurement platforms (e.g., Consip’s Acquistinretepa)&lt;/li&gt;
&lt;li&gt;Excellent command of MS Office tools (Word, Excel, PowerPoint)&lt;/li&gt;
&lt;li&gt;Strong interpersonal and communication skills, with the ability to effectively engage with clients and internal teams&lt;/li&gt;
&lt;li&gt;Proactive mindset with strong problem-solving skills&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - What you&apos;ll find at KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;An inclusive, equitable work environment that respects, encourages and values diversity&lt;/li&gt;
&lt;li&gt;A challenging and dynamic environment that encourages creativity and teamwork&lt;/li&gt;
&lt;li&gt;Hybrid work arrangements to promote a healthy work-life balance&lt;/li&gt;
&lt;li&gt;Advanced training and development programs to stay current&lt;/li&gt;
&lt;li&gt;International mindset and innovative projects&lt;/li&gt;
&lt;li&gt;Initiatives focused on mental and physical well-being&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from € 31.000 to € 41.000. The salary is determined on the basis of objective criteria, including the candidate’s skills and experience assessed against the requirements of the role. &lt;/p&gt;
&lt;p&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Together for Better - Our Values and Commitment&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Leadership, teamwork, respect for each individuality, continuous deepening, transparency, commitment to the community, integrity: these are KPMG&apos;s Values that give rise to an environment open to the exchange of ideas and knowledge, which allows our professionals to express their full potential.&lt;/p&gt;
&lt;p&gt;As a result of our commitment to fostering an inclusive work environment, our Network has obtained ISO 30415 certification, which certifies compliance of the Diversity and Inclusion Management System, and UNI PdR 125, which certifies gender equality. Within our Impact Plan - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarized all the concrete actions we are taking on environmental, social and governance (ESG) issues.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Join us!&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) No. 679/2016 (General Data Protection Regulation - “GDPR”) as amended. For more information, please see KPMG&apos;s privacy policy.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;KPMG Advisory S.p.A. guarantees equal opportunities.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;#LI-SB1&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Roma-Senior-Consultant-Public-Procurement-Roma/1365631357/</link><guid isPermaLink="false">1365631357</guid><g:id>1365631357</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Roma, IT</g:location></item><item><title>Senior Consultant - ServiceNow (Roma, IT)</title><description><![CDATA[&lt;p class=&quot;MsoNoSpacing&quot; style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;

&lt;p class=&quot;MsoNoSpacing&quot; style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Do Work That Matters - Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Vuoi fare un lavoro che abbia un impatto concreto sulle organizzazioni? In KPMG avrai l’opportunità di affiancare aziende di diversi settori nei loro percorsi di trasformazione digitale, contribuendo alla progettazione e implementazione di soluzioni che migliorano il funzionamento dei processi aziendali.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;KPMG Advisory supporta le imprese nell’evoluzione dei propri modelli operativi attraverso l’ottimizzazione dei processi, l’adozione di piattaforme digitali e l’introduzione di soluzioni tecnologiche in grado di rendere le attività più efficienti, integrate e tracciabili.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Entrando a far parte dell&apos;area Enterprise Platform nel team&lt;strong&gt; ServiceNow&lt;/strong&gt;, contribuirai alla progettazione e realizzazione di soluzioni basate sulla piattaforma ServiceNow, utilizzata dalle organizzazioni per gestire e digitalizzare processi operativi e di servizio, come IT Service Management, gestione delle richieste interne e workflow tra diverse funzioni aziendali.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Analizzare i &lt;strong&gt;processi&lt;/strong&gt; e i&lt;strong&gt; requisiti di business&lt;/strong&gt; del cliente, collaborando con stakeholder di diverse funzioni aziendali per identificare opportunità di &lt;strong&gt;digitalizzazione&lt;/strong&gt; e &lt;strong&gt;miglioramento dei flussi operativi&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Supportare la &lt;strong&gt;progettazione della soluzione applicativa&lt;/strong&gt; su piattaforma ServiceNow, contribuendo alla definizione del design funzionale e alla configurazione dei moduli più adatti alle esigenze del cliente.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Configurare&lt;/strong&gt; e &lt;strong&gt;personalizzare&lt;/strong&gt; i moduli ServiceNow (in particolare ambiti ITSM, ITOM e/o CSM), traducendo i requisiti di business in workflow e funzionalità implementate sulla piattaforma.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Contribuire alla definizione e alla produzione della &lt;strong&gt;documentazione progettuale&lt;/strong&gt; (analisi funzionali, specifiche di configurazione, documentazione di processo).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Partecipare alle &lt;strong&gt;attività di testing &lt;/strong&gt;della soluzione (SIT e UAT), collaborando con gli utenti del cliente per verificare la corretta implementazione dei requisiti e garantire la qualità delle soluzioni rilasciate.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Supportare le fasi di rilascio e &lt;strong&gt;go-live&lt;/strong&gt; della soluzione, affiancando il cliente durante il periodo di hypercare e contribuendo alla risoluzione delle eventuali &lt;strong&gt;criticità operative&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Nel corso delle attività potrai essere coinvolta/o in progetti &lt;strong&gt;nazionali&lt;/strong&gt; e &lt;strong&gt;internazionali&lt;/strong&gt;, lavorando con team multidisciplinari e clienti appartenenti a diversi settori industriali.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai maturato&lt;strong&gt; esperienza su progetti di implementazione ServiceNow&lt;/strong&gt;, idealmente su moduli come &lt;strong&gt;ITSM, ITOM o CSM&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai esperienza nella &lt;strong&gt;raccolta e analisi dei requisiti funzionali&lt;/strong&gt; e nella configurazione di soluzioni applicative su piattaforma ServiceNow.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai familiarità con la progettazione e gestione di &lt;strong&gt;workflow digitali e processi di service management&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai partecipato a progetti di implementazione o evoluzione di piattaforme enterprise in contesti consulenziali o IT.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Possiedi una buona conoscenza della lingua inglese, necessaria per lavorare in contesti progettuali internazionali.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Sei disponibile a trasferte nazionali e internazionali, in linea con le esigenze dei progetti.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Your Future With Us - Cosa troverai in KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;text-align:justify&quot;&gt;
&lt;li style=&quot;text-align:justify;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 31.000 e € 41.000 per la qualifica di Senior Consultant e tra € 38.000 e € 51.000 per la qualifica di Assistant Manager, determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione. &lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Together for Better – I nostri valori e il nostro impegno&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a style=&quot;text-decoration:underline&quot; href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;The chance to build a better future is right in front of you&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Do Work That Matters - Your Role and Responsibilities&lt;/strong&gt;&lt;br&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and colleagues tackle and solve the most current and complex challenges. KPMG Advisory provides consulting services to businesses, assisting them in transforming their business models, improving and digitizing processes, analyzing and managing risks, and supporting extraordinary financial operations.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;By joining the &lt;strong&gt;Enterprise Platform Team&lt;/strong&gt;, you will be involved in managing organizational change processes. Together with experienced colleagues, you will analyze strategic requirements to implement the best digital solutions available on the market for integrated process management.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Specifically, your responsibilities will include:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;text-align:justify&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Analyzing business requirements, collaborating with various corporate areas to identify needs in ITSM, ITOM, and other ServiceNow applications.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Designing optimal solutions using the ServiceNow platform, configuring and customizing it to meet the specific needs of the client.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Drafting detailed documentation, including functional and technical analyses, for end-to-end processes related to business and IT workflows.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Configuring ServiceNow modules, ensuring that the solution is tailored to the client’s needs and objectives.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Conducting internal tests and collaborating with end users to ensure that the solutions meet KPMG’s and the client’s quality standards.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Delivering training sessions for business users, supporting them in correctly adopting the implemented solutions.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Providing support to clients during the go-live phase and Hypercare period, ensuring a smooth transition and consolidation of new functionalities.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;You will work on both national and international projects, collaborating with highly qualified professionals and working closely with clients from various industries, delivering tailored solutions to meet their specific business needs.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Come As You Are - Your Skills and Characteristics&lt;/strong&gt;&lt;br&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;text-align:justify&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;You have &lt;strong&gt;experience implementing ServiceNow solutions&lt;/strong&gt;, with a specific focus on modules such as ITSM, ITOM, and/or CSM.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;You have solid experience in managing &lt;strong&gt;complex business processes&lt;/strong&gt;, focusing on their optimization and digitization through workflow automation.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;You have a &lt;strong&gt;good command of the English language&lt;/strong&gt;, preferably with study and/or work experiences abroad.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;You are available to &lt;strong&gt;travel nationally and internationally&lt;/strong&gt; to support clients at all project stages.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Your Future With Us - What You’ll Find at KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;text-align:justify&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;An inclusive, fair work environment that respects, encourages, and values diversity.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;A stimulating and dynamic setting that fosters creativity and teamwork.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;A hybrid working model to promote a healthy work-life balance.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Advanced training and development programs to keep your skills up-to-date.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;An international mindset and innovative projects.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Initiatives focused on physical and mental well-being.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;color:black&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €31,000 to €41,000 for the Senior Consultant position and from €38,000 to €51,000 for the Assistant Manager position. The salary is determined on the basis of objective criteria, including the candidate&apos;s skills and experience assessed against the requirements of the role.&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:black&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria.&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;strong&gt;Together for Better - Our Values and Commitment&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, commitment to the community, and integrity: these are the values of KPMG that create an environment open to the exchange of ideas and knowledge, allowing our professionals to fully express their potential.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Our &lt;strong&gt;Impact Plan&lt;/strong&gt; outlines the concrete actions we are taking on environmental, social, and governance (ESG) topics. Learn more here: &lt;a href=&quot;https://kpmg.com&quot; target=&quot;_new&quot; rel=&quot;noopener&quot;&gt;Our Impact Plan&lt;/a&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Join us!&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) No. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) and subsequent amendments. For more information, please see KPMG’s privacy policy.&lt;br&gt;KPMG Advisory S.p.A. ensures equal opportunities.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;#LI-MM2&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Roma-Senior-Consultant-ServiceNow/1365756057/</link><guid isPermaLink="false">1365756057</guid><g:id>1365756057</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Roma, IT</g:location></item><item><title>Software Engineer AI &amp; Data Architecture (Roma, IT)</title><description><![CDATA[&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;We don’t imagine a better future. We’re building it!&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;span style=&quot;font-weight:bold&quot;&gt;KPMG Advisory &lt;/span&gt;offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Nel particolare, entrerai a far parte del &lt;span style=&quot;font-weight:bold&quot;&gt;Team di Lighthouse&lt;/span&gt; di &lt;span style=&quot;font-weight:bold&quot;&gt;Roma.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;La &lt;span style=&quot;font-weight:bold&quot;&gt;Lighthouse&lt;/span&gt; è il centro di eccellenza di &lt;span style=&quot;font-weight:bold&quot;&gt;KPMG Advisory&lt;/span&gt; che offre soluzioni di &lt;span style=&quot;font-weight:bold&quot;&gt;Data &amp;amp; Analytics&lt;/span&gt; sul mercato.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Sarai impegnato nel fornire soluzioni tecnologiche all&apos;avanguardia, tra cui algoritmi la business intelligence, la visualizzazione dei dati, l&apos;analisi avanzata, il process mining e le tecnologie di machine learning per migliorare il processo decisionale umano.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Nello specifico, lavorerai su tecnologie innovative e su progetti sfidanti e entusiasmanti, supportando i nostri clienti principalmente sulle seguenti tematiche:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0in;margin-bottom:0.0in&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;supervisione della progettazione e manutenzione di architetture a microservizi scalabili (API RESTful, SQL/NoSQL);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;governance delle architetture dati a supporto della BI e dei flussi di reportistica;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;gestione strategica di ecosistemi Cloud-native (AWS/Azure) garantendo resilienza e ottimizzazione dei costi;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;supporto decisionale ai team sulla scelta dello stack tecnologico (performance vs sostenibilità);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;monitoraggio KPI, budget, deadline e coordinamento metodologie Agile;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;collaborazione con stakeholder per la definizione delle roadmap e dei requisiti di business.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Calibri;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0in;margin-bottom:0.0in&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Possiedi una laurea magistrale (o triennale) in discipline STEM, ingegneria informatica, IT o un&apos;altra disciplina pertinente;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Hai maturato almeno 5 anni di esperienza di lavoro nella &lt;/span&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;gestione di progetti complessi e team tecnici;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:11.0pt&quot;&gt;conoscenza AI Architecture e microservice architecture  &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai una solida conoscenza di Docker, Kubernetes e architetture Cloud (Snowflake, BigQuery) e strumenti BI (Power BI, Tableau);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai padronanza dei paradigmi di sviluppo (Java/Spring Boot, Python);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai una buona padronanza della lingua inglese, preferibilmente con esperienze di studio e/o lavoro all&apos;estero.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Calibri;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;Your Future With Us - Cosa troverai in KPMG&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0in;margin-bottom:0.0in&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un ambiente di lavoro inclusivo, equo e che rispetta, incoraggia e valorizza le diversità;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un contesto stimolante e dinamico che incentiva la creatività e il lavoro di squadra;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Modalità di lavoro ibrida, per promuovere un sano equilibrio tra vita lavorativa e personale;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Programmi di formazione e sviluppo avanzati per rimanere sempre aggiornati;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Mindset internazionale e progettualità innovative;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Iniziative incentrate sul benessere psicofisico.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;padding-left:40.0px&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 38.000 e € 51.000, determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;padding-left:40.0px&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.75in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Calibri;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;Together for Better – I nostri valori e il nostro impegno&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;span style=&quot;font-weight:bold&quot;&gt;Valori di KPMG&lt;/span&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;span style=&quot;font-weight:bold&quot;&gt;esprimere tutto il loro potenziale.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Grazie all’impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network risulta conforme agli standard dei requisiti ISO 30415, sul Sistema di Gestione per la Diversità e l’Inclusione, e UNI PdR 125, relativa alla parità di genere. All’interno del nostro &lt;span style=&quot;font-weight:bold&quot;&gt;Impact Plan&lt;/span&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le azioni concrete che stiamo portando avanti su tematiche ambientali, sociali e di governance (ESG). &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold;font-family:arial, helvetica, sans-serif&quot;&gt;Unisciti a noi!&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the company and colleagues address and solve the most current and complex challenges. KPMG Advisory offers consulting services to companies to assist them in business model transformation, process improvement and digitisation, risk analysis and management, and support in extraordinary finance transactions. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Specifically, you will join our &lt;span style=&quot;font-weight:bold&quot;&gt;Lighthouse team&lt;/span&gt; in &lt;span style=&quot;font-weight:bold&quot;&gt;Roma.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Lighthouse&lt;/span&gt; is the &lt;span style=&quot;font-weight:bold&quot;&gt;KPMG Advisory&lt;/span&gt; centre of excellence delivering an array of &lt;span style=&quot;font-weight:bold&quot;&gt;data &amp;amp; analytics&lt;/span&gt; solutions.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;You will be tasked with providing cutting-edge technology solutions, including algorithms, business intelligence, data visualisation, advanced analytics, process mining and machine learning technologies to improve human decision making.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0in;margin-left:0.375in;font-family:Calibri;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Specifically, you will work on innovative technologies and on challenging and exciting projects, supporting our clients mainly in the following areas:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0in;margin-left:0.375in;font-family:Calibri;font-size:11.0pt&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0in;margin-bottom:0.0in&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;supervision of the design and maintenance of scalable microservices architectures (RESTful APIs, SQL/NoSQL);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;governance of data architectures supporting BI and reporting flows;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;strategic management of Cloud-native ecosystems (AWS/Azure), ensuring resilience and cost optimization;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;decision-making support for teams in choosing the technology stack (performance vs sustainability);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;monitoring of KPIs, budget, deadlines, and coordination of Agile methodologies;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;collaboration with stakeholders to define roadmaps and business requirements.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Calibri;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;Come As You Are - Your skills and characteristics&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0in;margin-bottom:0.0in&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;This is the perfect opportunity for you if you:&lt;/span&gt;&lt;/li&gt;
&lt;ul style=&quot;margin-top:0.0in;margin-bottom:0.0in&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You hold a master’s (or bachelor’s) degree in STEM disciplines, computer engineering, IT, or another relevant field&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have at least 5 years of work experience managing complex projects and technical teams;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have a solid knowledge of Docker, Kubernetes, and Cloud architectures (Snowflake, BigQuery), as well as BI tools (Power BI, Tableau);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You are proficient in development paradigms (Java/Spring Boot, Python);&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt; You have a good command of the English language, preferably with study and/or work experience abroad.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0in;margin-left:0.75in;font-family:Calibri;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;Your Future With Us - What you’ll find at KPMG&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0in;margin-bottom:0.0in&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;An &lt;/span&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;inclusive&lt;/span&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt; and equitable &lt;/span&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;work environment&lt;/span&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt; that respects, encourages and values &lt;/span&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;diversity.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;A challenging and dynamic environment that encourages&lt;/span&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt; creativity&lt;/span&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt; and &lt;/span&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;teamwork.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;Hybrid&lt;/span&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt; work arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Advanced &lt;/span&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;training&lt;/span&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt; and development programmes to stay current.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;International mindset&lt;/span&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt; and &lt;/span&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;innovative projects.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0pt;margin-bottom:8.0pt;vertical-align:middle;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Initiatives focused on &lt;/span&gt;&lt;span style=&quot;font-weight:bold;font-size:12.0pt&quot;&gt;mental and physical well-being.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €38,000 to €51,000. The salary is determined on the basis of objective criteria, including the candidate’s skills and experience assessed against the requirements of the role. &lt;/p&gt;
&lt;p&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Calibri;font-size:11.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;Together for Better – Our values and commitment&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;span style=&quot;font-weight:bold&quot;&gt;KPMG&lt;/span&gt; &lt;span style=&quot;font-weight:bold&quot;&gt;values &lt;/span&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;span style=&quot;font-weight:bold&quot;&gt;achieve their full potential&lt;/span&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;As a result of our commitment to fostering an inclusive work environment, our Network complies with the standards of the ISO 30415 requirements, on the Diversity and Inclusion Management System, and UNI PdR 125, relating to gender equality. Within our &lt;span style=&quot;font-weight:bold&quot;&gt;Impact Plan&lt;/span&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarised all the &lt;span style=&quot;font-weight:bold&quot;&gt;concrete actions&lt;/span&gt; we are taking on environmental, social and governance (ESG) issues.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-weight:bold;font-family:arial, helvetica, sans-serif&quot;&gt;Join us!&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG’s privacy policy.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-style:italic;font-family:arial, helvetica, sans-serif&quot;&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:12.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin-left:0.375in;margin-top:0.0pt;margin-bottom:8.0pt;font-family:Aptos;font-size:8.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif&quot;&gt;#LI-DM1&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Roma-Software-Engineer-AI-&amp;-Data-Architecture/1365716257/</link><guid isPermaLink="false">1365716257</guid><g:id>1365716257</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Roma, IT</g:location></item><item><title>Junior Consultant - Public Sector - PMO &amp; Digital Transformation (Roma, IT)</title><description><![CDATA[&lt;p&gt;&lt;strong&gt;Junior Consultant - Public Sector - PMO &amp;amp; Digital Transformation &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;Do Work That Matters &lt;/em&gt;&lt;strong&gt;- Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. KPMG Advisory offre servizi di consulenza alle imprese e agli enti pubblici per affiancarli nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/p&gt;
&lt;p&gt;In particolare, entrando a far parte del Team &lt;strong&gt;Governance, Risk &amp;amp; Compliance di Roma&lt;/strong&gt; verrete inseriti in progettualità di &lt;strong&gt;trasformazione digitale&lt;/strong&gt; a livello nazionale e internazionale, per i principali attori del settore pubblico.&lt;/p&gt;
&lt;p&gt; &lt;strong&gt;Nello specifico supporterai il team nelle attività di:&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;&lt;strong&gt;Project Management&lt;/strong&gt;: sarai parte attiva nel governo di progetti di trasformazione digitale, contribuirai a monitorare l’avanzamento delle iniziative, tracciare rischi, milestone e a mantenere ingaggiati tutti gli attori coinvolti nelle iniziative dai team tecnici al cliente;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;&lt;strong&gt;Functional Analysis &amp;amp; Solution Design&lt;/strong&gt;: ti confronterai con processi organizzativi e sistemi informativi, supportando l’analisi funzionale e la progettazione di strumenti e soluzioni digitali che rispondano alle esigenze del cliente;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Data Analysis &amp;amp; Reporting&lt;/strong&gt;: darai voce ai dati, trasformandoli in insight, KPI e dashboard che raccontano l’andamento dei progetti e supportano le decisioni del team e del cliente;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Change Management &amp;amp; Capacity Building&lt;/strong&gt;: contribuirai all’analisi dei fabbisogni di competenze e alla valutazione della readiness organizzativa, supportando i processi di cambiamento legati all’adozione di nuove soluzioni digitali.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Entrerai a far parte di un team giovane e dinamico, lavorando su progetti di trasformazione digitale che uniscono rigore metodologico e spirito di innovazione. Avrai l’opportunità di contribuire concretamente a soluzioni e modelli operativi che migliorano la produttività, l’efficienza e la qualità dei servizi offerti dai nostri clienti.&lt;/p&gt;
&lt;p&gt; &lt;em&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Questa opportunità è perfetta per te se hai:&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Laurea magistrale in discipline economiche, Management, Scienze Politiche o affini;&lt;/li&gt;
&lt;li&gt;Interesse per il settore pubblico;&lt;/li&gt;
&lt;li&gt;Ottima padronanza della lingua inglese (B2 o superiore);&lt;/li&gt;
&lt;li&gt;Competenze analitiche, quantitative e di problem-solving;&lt;/li&gt;
&lt;li&gt;Pensiero critico e creativo;&lt;/li&gt;
&lt;li&gt;Curiosità e predisposizione all&apos;apprendimento e all’aggiornamento continuo;&lt;/li&gt;
&lt;li&gt;Flessibilità e apertura alla collaborazione in un ambiente dinamico;&lt;/li&gt;
&lt;li&gt;Interesse per il project management e attitudine all’organizzazione e alla gestione di attività strutturate;&lt;/li&gt;
&lt;li&gt;Sensibilità verso temi di responsabilità sociale e l&apos;ambizione di generare un impatto concreto per i clienti e la società.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;I seguenti requisiti saranno considerati un plus:&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Conoscenza della pubblica amministrazione o di enti pubblici e semi-pubblici, sia a livello centrale che locale, e/o delle istituzioni pubbliche europee e internazionali;&lt;/li&gt;
&lt;li&gt;Esperienza pregressa nel settore della consulenza o in ambito pubblico.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Un ambiente di lavoro inclusivo, equo e che rispetta, incoraggia e valorizza le diversità&lt;/li&gt;
&lt;li&gt;Un contesto stimolante e dinamico che incentiva la creatività e il lavoro di squadra&lt;/li&gt;
&lt;li&gt;Modalità di lavoro ibrida, per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/li&gt;
&lt;li&gt;Programmi di formazione e sviluppo avanzati per rimanere sempre aggiornati&lt;/li&gt;
&lt;li&gt;Mindset internazionale e progettualità innovative&lt;/li&gt;
&lt;li&gt;Iniziative incentrate sul benessere psicofisico&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;L’opportunità prevede un inserimento in stage con indennità mensile di 800€ / L’opportunità prevede un inserimento in stage con indennità mensile di 800€ per stage curriculare o 1.000€ per stage extracurriculare o in assunzione con inquadramento ai sensi del CCNL Commercio e RAL di ingresso: € 29.000, determinata sulla base di criteri oggettivi quali il titolo di studio e la valutazione del profilo rispetto ai requisiti della posizione.&lt;/div&gt;
&lt;p&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i Valori di KPMG che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di esprimere tutto il loro potenziale.&lt;/p&gt;
&lt;p&gt;Grazie all’impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network ha ottenuto le certificazioni ISO 30415, che attesta la conformità del Sistema di Gestione per la Diversità e l’Inclusione, e UNI PdR 125, che certifica la parità di genere. All’interno del nostro Impact Plan - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le azioni concrete che stiamo portando avanti su tematiche ambientali, sociali e di governance (ESG).  &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Junior Consultant - Public Sector - PMO &amp;amp; Digital Transformation &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;Do Work That Matters &lt;/em&gt;&lt;strong&gt;– Your role and responsibilities&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Do you want to make a meaningful impact through your work? At KPMG, you’ll have the opportunity to support clients, society, and your colleagues in addressing and solving the most current and complex challenges. KPMG Advisory provides consulting services to businesses and public entities to support them in transforming their business models, improving and digitalizing processes, analysing and managing risks, as well as assisting in extraordinary finance operations.&lt;/p&gt;
&lt;p&gt;By joining the &lt;strong&gt;Governance, Risk &amp;amp; Compliance&lt;/strong&gt; Team in Rome, you will be part of &lt;strong&gt;digital transformation&lt;/strong&gt; projects at both national and international levels for leading public sector clients.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Specifically, you will support the team in the following activities:&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;&lt;strong&gt;Project Management&lt;/strong&gt;: you will play an active role in governing digital transformation projects, helping to monitor progress, track risks and milestones, and keep all stakeholders aligned, from technical teams to the client;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Functional Analysis &amp;amp; Solution Design&lt;/strong&gt;: you will engage with organisational processes and information systems, supporting functional analysis and the design of digital tools and solutions that meet client needs;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Data Analysis &amp;amp; Reporting&lt;/strong&gt;: you will give data a voice, turning it into insights, KPIs, and dashboards that tell the story of project progress and support decision-making for the team and the client;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Change Management &amp;amp; Capacity Building&lt;/strong&gt;: you will contribute to analysing skills gaps and assessing organisational readiness, supporting change processes linked to the adoption of new digital solutions.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;You will join a young and dynamic team, working on digital transformation projects that combine methodological rigour with a spirit of innovation. You will have the opportunity to make a real contribution to solutions and operating models that improve the productivity, efficiency, and quality of the services we provide to our clients.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;em&gt;Come As You Are – Your competences and  characteristics&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;This opportunity is perfect for you if you have:&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;A master’s degree in Economics, Management, Political Science, or a related field&lt;/li&gt;
&lt;li&gt;Strong interest in the public sector&lt;/li&gt;
&lt;li&gt;Excellent command of the English language (B2 or higher)&lt;/li&gt;
&lt;li&gt;Analytical, quantitative, and problem-solving skills&lt;/li&gt;
&lt;li&gt;Critical and creative thinking&lt;/li&gt;
&lt;li&gt;Curiosity and a strong inclination for continuous learning and improvement&lt;/li&gt;
&lt;li&gt;Flexibility and openness to collaboration in a dynamic environment&lt;/li&gt;
&lt;li&gt;Interest in project management and an aptitude for organising and managing structured activities&lt;/li&gt;
&lt;li&gt;Sensitivity to social responsibility issues and a drive to make a tangible impact for clients and society&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;The following qualifications will be considered a plus:&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Knowledge of public administration or public and semi-public entities, both at central and local levels, and/or European and international public institutions&lt;/li&gt;
&lt;li&gt;Previous experience in consulting or in the public sector.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Your Future With Us – What You’ll Find at KPMG&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;An inclusive and equitable work environment that respects, encourages, and values diversity&lt;/li&gt;
&lt;li&gt;A stimulating and dynamic setting that fosters creativity and teamwork&lt;/li&gt;
&lt;li&gt;A hybrid work model to promote a healthy work-life balance&lt;/li&gt;
&lt;li&gt;Advanced training and development programs to keep you up to date&lt;/li&gt;
&lt;li&gt;An international mindset and innovative projects&lt;/li&gt;
&lt;li&gt;Initiatives focused on physical and mental well-being.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;div&gt;ENG: This opportunity is offered as either a paid internship with a monthly allowance of €800 / This opportunity is offered as either a paid internship offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships or a standard employment contract under the collective labour agreement for the commerce sector, with a starting gross annual salary of €29,000. The salary is determined on the basis of objective criteria, including educational qualifications and an assessment of the candidate’s profile against the requirements of the role.&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria.&lt;/div&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;em&gt;Together for Better – Our Values and Commitment&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;Leadership, teamwork, respect for individuality, continuous learning, transparency, commitment to the community, integrity: these are KPMG’s Values, creating an environment open to the exchange of ideas and knowledge, enabling our professionals to realize their full potential.&lt;/p&gt;
&lt;p&gt;Thanks to our commitment to fostering an inclusive work environment, our Network has achieved ISO 30415 certification, which confirms the compliance of our Diversity and Inclusion Management System, and UNI PdR 125 certification, which certifies gender equality. Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; – you’ll find a summary of all the concrete actions we are undertaking on environmental, social, and governance (ESG) topics.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Join Us!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) No. 679/2016 (General Data Protection Regulation – &quot;GDPR&quot;) and subsequent amendments. For more information, please refer to KPMG&apos;s privacy policy.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;br&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;#LI-VE1&lt;/p&gt;
&lt;p&gt;#LI-HYBRID&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Roma-Junior-Consultant-Public-Sector-PMO-&amp;-Digital-Transformation/1366381757/</link><guid isPermaLink="false">1366381757</guid><g:id>1366381757</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Roma, IT</g:location></item><item><title>Candidatura spontanea | Categorie Protette (Milano, IT)</title><description><![CDATA[&lt;p&gt;&lt;span style=&quot;font-size:14.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;We &lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;don’t imagine a better future. We’re building it&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Do Work That Matters - Il tuo ruolo e le tue responsabilità&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In &lt;strong&gt;KPMG&lt;/strong&gt; avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;br&gt;In base ai tuoi interessi e le nostre esigenze di mercato, sarai collocato/a in una delle seguenti entità legali: &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Advisory&lt;/strong&gt; offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;font-size:10.0pt;color:black&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Fides Servizi di Amministrazione&lt;/strong&gt; fornisce servizi professionali nella gestione dei processi amministrativi, contabili e fiscali, giocando un ruolo fondamentale nel ridisegno dei modelli di reporting e nell’armonizzazione dei processi contabili gestionali;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;font-size:10.0pt;color:black&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Audit &amp;amp; Assurance&lt;/strong&gt; offre un portafoglio di servizi integrato in costante evoluzione, con insight che consentono alle aziende di rispondere ai fabbisogni informativi del mercato e degli investitori;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;font-size:10.0pt;color:black&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Nolan Norton,&lt;/strong&gt; società di IT Strategy del Network KPMG, aiuta le organizzazioni ad affrontare le sfide di trasformazione digitale e ad implementare architetture IT;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;font-size:10.0pt;color:black&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Open Platform&lt;/strong&gt; si occupa della digitalizzazione dei processi della Pubblica Amministrazione;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;font-size:10.0pt;color:black&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Business Services &lt;/strong&gt;offre servizi interni all’organizzazione, supportando tutte le linee di servizio e coadiuvando i professionisti nella gestione delle attività quotidiane. &lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;color:black;font-size:10.0pt&quot;&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;In particolare, entrando a far parte di uno dei Team sopracitati presso&lt;strong&gt; le nostre sedi italiane&lt;/strong&gt;, sarai responsabile di fornire i più alti standard di assistenza diretta e di supporto alla Leadership e ai componenti del Management Group. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Come As Are - Le tue competenze e caratteristiche&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Hai una laurea di primo o secondo livello in discipline economiche, giuridiche, ingegneristiche e/o umanistiche.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Hai buona conoscenza della lingua inglese.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Hai buona conoscenza del pacchetto Office.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Sei iscritto alle liste Categorie Protette Art.1 / 18 l. 68/99&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;br&gt; &lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Your Future With Us - Cosa troverai in KPMG&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Un ambiente di lavoro inclusivo, equo e che rispetta, incoraggia e valorizza le diversità - Il nostro ambiente di lavoro è progettato per essere inclusivo e accessibile a tutti. Siamo orgogliosi di offrire una struttura priva di barriere architettoniche, per garantire che tutte le persone, indipendentemente dalle loro abilità fisiche, possano lavorare in un ambiente confortevole e sicuro. Le caratteristiche del nostro ufficio includono:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Rampe di accesso&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Ascensori accessibili&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Bagni accessibili&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Postazioni di lavoro ergonomiche&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Ci impegniamo inoltre a fornire un ambiente di lavoro inclusivo e ad accogliere richieste specifiche di adattamento per soddisfare le esigenze individuali dei nostri dipendenti.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Un contesto stimolante e dinamico che incentiva la creatività e il lavoro di squadra;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Modalità di lavoro ibrida,per promuovere un sano equilibrio tra vita lavorativa e personale;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Programmi di formazionee sviluppo avanzati per rimanere sempre aggiornati;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Mindset internazionale e progettualità innovative;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Iniziative incentrate sul benessere psicofisico.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;em&gt;Inquadramento ai sensi del CCNL Commercio al IV, III o al II livello ; la retribuzione sarà definita e commisurata in relazione a criteri oggettivi quali competenze, esperienza effettiva maturata e aderenza ai requisiti richiesti per la posizione.&lt;/em&gt;&lt;em&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/em&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Together for Better – I nostri valori e il nostro impegno&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i Valori di KPMG che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di esprimere tutto il loro potenziale.&lt;br&gt;&lt;span style=&quot;font-family:Arial, sans-serif&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere.&lt;/span&gt; All’interno del nostro Impact Plan - bit.ly/OurImpactPlanKPMG - trovi riassunte tutte le azioni concrete che stiamo portando avanti su tematiche ambientali, sociali e di governance (ESG).  &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;span style=&quot;font-size:14.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;KPMG S.p.A., KPMG Advisory S.p.A., KPMG Studio Associato, KPMG Fides Servizi di Amministrazione S.p.A., Nolan Norton Italia S.r.l., KPMG Business Services S.r.l., KPMG Open Platform S.r.l. SB garantiscono le pari opportunità.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;We don’t imagine a better future. We’re building it.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;h3&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Do Work That Matters – Your Role and Responsibilities&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and your colleagues tackle and solve today’s most pressing and complex challenges.&lt;br&gt;Based on your interests and our market needs, you will be placed in one of the following legal entities:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Advisory&lt;/strong&gt;, which provides consulting services to support businesses in transforming their business models, improving and digitizing processes, analyzing and managing risks, and assisting with extraordinary financial operations.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Fides Servizi di Amministrazione&lt;/strong&gt;, which offers professional services in administrative, accounting, and tax management, playing a key role in redesigning reporting models and harmonizing managerial accounting processes.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Audit &amp;amp; Assurance&lt;/strong&gt;, which offers an evolving portfolio of integrated services, providing insights that enable companies to meet the informational needs of the market and investors.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Nolan Norton&lt;/strong&gt;, KPMG Network’s IT Strategy firm, helps organizations navigate digital transformation challenges and implement IT architectures.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Open Platform&lt;/strong&gt;, which deals with the digitalization of Public Administration processes. &lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;KPMG Business Services&lt;/strong&gt;, which provides internal support to the organization, assisting all service lines and supporting professionals in managing daily activities.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;color:black;font-size:10.0pt&quot;&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;In particular, by joining one of the aforementioned teams at our Italian offices, you will be responsible for providing the highest standards of direct assistance and support to the Leadership and the members of the Management Group. &lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;h3&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Come As You Are – Your Skills and Qualities&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;You have a &lt;strong&gt;bachelor’s or master’s degree&lt;/strong&gt; in economics, law, engineering, and/or humanities.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;You have &lt;strong&gt;a good command of the English language&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;You have &lt;strong&gt;a good knowledge of the Office suite&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;You are registered under &lt;strong&gt;Protected Categories, Art. 1 / 18 of Law 68/99&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;h3&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Your Future With Us – What You Will Find at KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;An &lt;strong&gt;inclusive and equitable work environment&lt;/strong&gt; that respects, encourages, and values diversity – Our workplace is designed to be inclusive and accessible to everyone. We are proud to offer a &lt;strong&gt;barrier-free structure&lt;/strong&gt;, ensuring that all individuals, regardless of physical ability, can work in a comfortable and safe environment. Our office features:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Access ramps&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Accessible elevators&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Accessible restrooms&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Ergonomic workstations&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;We are also committed to providing an inclusive work environment and accommodating &lt;strong&gt;specific adjustment requests&lt;/strong&gt; to meet our employees&apos; individual needs.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Additionally, you will find:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;A &lt;strong&gt;stimulating and dynamic environment&lt;/strong&gt; that fosters creativity and teamwork.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;A &lt;strong&gt;hybrid work model&lt;/strong&gt; to promote a healthy work-life balance.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Advanced training and development programs&lt;/strong&gt; to keep you constantly updated.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;An international mindset and innovative projects&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Initiatives focused on physical and mental well-being&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;font-size:10.0pt&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;color:black;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;Standard employment contract under the collective labour agreement for the commerce sector, level IV, III or II. The salary is determined on the basis of objective criteria, including the candidate’s skills, relevant experience and fulfilment of the requirements of the position.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;color:black;font-size:10.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/span&gt;&lt;/p&gt;
&lt;h3&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Together for Better – Our Values and Commitment&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, commitment to the community, and integrity—these are &lt;strong&gt;KPMG’s Values&lt;/strong&gt;, creating an environment open to the exchange of ideas and knowledge, allowing our professionals to reach their full potential. &lt;/span&gt;&lt;span style=&quot;font-family:Arial, sans-serif&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;You can find all the concrete actions we are taking on &lt;strong&gt;environmental, social, and governance (ESG) issues&lt;/strong&gt; in our &lt;strong&gt;Impact Plan&lt;/strong&gt;: &lt;a href=&quot;bit.ly/OurImpactPlanKPMG&quot;&gt;bit.ly/OurImpactPlanKPMG&lt;/a&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;h3&gt;&lt;span style=&quot;font-size:14.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Join Us!&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;
&lt;p&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Your data will be processed in full compliance with the provisions of &lt;strong&gt;Regulation (EU) No. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;)&lt;/strong&gt; and subsequent amendments. For more information, please refer to &lt;strong&gt;KPMG’s privacy policy&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;KPMG S.p.A., KPMG Advisory S.p.A., KPMG Studio Associato, KPMG Fides Servizi di Amministrazione S.p.A., Nolan Norton Italia S.r.l., KPMG Business Services S.r.l., and KPMG Open Platform S.r.l. SB ensure equal opportunities.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;#LI-AA2&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Candidatura-spontanea-Categorie-Protette/768523602/</link><guid isPermaLink="false">768523602</guid><g:id>768523602</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>Audit - Technician (Intern) (Milano, IT)</title><description><![CDATA[&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;border:none windowtext 1.0pt;font-size:12.0pt;padding:0.0cm&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Arial&amp;#39;, sans-serif&quot;&gt;Audit - Technician (Intern)&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:14.0pt&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Do Work That Matters &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;- Il tuo ruolo e le tue responsabilità &lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. Nel rispetto dei valori di &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;integrità e qualità,&lt;strong&gt; KPMG Audit &amp;amp; Assurance &lt;/strong&gt;offre un portafoglio di servizi integrato in costante evoluzione, con insight che consentono alle aziende di rispondere ai fabbisogni informativi del mercato e degli investitori. In particolare,&lt;/span&gt; &lt;span style=&quot;font-size:10.0pt&quot;&gt;entrerai a far parte del Team &lt;strong&gt;Data Solutions di Milano&lt;/strong&gt;, Centro di Eccellenza di KPMG Italia che si pone come obiettivo il raggiungimento della massima qualità dei servizi offerti ai clienti nei vari ambiti di intervento attraverso l’innovazione e la crescita personale.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Audit del &lt;strong&gt;bilancio&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Progetti speciali in ambito &lt;strong&gt;Tax, Transaction Services, Finanza e Fiscalità&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Supporto alle attività di &lt;strong&gt;Data Analytics&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Verifica della regolare tenuta della &lt;strong&gt;contabilità&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Sei &lt;strong&gt;neodiplomato&lt;/strong&gt; o studente di &lt;strong&gt;laurea triennale&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Hai interesse per il mondo della &lt;strong&gt;contabilità&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Hai voglia di &lt;strong&gt;imparare&lt;/strong&gt; e metterti in gioco &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Vuoi crescere all’interno di un &lt;strong&gt;Network Internazionale&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Your Future With Us - Cosa troverai in KPMG&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Mindset internazionale&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Together for Better – I nostri valori e il nostro impegno&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere.”&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt&quot;&gt;Unisciti a noi!&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG&lt;/span&gt;&lt;/em&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;.&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;KPMG S.p.A. garantisce le pari opportunità.&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size:8.0px&quot;&gt;#LI-TB1&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;div&gt;
&lt;p&gt;-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;border:none windowtext 1.0pt;font-size:14.0pt;padding:0.0cm&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Audit - Technician (Intern)&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:14.0pt&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Do Work That Matters - Your Role and Responsibilities&lt;/span&gt;&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and your colleagues tackle and solve the most current and complex challenges. Upholding the values of integrity and quality, &lt;strong&gt;KPMG Audit &amp;amp; Assurance&lt;/strong&gt; offers an integrated and constantly evolving portfolio of services, providing insights that enable companies to meet the informational needs of the market and investors.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;In particular, you will join the &lt;strong&gt;Data Solutions Team&lt;/strong&gt; in Milan, the Centre of Excellence of KPMG Italy, which aims to achieve the highest quality of services offered to clients in various areas of intervention, through innovation and personal growth.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Specifically, you will be tasked with:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Audit of &lt;strong&gt;financial statements&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Special projects in the &lt;strong&gt;Tax&lt;/strong&gt;,&lt;strong&gt; Transaction Services&lt;/strong&gt;, &lt;strong&gt;Finance&lt;/strong&gt;&lt;strong&gt; &lt;/strong&gt;and&lt;strong&gt; Taxation&lt;/strong&gt; areas&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Support for &lt;strong&gt;Data&lt;/strong&gt;&lt;strong&gt; analytics &lt;/strong&gt;activities &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Checking the proper keeping of &lt;strong&gt;accounting records&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Your Skills and Characteristics&lt;/span&gt;&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;You are &lt;strong&gt;High school graduates&lt;/strong&gt; or &lt;strong&gt;university undergraduates &lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;You are &lt;strong&gt;interested in Audit&lt;/strong&gt; of financial statements&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;You want to &lt;strong&gt;learn&lt;/strong&gt; and challenge yourself &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;You want to grow within an &lt;strong&gt;International Network&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Your Future With Us - What You Will Find at KPMG&lt;/span&gt;&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;An &lt;strong&gt;inclusive&lt;/strong&gt; and equitable&lt;strong&gt; work environment&lt;/strong&gt; that respects, encourages and values &lt;strong&gt;diversity.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;a&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;A challenging and dynamic environment that encourages&lt;strong&gt; creativity&lt;/strong&gt; and &lt;strong&gt;teamwork.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/a&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Hybrid&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt; work arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programmes to stay current.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;International&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt; mindset&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt; and &lt;strong&gt;innovative projects.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Together for Better – Our Values and Commitment&lt;/span&gt;&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Leadership, teamwork, respect for individuality, continuous learning, transparency, community engagement, integrity: these are the &lt;strong&gt;values of KPMG&lt;/strong&gt; that create an environment open to the exchange of ideas and knowledge, allowing our professionals to &lt;strong&gt;express their full potential.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Join us!&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) No. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) and subsequent amendments. For more information, please refer to KPMG&apos;s privacy policy.&lt;/span&gt;&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0pt&quot;&gt;&lt;span style=&quot;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;&lt;span style=&quot;font-family:&amp;#39;Calibri&amp;#39;, sans-serif&quot;&gt;KPMG S.p.A. is an equal opportunity employer.&lt;/span&gt;&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Audit-Technician-%28Intern%29/762810502/</link><guid isPermaLink="false">762810502</guid><g:id>762810502</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Audit</g:job_function><g:location>Milano, IT</g:location></item><item><title>Junior Consultant - Public Sector - Sanità Torino (Torino, IT)</title><description><![CDATA[&lt;p&gt;&lt;strong&gt;Junior Consultant - Public Sector – Sanità  - Intnership&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters &lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;- Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. KPMG Advisory offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/p&gt;
&lt;p&gt;Entrando a far parte del nostro Team&lt;strong&gt; Governance, Risk &amp;amp; Compliance &lt;/strong&gt;di &lt;strong&gt;Torino &lt;/strong&gt;dedicato ai clienti del &lt;strong&gt;Public Sector &lt;/strong&gt;e delle&lt;strong&gt; realtà Sanitarie&lt;/strong&gt;, la tua esperienza troverà la giusta valorizzazione e ti consentirà di diventare il punto di riferimento per importanti clienti, supportati nel miglioramento dell’efficacia e dell’efficienza dei processi e delle organizzazioni, creando un elevato valore aggiunto e incrementando l’impatto dei servizi erogati.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Nello specifico ti occuperai di:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Analisi, sviluppo e miglioramento dei processi delle &lt;strong&gt;organizzazioni pubbliche&lt;/strong&gt; e &lt;strong&gt;sanitarie&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Studi di fattibilità e di impatto&lt;/li&gt;
&lt;li&gt;Definizione di sistemi per il monitoraggio della&lt;strong&gt; spesa pubblica &lt;/strong&gt;e &lt;strong&gt;sanitaria&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Progettazione ed implementazione di modelli e strumenti di Governance&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Entrando a far parte di un team giovane e dinamico sarete coinvolti in progetti volti ad individuare soluzioni e modelli di funzionamento finalizzati a migliorare la produttività, l’efficienza e la qualità dei servizi offerti dai nostri clienti.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Questa opportunità è perfetta per te se hai:&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Laurea magistrale in &lt;strong&gt;Economia Aziendale/Economia Sanitaria/Ingegneria gestionale&lt;/strong&gt; conseguita (o in fase di conseguimento) con ottime votazioni&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Interesse per il settore pubblico e sanitario, tematiche di organizzazione contabile e compliance&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Certificazioni ed abilitazioni professionali&lt;/li&gt;
&lt;li&gt;Ottima conoscenza della lingua inglese, meglio se avvalorata da un’esperienza di studio e/o lavoro all’estero&lt;/li&gt;
&lt;li&gt;Ottima conoscenza del pacchetto Office&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/li&gt;
&lt;li&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/li&gt;
&lt;li&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;L’opportunità prevede un inserimento in stage con indennità mensile di 800€ / L’opportunità prevede un inserimento in stage con indennità mensile di 800€ per stage curriculare o 1.000€ per stage extracurriculare o in assunzione con inquadramento ai sensi del CCNL Commercio e RAL di ingresso: € 29.000, determinata sulla base di criteri oggettivi quali il titolo di studio e la valutazione del profilo rispetto ai requisiti della posizione.&lt;/div&gt;
&lt;p&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network ha ottenuto le &lt;strong&gt;certificazioni ISO 30415&lt;/strong&gt;, che attesta la conformità del Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, che certifica la parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Junior Consultant - Public Sector – Healthcare  - Intnership&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;We let the future guide us. Join our next generation.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Do Work That Matters – Your Role and Responsibilities&lt;/strong&gt;&lt;br&gt;Do you want to engage in work that is truly meaningful and impactful? At KPMG, you will have the opportunity to assist clients, society, and your colleagues in tackling and solving the most current and complex challenges. KPMG Advisory provides consultancy services to companies, supporting them in transforming their business models, improving and digitalizing processes, analyzing and managing risks, and offering assistance with extraordinary financial operations.&lt;/p&gt;
&lt;p&gt;By joining our &lt;strong&gt;Governance, Risk &amp;amp; Compliance&lt;/strong&gt; Team in &lt;strong&gt;Turin&lt;/strong&gt;, dedicated to &lt;strong&gt;Public Sector and Healthcare clients&lt;/strong&gt;, your experience will be fully recognized and utilized. You will have the chance to become a trusted point of reference for key clients, helping them enhance the effectiveness and efficiency of processes and organizations, thus creating significant added value and increasing the impact of the services delivered.&lt;/p&gt;
&lt;p&gt;Specifically, your responsibilities will include:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Analyzing, developing, and improving the processes of public and healthcare organizations&lt;/li&gt;
&lt;li&gt;Conducting feasibility and impact studies&lt;/li&gt;
&lt;li&gt;Designing systems to monitor public and healthcare expenditures&lt;/li&gt;
&lt;li&gt;Developing and implementing governance models and tools&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;As part of a young and dynamic team, you will work on projects aimed at identifying solutions and operating models to enhance the productivity, efficiency, and quality of services offered by our clients.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Come As You Are – Your Skills and Qualifications&lt;/strong&gt;&lt;br&gt;This opportunity is perfect for you if you have:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;A master’s degree in &lt;strong&gt;Business Administration, Healthcare Economics, or Management Engineering&lt;/strong&gt;, completed (or near completion) with excellent grades&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;An interest in the public and healthcare sectors, with a focus on organizational, accounting, and compliance topics&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Professional certifications or qualifications&lt;/li&gt;
&lt;li&gt;Excellent knowledge of English, preferably supported by study or work experience abroad&lt;/li&gt;
&lt;li&gt;Strong proficiency in Microsoft Office tools&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Your Future With Us – What You’ll Find at KPMG&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;&lt;strong&gt;An inclusive&lt;/strong&gt; and equitable work environment that respects, encourages, and &lt;strong&gt;values diversity&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;A dynamic and stimulating context that fosters &lt;strong&gt;creativity and teamwork&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Hybrid&lt;/strong&gt; working arrangements to promote a healthy work-life balance&lt;/li&gt;
&lt;li&gt;Advanced&lt;strong&gt; training &lt;/strong&gt;and development programs to stay up to date&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;An international mindset &lt;/strong&gt;and&lt;strong&gt; innovative projects&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being.&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;div&gt;This opportunity is offered as either a paid internship with a monthly allowance of €800 / This opportunity is offered as either a paid internship offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships or a standard employment contract under the collective labour agreement for the commerce sector, with a starting gross annual salary of €29,000. The salary is determined on the basis of objective criteria, including educational qualifications and an assessment of the candidate’s profile against the requirements of the role.&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;
&lt;div&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria.&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Together for Better – Our values and commitment&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network has obtained &lt;strong&gt;ISO 30415 certification&lt;/strong&gt;, which certifies compliance of the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, which certifies gender equality. Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarised all the concrete actions we are taking on environmental, social and governance (ESG) issues. &lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG’s privacy policy.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;#LI-VE1&lt;br&gt;#LI-MM3&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Torino-Junior-Consultant-Public-Sector-Sanit%C3%A0-Torino/1358138557/</link><guid isPermaLink="false">1358138557</guid><g:id>1358138557</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Torino, IT</g:location></item><item><title>Junior ServiceNow Developer - Application Maintenance (Napoli, IT)</title><description><![CDATA[&lt;p class=&quot;MsoNoSpacing&quot; style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;

&lt;p class=&quot;MsoNoSpacing&quot; style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;em&gt;The chance to build a better future is right in front of you&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Do Work That Matters&lt;/strong&gt; - Il tuo ruolo e le tue responsabilità&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare clienti, società, colleghe e colleghi ad affrontare e risolvere le sfide più attuali e complesse.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;KPMG Open Platform&lt;/strong&gt; è il nostro nuovo Hub innovativo con sede a &lt;strong&gt;Napoli&lt;/strong&gt;, creato per sviluppare modelli di servizio e soluzioni ad alto contenuto tecnologico per imprese e Pubblica Amministrazione. Le aree di intervento includono Cyber Security, Program Management, Application Maintenance e Managed Services.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Entrando a far parte del &lt;strong&gt;Team AMS ServiceNow&lt;/strong&gt;, ti occuperai della &lt;strong&gt;gestione continuativa&lt;/strong&gt; delle piattaforme ServiceNow già attive presso un portfolio di clienti strutturati. Sarai il punto di riferimento tecnico e il tuo tuo focus sarà sul &lt;strong&gt;presidio operativo&lt;/strong&gt;, sull&apos;ottimizzazione delle soluzioni in esercizio e sul &lt;strong&gt;miglioramento continuo del servizio&lt;/strong&gt;. &lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Presidiare operativamente le piattaforme &lt;strong&gt;ServiceNow &lt;/strong&gt;attive, intervenendo su &lt;strong&gt;malfunzionamenti&lt;/strong&gt;, richieste di &lt;strong&gt;modifica &lt;/strong&gt;e &lt;strong&gt;aggiornamenti &lt;/strong&gt;di processo.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Modificare e &lt;strong&gt;ottimizzare workflow&lt;/strong&gt; già configurati: adattare regole di assegnazione, aggiungere passaggi, correggere flussi che non seguono più il percorso corretto.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Introdurre &lt;strong&gt;nuove funzionalità&lt;/strong&gt; all’interno di applicazioni esistenti (nuovi tipi di richiesta, nuovi form, nuove integrazioni con altri sistemi).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Garantire la &lt;strong&gt;continuità operativa del servizio&lt;/strong&gt;, rispettando i livelli di servizio concordati con il cliente (SLA).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Contribuire al &lt;strong&gt;miglioramento continuo &lt;/strong&gt;dei processi digitalizzati, individuando inefficienze e proponendo ottimizzazioni.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Come As You Are&lt;/strong&gt; - Le tue competenze e caratteristiche&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai un background accademico (&lt;strong&gt;laurea &lt;/strong&gt;o &lt;strong&gt;diploma&lt;/strong&gt;) in &lt;strong&gt;Informatica&lt;/strong&gt;, &lt;strong&gt;Ingegneria &lt;/strong&gt;o discipline &lt;strong&gt;STEM&lt;/strong&gt;, oppure hai completato un percorso di specializzazione in s&lt;strong&gt;viluppo software o programmazione&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai conoscenze di base di &lt;strong&gt;programmazione &lt;/strong&gt;(JavaScript è un plus).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Ti interessa lo&lt;strong&gt; sviluppo software&lt;/strong&gt; e la &lt;strong&gt;costruzione di applicazioni&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Ti piace analizzare problemi e trasformarli in soluzioni strutturate.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Sai lavorare in &lt;strong&gt;team &lt;/strong&gt;e confrontarti su problemi tecnici.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hai una buona conoscenza della lingua &lt;strong&gt;inglese&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Your Future With Us&lt;/strong&gt; – Cosa troverai in &lt;strong&gt;KPMG Open Platform&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un ambiente di lavoro &lt;strong&gt;inclusivo&lt;/strong&gt; ed &lt;strong&gt;equo&lt;/strong&gt;, che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un contesto &lt;strong&gt;stimolante&lt;/strong&gt; e &lt;strong&gt;dinamico&lt;/strong&gt; che incentiva &lt;strong&gt;creatività&lt;/strong&gt; e lavoro di squadra&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida&lt;/strong&gt;, per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e &lt;strong&gt;sviluppo&lt;/strong&gt; per rimanere sempre aggiornati&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Mindset &lt;strong&gt;internazionale&lt;/strong&gt; e progettualità &lt;strong&gt;innovative&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Un’organizzazione che si impegna per generare un &lt;strong&gt;impatto sociale&lt;/strong&gt; e sul territorio&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;em&gt;L’opportunità prevede un inserimento in stage o in assunzione con inquadramento ai sensi del CCNL Commercio, RAL di ingresso compresa tra € 23.500 e € 24.000, determinata sulla base di criteri oggettivi quali il titolo di studio e la valutazione del profilo rispetto ai requisiti della posizione.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;em&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Together for Better&lt;/strong&gt; – I nostri valori e il nostro impegno&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Leadership&lt;/strong&gt;, lavoro in &lt;strong&gt;team&lt;/strong&gt;, rispetto di ogni &lt;strong&gt;individualità&lt;/strong&gt;, approfondimento continuo, &lt;strong&gt;trasparenza&lt;/strong&gt;, impegno verso la &lt;strong&gt;comunità&lt;/strong&gt;, &lt;strong&gt;integrità&lt;/strong&gt;: questi sono i Valori di &lt;strong&gt;KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di esprimere tutto il loro potenziale.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Grazie all’impegno nel favorire un ambiente di lavoro &lt;strong&gt;inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt; (Sistema di Gestione per la Diversità e l’Inclusione) e &lt;strong&gt;UNI PdR 125&lt;/strong&gt; (parità di genere). All’interno del nostro Impact Plan - bit.ly/OurImpactPlanKPMG - trovi riassunte tutte le azioni concrete che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;).&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (&lt;strong&gt;GDPR&lt;/strong&gt;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di &lt;strong&gt;KPMG&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;KPMG Open Platform S.r.l. SB&lt;/strong&gt; garantisce le &lt;strong&gt;pari opportunità&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Do Work That Matters – Your role and responsibilities&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Do you want to do work that truly matters? At KPMG you will have the opportunity to help clients, organisations, colleagues to tackle and solve the most current and complex challenges.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;KPMG Open Platform is our innovative Hub based in Naples, established to develop high-tech service models and solutions for both private enterprises and Public Administration. Our areas of expertise include Cyber Security, Program Management, Application Maintenance and Managed Services.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;As part of the AMS ServiceNow Team, you will be responsible for the ongoing management of ServiceNow platforms already live at a portfolio of structured clients. You will act as the technical point of reference, with a focus on operational oversight, optimisation of solutions in production and continuous service improvement.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Specifically, you will:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Monitor and manage live ServiceNow platforms, addressing malfunctions, change requests and process updates.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Modify and optimise existing workflows: adapting assignment rules, adding steps, correcting flows that no longer follow the correct path.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Introduce new features within existing applications (new request types, new forms, new integrations with other systems).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Ensure service continuity, meeting the service levels agreed with the client (SLAs).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Contribute to the continuous improvement of digitalised processes, identifying inefficiencies and proposing optimisations.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Come As You Are – Your skills and background&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;This opportunity is a great fit for you if:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You hold a degree or diploma in Computer Science, Engineering or a STEM discipline, or have completed a specialisation programme in software development or programming.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have basic programming knowledge (JavaScript is a plus).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have an interest in software development and application building.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You enjoy analysing problems and turning them into structured solutions.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You are a team player and enjoy discussing technical challenges with others.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You have a good command of the English language.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Your Future With Us – What you will find at KPMG Open Platform&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;An inclusive and equitable workplace that respects, encourages and values diversity&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;A stimulating and dynamic environment that fosters creativity and teamwork&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Hybrid working model, to support a healthy work-life balance&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Training and development programmes to keep your skills sharp and up to date&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;International mindset and innovative projects&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Initiatives focused on physical and mental wellbeing&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;An organisation committed to generating social and community impact&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;em&gt;This opportunity is offered as either an internship or a standard employment contract under the collective labour agreement for the commerce sector, with a starting gross annual salary ranging from €23,500 to €24,000. The salary is determined on the basis of objective criteria, including educational qualifications and an assessment of the candidate&apos;s profile against the requirements of the role.&lt;/em&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;&lt;em&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Together for Better – Our values and our commitment&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, community commitment, integrity: these are KPMG&apos;s Values, which shape an environment open to the exchange of ideas and knowledge, enabling our professionals to reach their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Through our commitment to fostering an inclusive workplace, our Network complies with the requirements of ISO 30415 (Diversity and Inclusion Management System) and UNI PdR 125 (gender equality). Our Impact Plan (bit.ly/OurImpactPlanKPMG) outlines all the concrete actions we are taking on environmental, social and governance (ESG) matters.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Join us!&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Your personal data will be processed in full compliance with Regulation (EU) No. 679/2016 (GDPR) and subsequent amendments. For further information, please refer to KPMG&apos;s privacy policy.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;KPMG Open Platform S.r.l. SB is an equal opportunities employer.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:12.0pt;font-family:arial, helvetica, sans-serif&quot;&gt;#LI-MM2&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Napoli-Junior-ServiceNow-Developer-Application-Maintenance/1358116257/</link><guid isPermaLink="false">1358116257</guid><g:id>1358116257</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Napoli, IT</g:location></item><item><title>Senior/Assistant Manager IT Risk &amp; IT Audit - Roma (Roma, IT)</title><description><![CDATA[&lt;p&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;The chance to build a better future is right in front of you&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Do Work That Matters - Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;strong&gt;KPMG Audit &amp;amp; Assurance &lt;/strong&gt;offre servizi di consulenza alle imprese per supportarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché nelle operazioni di finanza straordinaria.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;In particolare, entrando a far parte del Team di Cyber &amp;amp; Tech Risk a Roma, lavorerai con i nostri esperti di ICT security per aiutare i clienti ad affrontare i rischi informatici che minacciano il loro business. Collaborerai su progetti rilevanti per le aziende leader di mercato.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Nello specifico, ti occuperai di:&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Analizzare i rischi e i controlli (rischio IT);&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Comprendere le metodologie interne e le normative adottate dai clienti;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Valutare degli impatti delle caratteristiche specifiche del business del cliente sui sistemi IT;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Analizzare la parametrizzazione, configurazione e processi SAP (per i processi contabili e logistici);&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Approfondire la sicurezza negli ambienti SAP ECC / SAP HANA;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Utilizzare le funzionalità di accesso ai dati (tabelle e report) e relative analisi;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Apprendere gli strumenti di elaborazione dei dati come QlikView, IDEA e MS Access.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Sarai coinvolto su progetti sia nazionali che internazionali, collaborando con professionisti altamente qualificati, e lavorerai a stretto contatto con i nostri clienti, contribuendo alla gestione di rischi IT, governance, audit, privacy e sicurezza informatica.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Questa opportunità è perfetta per te se:&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Hai maturato oltre 2 anni di esperienza in società di consulenza operanti in ambito cybersecurity, audit IT e compliance;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Hai una laurea in ingegneria informatica, ingegneria gestionale o in informatica e tecnologie dell&apos;informazione;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Hai un&apos;ottima padronanza della lingua inglese, preferibilmente con esperienze di studio e/o lavoro all&apos;estero;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Conosci i principali standard applicabili (ISO27001, COBIT, ITIL, ecc.);&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Hai esperienza nella strategia e nella valutazione del rischio informatico;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Hai conoscenza della governance dei sistemi IT e di business continuity;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Sei disponibile per effettuare trasferte a livello nazionale e internazionale.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 31.000 e € 38.000 per la qualifica di Senior Consultant e tra € 38.000 e € 48.000 per la qualifica di Assistant Manager, determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione. &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere. &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Leadership, lavoro in team, rispetto delle individualità, apprendimento continuo, trasparenza, impegno verso la comunità e integrità: questi sono &lt;strong&gt;i valori di KPMG&lt;/strong&gt;. Favoriamo un ambiente aperto allo scambio di idee e alla crescita personale e professionale.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;KPMG Advisory S.p.A. garantisce le pari opportunità. I tuoi dati saranno trattati nel pieno rispetto del Regolamento (UE) n. 679/2016 (GDPR).&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;The chance to build a better future is right in front of you&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters - Your Role and Responsibilities&lt;/em&gt;&lt;/strong&gt;&lt;br&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and colleagues address and solve the most current and complex challenges. &lt;strong&gt;KPMG Audit &amp;amp; Assurance&lt;/strong&gt; offers consulting services to businesses, supporting them in transforming their business models, improving and digitizing processes, analyzing and managing risks, and executing extraordinary financial operations.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;By joining the Cyber &amp;amp; Tech Risk Team in Rome, you will work with our ICT security experts to help clients face cyber risks that threaten their business. You will collaborate on key projects for market-leading companies.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Specifically, you will be involved in:&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Analyzing risks&lt;/strong&gt; and controls (IT risk);&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Understanding the &lt;strong&gt;internal methodologies&lt;/strong&gt; and regulations adopted by clients;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Assessing the &lt;strong&gt;impact of clients&apos; specific business&lt;/strong&gt; characteristics on IT systems;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Analyzing the configuration&lt;/strong&gt;, setup, and processes of SAP (for accounting and logistics processes);&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Deepening your &lt;strong&gt;knowledge of security&lt;/strong&gt; in SAP ECC / SAP HANA environments;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Utilizing &lt;strong&gt;data access functionalities&lt;/strong&gt; (tables and reports) and conducting related analyses;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Learning to &lt;strong&gt;use data processing&lt;/strong&gt; tools such as QlikView, IDEA, and MS Access.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;You will be involved in both national and international projects, working alongside highly qualified professionals, and collaborating closely with our clients to contribute to IT risk management, governance, audit, privacy, and cybersecurity.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As You Are - Your Skills and Qualities&lt;/em&gt;&lt;/strong&gt;&lt;br&gt;This opportunity is perfect for you if:&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;You have 2+ &lt;strong&gt; years of experience&lt;/strong&gt; in consulting firms operating in cybersecurity, IT audit, and compliance&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;You hold a degree in Computer Engineering, Management Engineering, or Computer Science and Information Technology&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;You have an excellent command of English, preferably with study and/or work experience abroad&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;You are familiar with the &lt;strong&gt;main applicable standards&lt;/strong&gt; (ISO27001, COBIT, ITIL, etc.)&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;You have experience in &lt;strong&gt;cybersecurity strategy&lt;/strong&gt; and &lt;strong&gt;risk assessment&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;You have knowledge of IT systems governance and &lt;strong&gt;business continuity&lt;/strong&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;You are available for national and international travel.&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - What You Will Find at KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;An inclusive, &lt;strong&gt;equitable work&lt;/strong&gt; environment that respects, encourages, and values diversity&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;A stimulating and &lt;strong&gt;dynamic context&lt;/strong&gt; that fosters creativity and teamwork&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;A &lt;strong&gt;hybrid working&lt;/strong&gt; model to promote a healthy work-life balance&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Advanced training&lt;/strong&gt; and development programs to stay up-to-date&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;An &lt;strong&gt;international mindset&lt;/strong&gt; and innovative projects&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;Initiatives focused on physical and &lt;strong&gt;mental well-being&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €31,000 to €38,000 for the Senior Consultant position and from €38,000 to €48,000 for the Assistant Manager position. The salary is determined on the basis of objective criteria, including the candidate’s skills and experience assessed against the requirements of the role. &lt;/p&gt;
&lt;p&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better – Our Values and Commitment&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;br&gt;Leadership, teamwork, respect for individuality, continuous learning, transparency, community engagement, and integrity: these are KPMG’s values. We promote an environment open to the exchange of ideas and personal and professional growth.&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;br&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) No. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) and subsequent amendments. For more information, please refer to KPMG’s privacy policy.&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;KPMG Advisory S.p.A. guarantees equal opportunities. Your data will be processed in full compliance with Regulation (EU) No. 679/2016 (GDPR).&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;#LI-AA1&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:8.0px&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;#LI-AA1&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Roma-SeniorAssistant-Manager-IT-Risk-&amp;-IT-Audit-Roma/1332656457/</link><guid isPermaLink="false">1332656457</guid><g:id>1332656457</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Roma, IT</g:location></item><item><title>Senior Consultant - SAP Group Reporting (Milano, IT)</title><description><![CDATA[&lt;p&gt;&lt;span style=&quot;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt;background-color:white&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white&quot;&gt;&lt;em&gt;The chance to build a better future is right in front of you&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;&lt;strong&gt;Do Work That Matters – Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;KPMG Advisory offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Entrando a far parte del Team &lt;strong&gt;Enterprise Platforms&lt;/strong&gt;, lavorerai su progetti di trasformazione digitale in ambito &lt;strong&gt;SAP Group Reporting&lt;/strong&gt;, supportando i clienti nella progettazione e implementazione di soluzioni per la gestione integrata dei processi di &lt;strong&gt;consolidamento e reporting finanziario di gruppo&lt;/strong&gt;, inclusi i progetti di migrazione da SAP BPC verso Group Reporting.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Nello specifico, ti occuperai di:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Analizzare i requisiti di business attraverso workshop e sessioni di confronto con le funzioni &lt;strong&gt;Finance&lt;/strong&gt;, &lt;strong&gt;Controlling&lt;/strong&gt; e &lt;strong&gt;Consolidamento&lt;/strong&gt; del cliente, traducendoli in soluzioni applicative concrete.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Guidare il disegno della soluzione basata su &lt;strong&gt;SAP Group Reporting&lt;/strong&gt;, valorizzando le funzionalità standard della piattaforma e garantendo l&apos;allineamento con i processi di consolidamento del gruppo (statutory e/o management).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Gestire la redazione&lt;/strong&gt; dell&apos;analisi funzionale e delle specifiche di configurazione, coordinando il contributo degli altri membri del team di progetto.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Supervisionare e partecipare alle attività di &lt;strong&gt;configurazione, testing e validazione&lt;/strong&gt; della soluzione, interfacciandosi con gli utenti finali e con i team tecnici.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Essere il riferimento per il cliente&lt;/strong&gt; nelle fasi di go-live, gestendo le sessioni di formazione con i key user e supportando la stabilizzazione della soluzione nel periodo post rilascio.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Contribuire allo sviluppo della practice, supportando la produzione di &lt;strong&gt;proposal&lt;/strong&gt; e la definizione di metodologie e approcci progettuali.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Sarai coinvolta/o su progetti nazionali e internazionali al fianco di professioniste e professionisti altamente qualificati e lavorerai a stretto contatto con i nostri clienti del settore dei &lt;strong&gt;Financial Services&lt;/strong&gt;, tra cui banche, assicurazioni e società di investimento. &lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Come As You Are – Le tue competenze e caratteristiche&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai maturato esperienza su &lt;strong&gt;SAP Group Reporting&lt;/strong&gt; o su soluzioni di consolidamento SAP precedenti (SEM-BCS, EC-CS, BPC).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Possiedi una solida conoscenza dei processi di &lt;strong&gt;consolidamento finanziario&lt;/strong&gt; (statutory e/o management): eliminazioni intercompany, traduzione valutaria, raccolta dati dalle subsidiary.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hai una buona comprensione dei &lt;strong&gt;principi contabili di riferimento&lt;/strong&gt; (IFRS e/o local GAAP) applicati ai processi di consolidamento e chiusura di gruppo.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Sei in grado di gestire autonomamente le fasi di &lt;strong&gt;analisi, design e configurazione&lt;/strong&gt; in progetti di implementazione SAP Finance, interfacciandoti direttamente con il cliente.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Possiedi una conoscenza solida di &lt;strong&gt;SAP S/4HANA Finance&lt;/strong&gt; e dei principali processi di chiusura e reporting finanziario di gruppo.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Possiedi una buona padronanza della &lt;strong&gt;lingua inglese&lt;/strong&gt;, preferibilmente con esperienze di studio e/o lavoro all&apos;estero.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Sei disponibile a viaggiare sia a livello &lt;strong&gt;nazionale&lt;/strong&gt; che &lt;strong&gt;internazionale&lt;/strong&gt; per supportare i clienti nelle varie fasi progettuali.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Your Future With Us – Cosa troverai in KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt; &lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Un ambiente di lavoro &lt;strong&gt;inclusivo&lt;/strong&gt;, &lt;strong&gt;equo &lt;/strong&gt;e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Un contesto &lt;strong&gt;stimolante &lt;/strong&gt;e &lt;strong&gt;dinamico &lt;/strong&gt;che incentiva la creatività e il lavoro di squadra &lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida&lt;/strong&gt;, per promuovere un sano equilibrio tra vita lavorativa e personale &lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt;&lt;strong&gt; &lt;/strong&gt;e &lt;strong&gt;sviluppo &lt;/strong&gt;avanzati per rimanere sempre aggiornati &lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Mindset &lt;strong&gt;internazionale&lt;/strong&gt;&lt;strong&gt; &lt;/strong&gt;e progettualità &lt;strong&gt;innovative&lt;/strong&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;Inquadramento ai sensi del CCNL Commercio, RAL indicativa compresa tra € 31.000 e € 41.000 per la qualifica di Senior Consultant e tra € 38.000 e € 51.000 per la qualifica di Assistant Manager, determinata sulla base di criteri oggettivi con riferimento specifico alle competenze e all’esperienza del profilo rispetto ai requisiti della posizione. &lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;em&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;&lt;strong&gt;Together for Better – I nostri valori e il nostro impegno&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;Leadership, lavoro di squadra, rispetto dell’individualità, approfondimento continuo, trasparenza, impegno verso la comunità e integrità: questi sono i Valori di KPMG. Creiamo un ambiente aperto allo scambio di idee, dove i professionisti possono esprimere tutto il loro potenziale.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;Nel nostro Impact Plan – &lt;strong&gt;&lt;a style=&quot;background-color:white;color:black&quot; href=&quot;https://kpmg.com/&quot; target=&quot;_new&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt;&lt;/strong&gt; – trovi tutte le iniziative concrete che portiamo avanti su tematiche &lt;strong&gt;ESG&lt;/strong&gt; (ambientali, sociali e di governance).&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt; &lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del &lt;strong&gt;Regolamento (UE) n. 679/2016 (GDPR)&lt;/strong&gt;. Per ulteriori informazioni, consulta l’informativa sulla privacy di KPMG.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;&lt;strong&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Do Work That Matters – Your role and responsibilities&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG you will have the opportunity to help clients, society, and colleagues tackle and solve the most current and complex challenges. KPMG Advisory provides consulting services to businesses, supporting them in transforming their business model, improving and digitising processes, analysing and managing risks, as well as providing support in extraordinary finance transactions.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;By joining the Enterprise Platforms team, you will work on digital transformation projects in the area of SAP Group Reporting, supporting clients in the design and implementation of solutions for the integrated management of group financial consolidation and reporting processes, including migration projects from SAP BPC to Group Reporting.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Specifically, you will be responsible for:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Analysing business requirements through workshops and working sessions with the client&apos;s Finance, Controlling and Consolidation functions, translating them into concrete application solutions.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Leading the solution design based on SAP Group Reporting, leveraging the standard functionalities of the platform and ensuring alignment with the group&apos;s consolidation processes (statutory and/or management).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Managing the drafting of functional analysis and configuration specifications, coordinating the contribution of other project team members.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Overseeing and participating in the configuration, testing and validation activities of the solution, liaising with end users and technical teams.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Acting as the key point of contact for the client during go-live phases, managing training sessions with key users and supporting solution stabilisation in the post-release period.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Contributing to the development of the practice by supporting the production of proposals and the definition of project methodologies and approaches.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You will be involved in national and international projects, collaborating with highly qualified professionals and working closely with our clients.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Come As You Are – Your skills and characteristics&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have gained experience in SAP Group Reporting or previous SAP consolidation solutions (SEM-BCS, EC-CS, BPC).&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have a solid knowledge of financial consolidation processes (statutory and/or management): intercompany eliminations, currency translation, data collection from subsidiaries.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have a good understanding of the relevant accounting principles (IFRS and/or local GAAP) applied to group consolidation and closing processes.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You are able to independently manage the analysis, design and configuration phases in SAP Finance implementation projects, liaising directly with the client.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have a solid knowledge of SAP S/4HANA Finance and the main group financial closing and reporting processes.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;You have a good command of English, preferably with study and/or work experience abroad.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;You are available to travel both nationally and internationally to support clients across the various project phases.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;color:black&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;Y&lt;/strong&gt;&lt;/span&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;&lt;strong&gt;our Future With Us – What you will find at KPMG&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;An inclusive, fair working environment that respects, encourages and values diversity.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;A stimulating and dynamic environment that fosters creativity and teamwork.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Hybrid working arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Advanced training and development programmes to keep you always up to date.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;An international mindset and innovative projects.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Initiatives focused on physical and mental wellbeing.&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;color:black&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;Standard employment contract under the collective labour agreement for the commerce sector, with a gross annual salary ranging from €31,000 to €41,000 for the Senior Consultant position and from €38,000 to €51,000 for the Assistant Manager position. The salary is determined on the basis of objective criteria, including the candidate&apos;s skills and experience assessed against the requirements of the role.&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:black&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt&quot;&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria.&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;&lt;strong&gt;Together for Better – Our values and our commitment&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Leadership, teamwork, respect for individuality, continuous learning, transparency, commitment to the community and integrity: these are KPMG&apos;s Values. We create an environment open to the exchange of ideas, where professionals can express their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Thanks to our commitment to fostering an inclusive working environment, our Network complies with the standards of ISO 30415, on the Diversity and Inclusion Management System, and UNI PdR 125, on gender equality.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;In our Impact Plan – Our Impact Plan (kpmg.com) – you will find all the concrete initiatives we carry out on ESG (environmental, social and governance) topics.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;Join us! Your data will be processed in full compliance with the provisions of EU Regulation No. 679/2016 (GDPR). For more information, please consult KPMG&apos;s privacy policy.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;color:black&quot;&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:12.0pt;background-color:white;color:black&quot;&gt;#LI-MM2&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Senior-Consultant-SAP-Group-Reporting/1360917257/</link><guid isPermaLink="false">1360917257</guid><g:id>1360917257</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>Junior Consultant - Public Sector - Sanità Milano (Milano, IT)</title><description><![CDATA[&lt;p&gt;&lt;strong&gt;Junior Consultant - Public Sector – Sanità  - Intnership&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Do Work That Matters &lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;- Il tuo ruolo e le tue responsabilità&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. KPMG Advisory offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/p&gt;
&lt;p&gt;Entrando a far parte del nostro Team&lt;strong&gt; Governance, Risk &amp;amp; Compliance &lt;/strong&gt;di &lt;strong&gt;Milano &lt;/strong&gt;dedicato ai clienti del &lt;strong&gt;Public Sector &lt;/strong&gt;e delle&lt;strong&gt; realtà Sanitarie&lt;/strong&gt;, la tua esperienza troverà la giusta valorizzazione e ti consentirà di diventare il punto di riferimento per importanti clienti, supportati nel miglioramento dell’efficacia e dell’efficienza dei processi e delle organizzazioni, creando un elevato valore aggiunto e incrementando l’impatto dei servizi erogati.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Nello specifico ti occuperai di:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Analisi, sviluppo e miglioramento dei processi delle &lt;strong&gt;organizzazioni pubbliche&lt;/strong&gt; e &lt;strong&gt;sanitarie&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Studi di fattibilità e di impatto&lt;/li&gt;
&lt;li&gt;Definizione di sistemi per il monitoraggio della&lt;strong&gt; spesa pubblica &lt;/strong&gt;e &lt;strong&gt;sanitaria&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Progettazione ed implementazione di modelli e strumenti di Governance&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Entrando a far parte di un team giovane e dinamico sarete coinvolti in progetti volti ad individuare soluzioni e modelli di funzionamento finalizzati a migliorare la produttività, l’efficienza e la qualità dei servizi offerti dai nostri clienti.&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Questa opportunità è perfetta per te se hai:&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Laurea magistrale in &lt;strong&gt;Economia Aziendale/Economia Sanitaria/Ingegneria gestionale&lt;/strong&gt; conseguita (o in fase di conseguimento) con ottime votazioni&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Interesse per il settore pubblico e sanitario, tematiche di organizzazione contabile e compliance&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Certificazioni ed abilitazioni professionali&lt;/li&gt;
&lt;li&gt;Ottima conoscenza della lingua inglese, meglio se avvalorata da un’esperienza di studio e/o lavoro all’estero&lt;/li&gt;
&lt;li&gt;Ottima conoscenza del pacchetto Office&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/li&gt;
&lt;li&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/li&gt;
&lt;li&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;Mindset internazionale&lt;/strong&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;div&gt;L’opportunità prevede un inserimento in stage con indennità mensile di 800€ / L’opportunità prevede un inserimento in stage con indennità mensile di 800€ per stage curriculare o 1.000€ per stage extracurriculare o in assunzione con inquadramento ai sensi del CCNL Commercio e RAL di ingresso: € 29.000, determinata sulla base di criteri oggettivi quali il titolo di studio e la valutazione del profilo rispetto ai requisiti della posizione.&lt;/div&gt;
&lt;p&gt;In ottemperanza alla normativa vigente, non raccogliamo né utilizziamo informazioni sulle retribuzioni percepite in rapporti di lavoro attuali o precedenti. Le nostre procedure di selezione sono, inoltre, improntate a criteri oggettivi e neutrali rispetto al genere.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt; &lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network ha ottenuto le &lt;strong&gt;certificazioni ISO 30415&lt;/strong&gt;, che attesta la conformità del Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, che certifica la parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Unisciti a noi!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Junior Consultant - Public Sector – Healthcare - Intnership&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;We let the future guide us. Join our next generation.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Do Work That Matters – Your Role and Responsibilities&lt;/strong&gt;&lt;br&gt;Do you want to engage in work that is truly meaningful and impactful? At KPMG, you will have the opportunity to assist clients, society, and your colleagues in tackling and solving the most current and complex challenges. KPMG Advisory provides consultancy services to companies, supporting them in transforming their business models, improving and digitalizing processes, analyzing and managing risks, and offering assistance with extraordinary financial operations.&lt;/p&gt;
&lt;p&gt;By joining our &lt;strong&gt;Governance, Risk &amp;amp; Compliance&lt;/strong&gt; Team in &lt;strong&gt;Milan&lt;/strong&gt;, dedicated to &lt;strong&gt;Public Sector and Healthcare clients&lt;/strong&gt;, your experience will be fully recognized and utilized. You will have the chance to become a trusted point of reference for key clients, helping them enhance the effectiveness and efficiency of processes and organizations, thus creating significant added value and increasing the impact of the services delivered.&lt;/p&gt;
&lt;p&gt;Specifically, your responsibilities will include:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;Analyzing, developing, and improving the processes of public and healthcare organizations&lt;/li&gt;
&lt;li&gt;Conducting feasibility and impact studies&lt;/li&gt;
&lt;li&gt;Designing systems to monitor public and healthcare expenditures&lt;/li&gt;
&lt;li&gt;Developing and implementing governance models and tools&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;As part of a young and dynamic team, you will work on projects aimed at identifying solutions and operating models to enhance the productivity, efficiency, and quality of services offered by our clients.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Come As You Are – Your Skills and Qualifications&lt;/strong&gt;&lt;br&gt;This opportunity is perfect for you if you have:&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;A master’s degree in &lt;strong&gt;Business Administration, Healthcare Economics, or Management Engineering&lt;/strong&gt;, completed (or near completion) with excellent grades&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;An interest in the public and healthcare sectors, with a focus on organizational, accounting, and compliance topics&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Professional certifications or qualifications&lt;/li&gt;
&lt;li&gt;Excellent knowledge of English, preferably supported by study or work experience abroad&lt;/li&gt;
&lt;li&gt;Strong proficiency in Microsoft Office tools&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Your Future With Us – What You’ll Find at KPMG&lt;/strong&gt;&lt;/p&gt;
&lt;ul type=&quot;disc&quot;&gt;
&lt;li&gt;&lt;strong&gt;An inclusive&lt;/strong&gt; and equitable work environment that respects, encourages, and &lt;strong&gt;values diversity&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;A dynamic and stimulating context that fosters &lt;strong&gt;creativity and teamwork&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Hybrid&lt;/strong&gt; working arrangements to promote a healthy work-life balance&lt;/li&gt;
&lt;li&gt;Advanced&lt;strong&gt; training &lt;/strong&gt;and development programs to stay up to date&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;An international mindset &lt;/strong&gt;and&lt;strong&gt; innovative projects&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being.&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;This opportunity is offered as either a paid internship with a monthly allowance of €800 / This opportunity is offered as either a paid internship offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships or a standard employment contract under the collective labour agreement for the commerce sector, with a starting gross annual salary of €29,000. The salary is determined on the basis of objective criteria, including educational qualifications and an assessment of the candidate’s profile against the requirements of the role.&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;
&lt;div&gt;In accordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria.&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;em&gt;Together for Better – Our values and commitment&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/p&gt;
&lt;p&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network has obtained &lt;strong&gt;ISO 30415 certification&lt;/strong&gt;, which certifies compliance of the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, which certifies gender equality. Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarised all the concrete actions we are taking on environmental, social and governance (ESG) issues. &lt;strong&gt; &lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG’s privacy policy.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;#LI-VE1&lt;br&gt;#LI-MM3&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Junior-Consultant-Public-Sector-Sanit%C3%A0-Milano/1358138957/</link><guid isPermaLink="false">1358138957</guid><g:id>1358138957</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>Senior VAT Consultant | Milano (Milano, IT)</title><description><![CDATA[&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;em&gt;&lt;strong&gt;Do Work That Matters – Your Role and Responsibilities&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the firm and colleagues address and solve the most current and complex challenges. The tax and legal experts at KPMG &lt;strong&gt;Studio Associato &lt;/strong&gt;provide assistance in all the key tax and corporate law areas, offering innovative, integrated services.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;In particular, by joining the &lt;strong&gt;VAT Tax team&lt;/strong&gt; of our Milan office, you will help support clients in addressing challenges related to key areas of taxation. You will operate in a constantly evolving scenario, where national and international regulations intertwine with market and public opinion expectations on crucial topics such as ethics, transparency, and corporate governance&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;Specifically you will be tasked with:&lt;/span&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;providing ongoing consultancy to companies on indirect tax matters;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;expressing opinions on the application of indirect taxes on domestic and cross-border transactions; &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;analysing the VAT and direct tax impacts of corporate finance transactions (sales of companies, mergers, demergers, contributions, etc.) and domestic and international corporate restructuring; &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;analysing the tax risks by conducting internal audits and preparing operating procedures;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;VAT due diligence; &lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;VAT compliance.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;You will be involved in &lt;strong&gt;national&lt;/strong&gt; and &lt;strong&gt;international projects&lt;/strong&gt;, working alongside highly qualified professionals and acquiring top-level skills through interaction with the brightest minds in the field.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;em&gt;&lt;strong&gt;Come As You Are – Your Skills and Profile&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;list-style-type:disc&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;You have at least&lt;strong&gt; 3 year of professional experience&lt;/strong&gt; in leading national or international firms and/or consulting companies&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;You hold a Master’s degree in Economics (LM 77 or LM 56) or Law (LMG 01) with a final grade of at least 100/110&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;You are either a certified &lt;strong&gt;Chartered Accountant/Lawyer &lt;/strong&gt;or intend to begin the professional training&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;You have a &lt;strong&gt;good command of English&lt;/strong&gt;, ideally supported by study and/or work experiences abroad&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;You have a good working knowledge of Office tools, especially &lt;strong&gt;Excel and PowerPoint&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;You possess strong interpersonal and &lt;strong&gt;teamworking skills&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;em&gt;&lt;strong&gt;Your Future With Us – What You’ll Find at KPMG&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;list-style-type:disc&quot;&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;An &lt;strong&gt;inclusive and equitable work environment&lt;/strong&gt; that respects, encourages, and values diversity&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;A dynamic and stimulating setting that fosters &lt;strong&gt;creativity and collaboration&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;Advanced &lt;strong&gt;training and development programs&lt;/strong&gt; to keep your skills up to date&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;An international mindset and innovative projects&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better &lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;&lt;em&gt;– Our values and commitment&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; &lt;strong&gt;environment&lt;/strong&gt;, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality. Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;em&gt;bit.ly/OurImpactPlanKPMG&lt;/em&gt; - you will find summarised all the &lt;strong&gt;concrete actions&lt;/strong&gt; we are taking on environmental, social and governance (&lt;strong&gt;ESG&lt;/strong&gt;) issues. &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG’s privacy policy&lt;/em&gt;&lt;em&gt;.&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;&lt;strong&gt;&lt;em&gt;KPMG Studio Associato is an equal opportunity employer.&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:10.0pt&quot;&gt;#LI-CN1&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Senior-VAT-Consultant-Milano/1371423457/</link><guid isPermaLink="false">1371423457</guid><g:id>1371423457</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Tax</g:job_function><g:location>Milano, IT</g:location></item><item><title>Audit Roma Assistant Senior / Senior FS (Roma, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Do Work That Matters &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;- Il tuo ruolo e le tue responsabilità &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. Nel rispetto dei valori di integrità e qualità, &lt;strong&gt;KPMG Audit &amp;amp; Assurance&lt;/strong&gt; offre un portafoglio di servizi integrato in costante evoluzione, con insight che consentono alle aziende di rispondere ai fabbisogni informativi del mercato e degli investitori. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt;In particolare, entrando a far parte del &lt;strong&gt;&lt;span style=&quot;color:black;background-color:white&quot;&gt;Team Audit &amp;amp; Assurance&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;color:black;background-color:white&quot;&gt;,&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt&quot;&gt; ti interfaccerai con clienti leader a livello nazionale e internazionale e potrai contribuire all’integrità e alla trasparenza dei mercati finanziari, garantendo l’indipendenza e la riservatezza fondamentale al loro corretto andamento. Grazie all’&lt;strong&gt;innovazione&lt;/strong&gt;, svolgerai un &lt;em&gt;audit&lt;/em&gt; conforme e attento ai &lt;strong&gt;temi ESG&lt;/strong&gt;, sempre più &lt;strong&gt;digitalizzato&lt;/strong&gt;, &lt;strong&gt;integrato&lt;/strong&gt; e &lt;strong&gt;automatizzato&lt;/strong&gt;, basato sull&apos;&lt;strong&gt;Intelligenza Artificiale &lt;/strong&gt;e sui &lt;strong&gt;Big Data&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;color:black;background-color:white&quot;&gt;Sarai coinvolto/a in progetti che ti permetteranno di esplorare &lt;strong&gt;diverse realtà aziendali&lt;/strong&gt; (industriali o finanziarie) a 360°, intessere relazioni con i &lt;strong&gt;referenti delle società clienti&lt;/strong&gt; ed entrare a far parte di &lt;strong&gt;team strutturati&lt;/strong&gt; che ti supporteranno nella tua &lt;strong&gt;crescita professionale&lt;/strong&gt;. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Le tue competenze e caratteristiche &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:normal;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;background-color:white;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:black;background-color:white&quot;&gt;Hai conseguito una &lt;strong&gt;Laurea Magistrale&lt;/strong&gt; in &lt;strong&gt;Economia&lt;/strong&gt;/&lt;strong&gt;Finanza&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;background-color:white;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:black;background-color:white&quot;&gt;Hai maturato &lt;strong&gt;2-3 anni di esperienza&lt;/strong&gt;, preferibilmente in società di &lt;strong&gt;Revisione contabile&lt;/strong&gt; o di Consulenza&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;background-color:white;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:black;background-color:white&quot;&gt;Hai acquisito una conoscenza dei &lt;strong&gt;Principi Contabili Italiani&lt;/strong&gt; e &lt;strong&gt;IAS/IFRS, &lt;/strong&gt;oltre che dei principi di consolidamento e dei processi amministrativo contabili che sottendono alla predisposizione dell’&lt;strong&gt;informativa finanziaria&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;background-color:white;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:black;background-color:white&quot;&gt;Hai interesse a lavorare su tematiche in ambito amministrazione, pianificazione e controllo&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;background-color:white;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:black;background-color:white&quot;&gt;Hai un’ottima conoscenza della &lt;strong&gt;lingua inglese&lt;/strong&gt;, preferibilmente avvalorata da esperienze di studio e/o lavoro all&apos;estero e un’ottima conoscenza del &lt;strong&gt;pacchetto Office.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Your Future With Us - Cosa troverai in KPMG&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Mindset&lt;/span&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; internazionale&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Together for Better – I nostri valori e il nostro impegno&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Grazie all’impegno nel favorire un &lt;strong&gt;ambiente di lavoro inclusivo&lt;/strong&gt;, il nostro Network risulta conforme agli standard dei requisiti &lt;strong&gt;ISO 30415&lt;/strong&gt;, sul Sistema di Gestione per la Diversità e l’Inclusione, e &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relativa alla parità di genere.&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;em&gt;&lt;u&gt;bit.ly/OurImpactPlanKPMG&lt;/u&gt;&lt;/em&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt;Unisciti a noi!&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG&lt;/span&gt;&lt;/em&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;KPMG S.p.A. garantisce le pari opportunità.&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;_____________________________________________________________________________________________________________________________________________&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%;font-family:Calibri, sans-serif&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:107%;font-family:Calibri, sans-serif&quot;&gt;Do Work That Matters - Your Role and Responsibilities&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Do you want to do work that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and colleagues tackle and solve the most current and complex challenges. In line with the values of integrity and quality, KPMG Audit &amp;amp; Assurance offers an integrated and constantly evolving portfolio of services, with insights that enable companies to meet the informational needs of the market and investors.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;When you&lt;span style=&quot;color:red&quot;&gt; &lt;/span&gt;join &lt;span style=&quot;color:black;background-color:white&quot;&gt;the &lt;strong&gt;Audit Team&lt;/strong&gt;,&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-family:&amp;#39;Segoe UI&amp;#39;, sans-serif;color:#242424;background-color:#fafafa&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;you will collaborate with leading national and international clients and contribute to the integrity and transparency of financial markets, ensuring the confidentiality essential to their proper functioning. Thanks to &lt;strong&gt;innovation&lt;/strong&gt;, you will create an audit that is compliant and attentive to &lt;strong&gt;ESG issues&lt;/strong&gt;, increasingly &lt;strong&gt;digitalized&lt;/strong&gt;, &lt;strong&gt;integrated&lt;/strong&gt; and &lt;strong&gt;automated&lt;/strong&gt;, based on &lt;strong&gt;Artificial Intelligence&lt;/strong&gt; and &lt;strong&gt;Big Data&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:107%;font-family:Calibri, sans-serif&quot;&gt;Come As You Are - Your Skills and Characteristics&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;This opportunity is perfect for you if:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;You have obtained a &lt;strong&gt;master’s degree in economics/finance&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;You have &lt;strong&gt;2-3 years of experience,&lt;/strong&gt; preferably in auditing or consulting firms&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;You have acquired knowledge of &lt;strong&gt;Italian Accounting Principles and IAS/IFRS&lt;/strong&gt;, as well as consolidation principles and administrative accounting processes underlying financial reporting&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;You are interested in working on &lt;strong&gt;administration, planning, and control topics&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;You have excellent knowledge of the &lt;strong&gt;English&lt;/strong&gt; language, preferably supported by study and/or work experiences abroad, and excellent knowledge of the Office suite.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:107%;font-family:Calibri, sans-serif&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:107%;font-family:Calibri, sans-serif&quot;&gt;Your Future With Us - What You Will Find at KPMG&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;An &lt;strong&gt;inclusive, fair work environment&lt;/strong&gt; that respects, encourages, and values &lt;strong&gt;diversity&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;A stimulating and dynamic context that encourages &lt;strong&gt;creativity and teamwork&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Hybrid&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; work mode to promote a healthy work-life balance&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Advanced &lt;strong&gt;training and development&lt;/strong&gt; programs to stay up to date&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;International mindset&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt; and innovative projects&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;text-align:justify;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Initiatives focused on physical and mental &lt;strong&gt;well-being&lt;/strong&gt;.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:107%;font-family:Calibri, sans-serif&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:107%;font-family:Calibri, sans-serif&quot;&gt;Together for Better – Our Values and Commitment&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Leadership, teamwork, respect for every individual, continuous learning, transparency, commitment to the community, integrity: these are &lt;strong&gt;KPMG&apos;s Values&lt;/strong&gt; that create an environment open to the exchange of ideas and knowledge, allowing our professionals to express their full &lt;strong&gt;potential&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality. In our &lt;strong&gt;Impact Plan&lt;/strong&gt; - bit.ly/OurImpactPlanKPMG - you will find a summary of all the concrete actions we are taking on environmental, social, and governance (&lt;strong&gt;ESG&lt;/strong&gt;) issues. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:107%;font-family:Calibri, sans-serif&quot;&gt;Join us!&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) No. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) and subsequent amendments. For more information, please refer to KPMG&apos;s privacy policy.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-family:Calibri, sans-serif&quot;&gt;KPMG S.p.A. guarantees equal opportunities.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;br&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:8.0pt;color:darkgray&quot;&gt;#LI-GS1&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;margin:0.0cm 0.0cm 8.0pt;line-height:107%;font-size:11.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Roma-Audit-Roma-Assistant-Senior-Senior-FS/1371432657/</link><guid isPermaLink="false">1371432657</guid><g:id>1371432657</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Audit</g:job_function><g:location>Roma, IT</g:location></item><item><title>Internship - Market Risk| Milan (Milano, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm;text-align:center;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:20.0pt;line-height:115%&quot;&gt;Internship – Market Risk| Milan&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:center;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt;The chance to build a better future is right in front of you&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Do Work That Matters &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;- Your role and responsibilities &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the company and colleagues address and solve the most current and complex challenges. &lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;KPMG Advisory &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:9.0pt;line-height:107%;font-family:&amp;#39;Segoe UI&amp;#39;, sans-serif&quot;&gt;offers consulting services to companies to assist them in business model transformation, process improvement and digitisation, risk analysis and management, and support in extraordinary finance transactions. &lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;When you join &lt;span style=&quot;color:black;background-color:white&quot;&gt;the Market Risk team in Milan&lt;/span&gt;&lt;em&gt;, &lt;/em&gt;you are going to &lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;work on organizational and methodological issues within complex Risk Management projects following both regulatory and managerial goals for top-tier clients in the Financial Services sector. &lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%&quot;&gt;Specifically, you will be tasked with:&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:107%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt; &lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;color:#3c3c3c;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;risk and scenario analysis on specific &lt;strong&gt;market risk&lt;/strong&gt; areas or activities of the company;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;color:#3c3c3c;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;implementation and review of governance, reporting and mitigation models and processes for &lt;strong&gt;operational and reputational risks&lt;/strong&gt;;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;color:#3c3c3c;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;scouting and creating &lt;strong&gt;business cases&lt;/strong&gt; for the application of &lt;strong&gt;Artificial Intelligence&lt;/strong&gt; for more effective management of non-financial risks;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;color:#3c3c3c;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;conducting &lt;strong&gt;stress test analysis&lt;/strong&gt; from both managerial and regulatory perspectives.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm;text-align:justify;line-height:115%;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Your skills and characteristics &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;This is the perfect opportunity for you if:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-bottom:0.0cm;margin-top:0.0px&quot;&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 0.0cm 0.0px;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;master&apos;s degree (obtained or in the process of obtaining) in Economics and Finance, Economics of Financial Markets and Intermediaries, Financial Risk Management during which you have had the opportunity to study Risk Management topics in depth;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul style=&quot;margin-bottom:0.0cm;margin-top:0.0px&quot;&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 0.0cm 0.0px;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;excellent knowledge of the English language, preferably backed up by study and/or work experience abroad;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul style=&quot;margin-bottom:0.0cm;margin-top:0.0px&quot;&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 0.0cm 0.0px;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;excellent knowledge of the Office package;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;ul style=&quot;margin-bottom:0.0cm;margin-top:0.0px&quot;&gt;
&lt;li style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt 0.0px;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;knowledge of software and programming languages is considered a plus for candidates interested in more quantitative opportunities.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Your Future With Us - What you’ll find at KPMG&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;An &lt;strong&gt;inclusive&lt;/strong&gt; and equitable&lt;strong&gt; work environment&lt;/strong&gt; that respects, encourages and values &lt;strong&gt;diversity.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;A challenging and dynamic environment that encourages&lt;strong&gt; creativity&lt;/strong&gt; and &lt;strong&gt;teamwork.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Hybrid&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; work arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programmes to stay current.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;International&lt;/span&gt;&lt;/strong&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; mindset&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; and &lt;strong&gt;innovative projects.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-bottom:0.0cm;text-align:justify;line-height:115%;margin-top:0.0cm;margin-right:0.0cm;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being.&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:107%;font-family:Calibri, sans-serif&quot;&gt;This opportunity is offered as either a paid internship offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships. &lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;In acc&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:black&quot;&gt;ordance with applicable legislation, we do not collect or use information relating to remuneration received in current or previous employment. Our selection procedures are based on objective and gender-neutral criteria. &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:12.0pt;line-height:115%&quot;&gt;Together for Better – Our values and commitment&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;As a result of our commitment to fostering an &lt;strong&gt;inclusive work&lt;/strong&gt; environment, our Network complies with the standards of the &lt;strong&gt;ISO 30415&lt;/strong&gt; requirements, on the Diversity and Inclusion Management System, and &lt;strong&gt;UNI PdR 125&lt;/strong&gt;, relating to gender equality”&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;. Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;/span&gt;&lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%;color:windowtext&quot;&gt;Our Impact Plan (kpmg.com)&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; - you will find summarised all the concrete actions we are taking on environmental, social and governance (ESG) issues. &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:14.0pt;line-height:115%&quot;&gt;Join us!&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG’s privacy policy&lt;/span&gt;&lt;/em&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; &lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;#LI-FN1&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify;line-height:115%;margin:0.0cm 0.0cm 8.0pt;font-size:11.0pt;font-family:Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;#LI-HYBRID&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Internship-Market-Risk-Milan/1371431457/</link><guid isPermaLink="false">1371431457</guid><g:id>1371431457</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Risk Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>Junior Intelligent Automation -  Digital Transformation Intern (Milano, IT)</title><description><![CDATA[&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;strong&gt;KPMG Advisory&lt;/strong&gt; offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;In particolare entrerai a far parte del &lt;strong&gt;Team Lighthouse&lt;/strong&gt;, all’interno della service line &lt;strong&gt;Intelligent Automation &lt;/strong&gt;che si occupa di progetti di Digital Transformation&lt;strong&gt;.&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Come parte integrante del Team verrai affiancato da colleghi senior e sarai coinvolto in tutte le fasi progettuali, portando un contributo attivo e lavorando a stretto contatto con il Cliente.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Verrai coinvolto su progetti a livello nazionale ed internazionale di Digital Transformation attraverso varie tecnologie tra le quali &lt;strong&gt;Low Code&lt;/strong&gt;, &lt;strong&gt;Intelligent Business Process Management, Artificial Intelligence&lt;/strong&gt; e &lt;strong&gt;Robotic Process Automation.&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Nello specifico verrai coinvolto nelle seguenti attività:&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul style=&quot;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Supporto a &lt;strong&gt;studio di fattibilità&lt;/strong&gt;, &lt;strong&gt;raccolta&lt;/strong&gt; e &lt;strong&gt;analisi dei macro-requisiti&lt;/strong&gt;, &lt;strong&gt;disegno&lt;/strong&gt; e &lt;strong&gt;interpretazione di&lt;/strong&gt; &lt;strong&gt;flussi operativi &lt;/strong&gt;e &lt;strong&gt;sviluppo&lt;/strong&gt; di &lt;strong&gt;componenti applicativi&lt;/strong&gt;;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Utilizzo di una o più piattaforme, come &lt;strong&gt;UiPath&lt;/strong&gt;, &lt;strong&gt;BluePrism&lt;/strong&gt;, &lt;strong&gt;Appian, Outsystems, Microsoft Power Platform&lt;/strong&gt;;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Produzione e aggiornamento della documentazione funzionale e tecnica;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Questa opportunità è perfetta per te se:&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul style=&quot;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Possiedi una laurea, o sei un laureando, in discipline tecnico-scientifiche;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Possiedi conoscenze di base di uno o più &lt;strong&gt;linguaggi&lt;/strong&gt; &lt;strong&gt;di programmazione&lt;/strong&gt; software;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Possiedi conoscenza di base dei database &lt;strong&gt;MySQL&lt;/strong&gt; / &lt;strong&gt;SQL&lt;/strong&gt;;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Hai una buona padronanza della &lt;strong&gt;lingua inglese&lt;/strong&gt;, preferibilmente con esperienze di studio e/o lavoro all&apos;estero;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Possiedi &lt;strong&gt;ottime capacità relazionali&lt;/strong&gt; e di &lt;strong&gt;problem solving&lt;/strong&gt;, un forte orientamento al &lt;strong&gt;raggiungimento degli obiettivi&lt;/strong&gt; e una personalità &lt;strong&gt;dinamica&lt;/strong&gt; e &lt;strong&gt;proattiva&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul style=&quot;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Mindset internazionale&lt;/em&gt;&lt;/strong&gt;&lt;em&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:8.0pt&quot;&gt;&lt;span&gt;Opportunità di stage con indennità mensile di 800€ per stage curriculare o 1000€ per stage extracurriculare&lt;/span&gt; &lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Grazie all’impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network risulta conforme agli standard dei requisiti ISO 30415, sul Sistema di Gestione per la Diversità e l’Inclusione, e UNI PdR 125, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a style=&quot;color:#467886;text-decoration:underline&quot; title=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot; href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Unisciti a noi!&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;We let the future guide us. Join our next generation &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the company and colleagues address and solve the most current and complex challenges. &lt;strong&gt;KPMG Advisory &lt;/strong&gt;offers consulting services to companies to assist them in business model transformation, process improvement and digitisation, risk analysis and management, and support in extraordinary finance transactions. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Specifically, you will our&lt;strong&gt; Lighthouse team, &lt;/strong&gt;within the&lt;strong&gt; Intelligent Automation &lt;/strong&gt;service line that deals with Digital Transformation projects.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;As an integral part of the Team you will be supported by senior colleagues and will be involved in all project phases, bringing an active contribution and working closely with the Client.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;You will be involved on national and international&lt;strong&gt; Digital Transformation projects &lt;/strong&gt;across various technologies including&lt;strong&gt; Low Code, Intelligent Business Process Management, Artificial Intelligence &lt;/strong&gt;and&lt;strong&gt; Robotic Process Automation.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Specifically, you will be tasked with:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;supporting &lt;strong&gt;feasibility studies&lt;/strong&gt;,which consist of the &lt;strong&gt;collection&lt;/strong&gt; and &lt;strong&gt;analysis of macro requirements&lt;/strong&gt;, the capacity for &lt;strong&gt;designing&lt;/strong&gt; and &lt;strong&gt;interpreting operating flows&lt;/strong&gt; and the &lt;strong&gt;development&lt;/strong&gt; of &lt;strong&gt;software components&lt;/strong&gt;;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;use of one or more platforms, such as &lt;strong&gt;UiPath&lt;/strong&gt;, &lt;strong&gt;BluePrism&lt;/strong&gt;, &lt;strong&gt;Appian&lt;/strong&gt;, &lt;strong&gt;Outsystems&lt;/strong&gt;, &lt;strong&gt;Microsoft Power Platform&lt;/strong&gt;;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;production and updating of functional and technical documentation.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Your skills and characteristics &lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;This is the perfect opportunity for you if you:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;are a graduate or nearing graduation in technical-scientific subjects;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;have basic knowledge of one or more software &lt;strong&gt;programming languages&lt;/strong&gt;;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;have basic knowledge of communication methods with &lt;strong&gt;MySQL/MsSQL&lt;/strong&gt; databases;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;are proficient in &lt;strong&gt;English&lt;/strong&gt;, preferably with study/work experience abroad;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;you have &lt;strong&gt;excellent interpersonal&lt;/strong&gt; and &lt;strong&gt;communication skills&lt;/strong&gt;, a strong &lt;strong&gt;goal-oriented&lt;/strong&gt; approach, and a &lt;strong&gt;dynamic&lt;/strong&gt; and &lt;strong&gt;proactive&lt;/strong&gt; personality, with a &lt;strong&gt;problem-solving&lt;/strong&gt; attitude and resistance to stress, which allows you to work effectively both in a group and independently.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - What you’ll find at KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;An &lt;strong&gt;inclusive&lt;/strong&gt; and equitable &lt;strong&gt;work environment&lt;/strong&gt; that respects, encourages and values &lt;strong&gt;diversity.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;A challenging and dynamic environment that encourages&lt;strong&gt; creativity&lt;/strong&gt; and &lt;strong&gt;teamwork.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Hybrid&lt;/strong&gt; work arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programmes to stay current.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;International&lt;/strong&gt;&lt;strong&gt; mindset&lt;/strong&gt; and &lt;strong&gt;innovative projects.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;span&gt;Paid internship opportunity offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships&lt;/span&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better – Our values and commitment&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;As a result of our commitment to fostering an inclusive work environment, our Network complies with the standards of the ISO 30415 requirements, on the Diversity and Inclusion Management System, and UNI PdR 125, relating to gender equality.  Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a style=&quot;color:blue;text-decoration:underline&quot; href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarised all the &lt;strong&gt;concrete actions&lt;/strong&gt; we are taking on environmental, social and governance (&lt;strong&gt;ESG&lt;/strong&gt;) issues. &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:9.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG&apos;s privacy policy.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:9.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:8.0pt;font-family:Arial, sans-serif&quot;&gt;#LI-SD1&lt;/span&gt;&lt;/div&gt;]]></description><link>https://careers.kpmg.it/job/Milano-Junior-Intelligent-Automation-%C2%A0Digital-Transformation-Intern/1365713757/</link><guid isPermaLink="false">1365713757</guid><g:id>1365713757</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Milano, IT</g:location></item><item><title>Junior Intelligent Automation (Intern) -  Digital Transformation (Torino, IT)</title><description><![CDATA[&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;We let the future guide us. Join our next generation&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;strong&gt;KPMG Advisory&lt;/strong&gt; offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;In particolare entrerai a far parte del &lt;strong&gt;Team Lighthouse&lt;/strong&gt;, all’interno della service line &lt;strong&gt;Intelligent Automation &lt;/strong&gt;che si occupa di progetti di Digital Transformation&lt;strong&gt;.&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Come parte integrante del Team verrai affiancato da colleghi senior e sarai coinvolto in tutte le fasi progettuali, portando un contributo attivo e lavorando a stretto contatto con il Cliente.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Verrai coinvolto su progetti a livello nazionale ed internazionale di Digital Transformation attraverso varie tecnologie tra le quali &lt;strong&gt;Low Code&lt;/strong&gt;, &lt;strong&gt;Intelligent Business Process Management, Artificial Intelligence&lt;/strong&gt; e &lt;strong&gt;Robotic Process Automation.&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Nello specifico verrai coinvolto nelle seguenti attività:&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul style=&quot;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Supporto a &lt;strong&gt;studio di fattibilità&lt;/strong&gt;, &lt;strong&gt;raccolta&lt;/strong&gt; e &lt;strong&gt;analisi dei macro-requisiti&lt;/strong&gt;, &lt;strong&gt;disegno&lt;/strong&gt; e &lt;strong&gt;interpretazione di&lt;/strong&gt; &lt;strong&gt;flussi operativi &lt;/strong&gt;e &lt;strong&gt;sviluppo&lt;/strong&gt; di &lt;strong&gt;componenti applicativi&lt;/strong&gt;;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Utilizzo di una o più piattaforme, come &lt;strong&gt;UiPath&lt;/strong&gt;, &lt;strong&gt;BluePrism&lt;/strong&gt;, &lt;strong&gt;Appian, Outsystems, Microsoft Power Platform&lt;/strong&gt;;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Produzione e aggiornamento della documentazione funzionale e tecnica;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Questa opportunità è perfetta per te se:&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul style=&quot;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Possiedi una laurea, o sei un laureando, in discipline tecnico-scientifiche;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Possiedi conoscenze di base di uno o più &lt;strong&gt;linguaggi&lt;/strong&gt; &lt;strong&gt;di programmazione&lt;/strong&gt; software;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Possiedi conoscenza di base dei database &lt;strong&gt;MySQL&lt;/strong&gt; / &lt;strong&gt;SQL&lt;/strong&gt;;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Hai una buona padronanza della &lt;strong&gt;lingua inglese&lt;/strong&gt;, preferibilmente con esperienze di studio e/o lavoro all&apos;estero;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Possiedi &lt;strong&gt;ottime capacità relazionali&lt;/strong&gt; e di &lt;strong&gt;problem solving&lt;/strong&gt;, un forte orientamento al &lt;strong&gt;raggiungimento degli obiettivi&lt;/strong&gt; e una personalità &lt;strong&gt;dinamica&lt;/strong&gt; e &lt;strong&gt;proattiva&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt; &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Your Future With Us - Cosa troverai in KPMG&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;ul style=&quot;margin-bottom:11.0px&quot;&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Modalità di lavoro &lt;strong&gt;ibrida,&lt;/strong&gt; per promuovere un sano equilibrio tra vita lavorativa e personale&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Mindset internazionale&lt;/em&gt;&lt;/strong&gt;&lt;em&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;div&gt;&lt;span style=&quot;font-family:arial, helvetica, sans-serif;font-size:8.0pt&quot;&gt;&lt;span&gt;Opportunità di stage con indennità mensile di 800€ per stage curriculare o 1000€ per stage extracurriculare&lt;/span&gt; &lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Together for Better – I nostri valori e il nostro impegno&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Grazie all’impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network risulta conforme agli standard dei requisiti ISO 30415, sul Sistema di Gestione per la Diversità e l’Inclusione, e UNI PdR 125, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a style=&quot;color:#467886;text-decoration:underline&quot; title=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot; href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Unisciti a noi!&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;
&lt;p&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;We let the future guide us. Join our next generation &lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, the company and colleagues address and solve the most current and complex challenges. &lt;strong&gt;KPMG Advisory &lt;/strong&gt;offers consulting services to companies to assist them in business model transformation, process improvement and digitisation, risk analysis and management, and support in extraordinary finance transactions. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Specifically, you will our&lt;strong&gt; Lighthouse team, &lt;/strong&gt;within the&lt;strong&gt; Intelligent Automation &lt;/strong&gt;service line that deals with Digital Transformation projects.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;As an integral part of the Team you will be supported by senior colleagues and will be involved in all project phases, bringing an active contribution and working closely with the Client.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;You will be involved on national and international&lt;strong&gt; Digital Transformation projects &lt;/strong&gt;across various technologies including&lt;strong&gt; Low Code, Intelligent Business Process Management, Artificial Intelligence &lt;/strong&gt;and&lt;strong&gt; Robotic Process Automation.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Specifically, you will be tasked with:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;supporting &lt;strong&gt;feasibility studies&lt;/strong&gt;,which consist of the &lt;strong&gt;collection&lt;/strong&gt; and &lt;strong&gt;analysis of macro requirements&lt;/strong&gt;, the capacity for &lt;strong&gt;designing&lt;/strong&gt; and &lt;strong&gt;interpreting operating flows&lt;/strong&gt; and the &lt;strong&gt;development&lt;/strong&gt; of &lt;strong&gt;software components&lt;/strong&gt;;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;use of one or more platforms, such as &lt;strong&gt;UiPath&lt;/strong&gt;, &lt;strong&gt;BluePrism&lt;/strong&gt;, &lt;strong&gt;Appian&lt;/strong&gt;, &lt;strong&gt;Outsystems&lt;/strong&gt;, &lt;strong&gt;Microsoft Power Platform&lt;/strong&gt;;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;production and updating of functional and technical documentation.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Come As &lt;a name=&quot;_Int_yZQD4mJ8&quot;&gt;&lt;/a&gt;You Are - Your skills and characteristics &lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;This is the perfect opportunity for you if you:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;are a graduate or nearing graduation in technical-scientific subjects;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;have basic knowledge of one or more software &lt;strong&gt;programming languages&lt;/strong&gt;;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;have basic knowledge of communication methods with &lt;strong&gt;MySQL/MsSQL&lt;/strong&gt; databases;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;are proficient in &lt;strong&gt;English&lt;/strong&gt;, preferably with study/work experience abroad;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;you have &lt;strong&gt;excellent interpersonal&lt;/strong&gt; and &lt;strong&gt;communication skills&lt;/strong&gt;, a strong &lt;strong&gt;goal-oriented&lt;/strong&gt; approach, and a &lt;strong&gt;dynamic&lt;/strong&gt; and &lt;strong&gt;proactive&lt;/strong&gt; personality, with a &lt;strong&gt;problem-solving&lt;/strong&gt; attitude and resistance to stress, which allows you to work effectively both in a group and independently.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Your Future With Us - What you’ll find at KPMG&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;ul&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;An &lt;strong&gt;inclusive&lt;/strong&gt; and equitable &lt;strong&gt;work environment&lt;/strong&gt; that respects, encourages and values &lt;strong&gt;diversity.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;A challenging and dynamic environment that encourages&lt;strong&gt; creativity&lt;/strong&gt; and &lt;strong&gt;teamwork.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Hybrid&lt;/strong&gt; work arrangements to promote a healthy work-life balance.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Advanced &lt;strong&gt;training&lt;/strong&gt; and development programmes to stay current.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;a name=&quot;_Int_dxQRXY7F&quot;&gt;&lt;/a&gt;&lt;strong&gt;International&lt;/strong&gt;&lt;strong&gt; mindset&lt;/strong&gt; and &lt;strong&gt;innovative projects.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li style=&quot;text-align:justify&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Initiatives focused on &lt;strong&gt;mental and physical well-being.&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;span&gt;Paid internship opportunity offering a monthly allowance of €800 for curricular internships and €1,000 for extracurricular internships&lt;/span&gt; &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;Together for Better – Our values and commitment&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the &lt;strong&gt;KPMG&lt;/strong&gt; &lt;strong&gt;values &lt;/strong&gt;that create an environment that encourages the sharing of ideas and knowledge, so our professionals can &lt;strong&gt;achieve their full potential&lt;/strong&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;As a result of our commitment to fostering an inclusive work environment, our Network complies with the standards of the ISO 30415 requirements, on the Diversity and Inclusion Management System, and UNI PdR 125, relating to gender equality.  Within our &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a style=&quot;color:blue;text-decoration:underline&quot; href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - you will find summarised all the &lt;strong&gt;concrete actions&lt;/strong&gt; we are taking on environmental, social and governance (&lt;strong&gt;ESG&lt;/strong&gt;) issues. &lt;strong&gt; &lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:11.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;strong&gt;Join us!&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:9.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG&apos;s privacy policy.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt;&lt;span style=&quot;font-size:9.0px&quot;&gt;&lt;span style=&quot;font-family:Arial, Helvetica, sans-serif&quot;&gt;&lt;em&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align:justify&quot;&gt; &lt;/p&gt;
&lt;p&gt; &lt;/p&gt;
&lt;/div&gt;
&lt;div&gt; &lt;/div&gt;
&lt;div&gt;&lt;span style=&quot;font-size:8.0pt;font-family:Arial, sans-serif&quot;&gt;#LI-SD1&lt;/span&gt;&lt;/div&gt;]]></description><link>https://careers.kpmg.it/job/Torino-Junior-Intelligent-Automation-%28Intern%29-%C2%A0Digital-Transformation/1366150557/</link><guid isPermaLink="false">1366150557</guid><g:id>1366150557</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Torino, IT</g:location></item><item><title>AI Trasformation Junior Consultant (Milano, IT)</title><description><![CDATA[&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;AI Transformation Consultant &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;We let the future guide us. &lt;/span&gt;&lt;/em&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Join our next generation&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Vuoi fare un lavoro che sia davvero significativo e di impatto? In KPMG avrai l’opportunità di aiutare i clienti, la società, le colleghe e i colleghi ad affrontare e risolvere le sfide più attuali e complesse. &lt;strong&gt;KPMG Advisory&lt;/strong&gt; offre servizi di consulenza alle imprese per affiancarle nella trasformazione del business model, nel miglioramento e nella digitalizzazione dei processi, nell&apos;analisi e nella gestione dei rischi, nonché supporto nelle operazioni di finanza straordinaria.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;In particolare, entrerai a far parte del &lt;strong&gt;Team Lighthouse&lt;/strong&gt;, all’interno della service line &lt;strong&gt;Intelligent Automation &lt;/strong&gt;che si occupa di progetti di Digital Transformation&lt;strong&gt;. &lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Lighthouse Intelligent Automation è la practice di KPMG che progetta e realizza soluzioni software per automatizzare i processi aziendali, combinando intelligenza artificiale, agenti, piattaforme low-code e sviluppo su misura. Non ci fermiamo al prototipo: accompagniamo il cliente dall’analisi del processo fino alla soluzione in esercizio, con presidio della sicurezza, della conformità e dei benefici misurati.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Nello specifico verrai coinvolto nelle seguenti attività:&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Raccogliere e documentare i requisiti di processo attraverso interviste e workshop con gli utenti&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Sviluppare applicazioni con Power Apps e flussi di automazione con Power Automate&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Configurare agenti conversazionali in Copilot Studio: topic, knowledge source, azioni verso i sistemi&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Modellare i dati su Dataverse e integrare le soluzioni con le fonti dati del cliente&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Eseguire test funzionali, documentare le soluzioni e preparare i materiali per gli utenti finali&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Supportare le attività di rilascio e il presidio delle soluzioni già in esercizio&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Contribuire agli asset riutilizzabili della practice: componenti, template, librerie di prompt&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Come As You Are - Le tue competenze e caratteristiche&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Questa opportunità è perfetta per te se:&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Possiedi una laurea o sei laureando in ingegneria, informatica, matematica, statistica o percorsi affini&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Possiedi un’attitudine analitica e capacità di scomporre un processo nelle sue fasi elementari&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Possiedi capacità di comprensione dei fondamenti dell’AI generativa: modelli linguistici, tecniche di prompting, nozione di architettura RAG e consapevolezza dei limiti applicativi di tali strumenti&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Mostri interesse concreto verso le piattaforme di automazione, accompagnato dalla motivazione ad acquisirne la padronanza operativa&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Hai maturato una prima esperienza sulla Microsoft Power Platform, anche in ambito accademico, in tirocinio o attraverso progetti personali: Power Apps e Power Automate&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Dimostri conoscenza, anche introduttiva, di Microsoft Copilot Studio e della costruzione di agenti&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Possiedi esperienza con Claude Code o altri strumenti di sviluppo agentico&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•   Dimostri conoscenza di Google Gemini o di un altro ecosistema di AI generativa oltre a quello Microsoft&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Possiedi nozioni di SQL, Python o JavaScript&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Nice to have: certificazione Microsoft PL-900, PL-200 o AI-900&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Esperienza, anche di breve durata e in ambito accademico, in contesti di consulenza o a contatto con la clientela&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    Hai una buona padronanza della lingua inglese, preferibilmente con esperienze di studio/lavoro all’estero&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;•    &lt;/span&gt;Possiedi ottime capacità relazionali e di problem solving, un forte orientamento al raggiungimento degli obiettivi e una personalità dinamica e proattiva&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Your Future With Us - Cosa troverai in KPMG&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Un ambiente di &lt;strong&gt;lavoro inclusivo&lt;/strong&gt;, equo e che rispetta, incoraggia e valorizza le &lt;strong&gt;diversità&lt;/strong&gt;&lt;/span&gt;&lt;/em&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Un contesto stimolante e dinamico che incentiva la &lt;strong&gt;creatività&lt;/strong&gt; e il &lt;strong&gt;lavoro di squadra&lt;/strong&gt;&lt;/span&gt;&lt;/em&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Programmi di &lt;strong&gt;formazione&lt;/strong&gt; e sviluppo avanzati per rimanere sempre aggiornati&lt;/span&gt;&lt;/em&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Mindset internazionale&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; e &lt;strong&gt;progettualità innovative&lt;/strong&gt;&lt;/span&gt;&lt;/em&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Iniziative incentrate sul &lt;strong&gt;benessere psicofisico&lt;/strong&gt;&lt;/span&gt;&lt;/em&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Opportunità di stage con indennità mensile di 800€ per stage curriculare o 1000€ per stage extracurriculare.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Together for Better – I nostri valori e il nostro impegno&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Leadership, lavoro in team, rispetto di ogni individualità, approfondimento continuo, trasparenza, impegno verso la comunità, integrità: questi sono i &lt;strong&gt;Valori di KPMG&lt;/strong&gt; che danno vita a un ambiente aperto allo scambio di idee e di conoscenza, che permette ai nostri professionisti di &lt;strong&gt;esprimere tutto il loro potenziale&lt;/strong&gt;.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Grazie all’impegno nel favorire un ambiente di lavoro inclusivo, il nostro Network risulta conforme agli standard dei requisiti ISO 30415, sul Sistema di Gestione per la Diversità e l’Inclusione, e UNI PdR 125, relativa alla parità di genere. All’interno del nostro &lt;strong&gt;Impact Plan&lt;/strong&gt; - &lt;a title=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot; href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt; - trovi riassunte tutte le &lt;strong&gt;azioni concrete&lt;/strong&gt; che stiamo portando avanti su tematiche ambientali, sociali e di governance (&lt;strong&gt;ESG&lt;/strong&gt;). &lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Unisciti a noi!&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;I tuoi dati saranno trattati nel pieno rispetto delle disposizioni del Regolamento (UE) n. 679/2016 (General Data Protection Regulation - &quot;GDPR&quot;) e successive modifiche. Per ulteriori informazioni, consultare l&apos;informativa sulla privacy di KPMG.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;KPMG Advisory S.p.A. garantisce le pari opportunità.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;AI Transformation Consultant&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;We let the future guide us. Join our next generation.&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Do you want to pursue a profession that is truly meaningful and impactful? At KPMG, you will have the opportunity to help clients, society, and colleagues address and solve the most current and complex challenges.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;KPMG Advisory&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; provides consulting services to organizations, supporting them in transforming their business models, improving and digitizing processes, analyzing and managing risks, and navigating corporate finance and strategic transactions.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;As part of this role, you will join the &lt;strong&gt;Lighthouse Team&lt;/strong&gt; within the &lt;strong&gt;Intelligent Automation&lt;/strong&gt; service line, focused on delivering Digital Transformation projects.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Lighthouse Intelligent Automation&lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; is KPMG’s practice dedicated to designing and delivering software solutions that automate business processes through the combination of artificial intelligence, AI agents, low-code platforms, and custom development. We go beyond prototyping, supporting clients from process analysis through to production deployment, while ensuring security, compliance, and measurable business benefits.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Your Key Responsibilities&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;You will be involved in:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Gathering and documenting process requirements through interviews and workshops with business users&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Developing applications using &lt;strong&gt;Microsoft Power Apps&lt;/strong&gt; and automation workflows using &lt;strong&gt;Power Automate&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Configuring conversational agents in &lt;strong&gt;Microsoft Copilot Studio&lt;/strong&gt;, including topics, knowledge sources, and system integrations&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Designing data models in &lt;strong&gt;Dataverse&lt;/strong&gt; and integrating solutions with client data sources&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Performing functional testing, documenting solutions, and preparing end-user training materials&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Supporting deployment activities and the ongoing management of solutions already in production&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Contributing to the practice&apos;s reusable assets, including components, templates, and prompt libraries&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Come As You Are – Your Skills and Qualifications&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;This opportunity is perfect for you if you:&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Hold, or are currently pursuing, a degree in Engineering, Computer Science, Mathematics, Statistics, or a related field&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Have strong analytical skills and the ability to break down business processes into their fundamental components&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Demonstrate an understanding of the foundations of &lt;strong&gt;Generative AI&lt;/strong&gt;, including large language models (LLMs), prompting techniques, Retrieval-Augmented Generation (RAG) architectures, and awareness of the practical limitations of these tools&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Show genuine interest in automation platforms and a strong motivation to develop hands-on expertise&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Have gained initial experience with the &lt;strong&gt;Microsoft Power Platform&lt;/strong&gt;, whether through academic projects, internships, or personal initiatives, particularly &lt;strong&gt;Power Apps&lt;/strong&gt; and &lt;strong&gt;Power Automate&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Possess introductory knowledge of &lt;strong&gt;Microsoft Copilot Studio&lt;/strong&gt; and AI agent development&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Have experience with &lt;strong&gt;Claude Code&lt;/strong&gt; or other agent-based development tools&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Demonstrate knowledge of &lt;strong&gt;Google Gemini&lt;/strong&gt; or another Generative AI ecosystem beyond Microsoft technologies&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Have basic knowledge of &lt;strong&gt;SQL, Python, or JavaScript&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Nice to have: Microsoft certifications such as &lt;strong&gt;PL-900, PL-200, or AI-900&lt;/strong&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Have previous experience, even short-term or academic, in consulting environments or client-facing roles&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Are proficient in English, ideally supported by study or work experience abroad&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Are a strong communicator with excellent problem-solving skills, a results-oriented mindset, and a dynamic, proactive approach.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Your Future With Us – What You’ll Find at KPMG&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top:0.0cm;margin-bottom:0.0cm&quot; type=&quot;disc&quot;&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;An inclusive and equitable workplace that respects, encourages, and values diversity&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;A stimulating and dynamic environment that fosters creativity and teamwork&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Advanced learning and development programs to help you stay ahead of emerging trends&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;An international mindset and the opportunity to work on innovative projects&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot;margin-top:0.0cm;margin-right:0.0cm;margin-bottom:8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Initiatives dedicated to employee wellbeing and work-life balance&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Paid internship opportunity offering a monthly allowance of €800&lt;/span&gt;&lt;/em&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; for curricular internships and €1,000 for extracurricular internships &lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;strong&gt;&lt;em&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Together for Better – Our values and commitment&lt;/span&gt;&lt;/em&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Leadership, teamwork, respect every individual, continuous learning, transparency, commitment to the community and integrity. These are the KPMG values that create an environment that encourages the sharing of ideas and knowledge, so our professionals can achieve their full potential.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;As a result of our commitment to fostering an inclusive work environment, our Network complies with the standards of the ISO 30415 requirements, on the Diversity and Inclusion Management System, and UNI PdR 125, relating to gender equality.  Within our Impact Plan - &lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;&lt;a href=&quot;https://kpmg.com/xx/en/about/our-impact-plan.html&quot;&gt;Our Impact Plan (kpmg.com)&lt;/a&gt;&lt;/span&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt; - you will find summarised all the concrete actions we are taking on environmental, social and governance (ESG) issues.  &lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:10.0pt;line-height:115%&quot;&gt;Join us!&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt; &lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;Your data will be processed in full compliance with the provisions of Regulation (EU) no. 679/2016 (General Data Protection Regulation - “GDPR”), as amended. For more information, please see KPMG&apos;s privacy policy.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;em&gt;&lt;span style=&quot;font-size:8.0pt;line-height:115%&quot;&gt;KPMG Advisory S.p.A. is an equal opportunity employer.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;margin:0.0cm 0.0cm 8.0pt;line-height:115%;font-size:12.0pt;font-family:Aptos, sans-serif&quot;&gt;&lt;span style=&quot;font-size:8.0pt&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height:115%&quot;&gt; #LI-SD1 &lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;]]></description><link>https://careers.kpmg.it/job/Milano-AI-Trasformation-Junior-Consultant/1371447457/</link><guid isPermaLink="false">1371447457</guid><g:id>1371447457</g:id><g:expiration_date>2026-10-07</g:expiration_date><g:employer>KPMG Advisory Careers</g:employer><g:job_function>Management Consulting</g:job_function><g:location>Milano, IT</g:location></item></channel></rss>